{
  "name": "ula-social-comunication",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/build-router-map.mjs && tinacms dev -c \"astro dev\"",
    "dev:cms": "node scripts/build-router-map.mjs && tinacms dev",
    "dev:decap": "decap-server",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:cms\"",
    "build": "node scripts/build-router-map.mjs && tinacms build && astro build && node -e \"require('fs').writeFileSync('dist/.assetsignore', '_worker.js\\n_routes.json\\n')\"",
    "build:local": "node scripts/build-router-map.mjs && tinacms build --local --skip-cloud-checks && astro build && node -e \"require('fs').writeFileSync('dist/.assetsignore', '_worker.js\\n_routes.json\\n')\"",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.0.0",
    "@astrojs/mdx": "^4.3.14",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "decap-cms": "^3.12.2",
    "lenis": "^1.3.23",
    "phosphor-icons-astro": "2.1.1-17042025",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.3",
    "concurrently": "^9.2.1",
    "decap-server": "^3.7.0",
    "playwright": "^1.61.1",
    "wrangler": "^4.107.1",
    "yaml": "^2.9.0"
  }
}