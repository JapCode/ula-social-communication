{
  "name": "ula-social-comunication",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "decap-server",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:cms\"",
    "prebuild": "node -e \"require('fs').cpSync(require.resolve('decap-cms/dist/decap-cms.js'), 'public/admin/decap-cms.js', { dereference: true })\"",
    "build": "pnpm prebuild && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "decap-cms": "^3.12.2",
    "lenis": "^1.3.23",
    "phosphor-icons-astro": "2.1.1-17042025",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "decap-server": "^3.7.0"
  }
}