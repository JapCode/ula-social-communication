---
import { getCollection, render } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { PhArrowLeft, PhClock, PhUser, PhCalendar, PhNewspaper } from 'phosphor-icons-astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: article,
  }));
}

const article = Astro.props;
const { Content } = await render(article);

const categoryLabels: Record<string, string> = {
  investigacion: 'Investigación',
  actualidad: 'Actualidad',
  opinion: 'Opinión',
  cronica: 'Crónica',
};

const formattedDate = new Date(article.data.date).toLocaleDateString('es-VE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const pageTitle = article.data.title;
const pageSubtitle = `${article.data.author} · ${formattedDate}`;
---

<ContentLayout
  title={pageTitle}
  subtitle={pageSubtitle}
  eyebrow={categoryLabels[article.data.category] || article.data.category}
  breadcrumb={[{ label: 'Portafolio', href: '/portfolio' }, { label: 'Artículos', href: '/portfolio/articles' }]}
  narrow
>
  <!-- Article Meta -->
  <div class="article-meta mb-8 flex flex-wrap items-center gap-4 text-sm text-slate-400">
    <div class="flex items-center gap-2">
      <PhUser size={14} weight="regular" />
      <span>{article.data.author}</span>
    </div>
    <div class="flex items-center gap-2">
      <PhCalendar size={14} weight="regular" />
      <span>{formattedDate}</span>
    </div>
    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-primary/10 text-[10px] font-bold text-primary uppercase tracking-wider">
      {categoryLabels[article.data.category] || article.data.category}
    </span>
  </div>

  <!-- Cover Image -->
  {article.data.coverImage && (
    <div class="mb-6">
      <img src={article.data.coverImage} alt="" class="w-full rounded-[var(--radius-luma)]" />
    </div>
  )}

  <!-- Article Content -->
  <article class="article-content">
    <Content />
  </article>

  <!-- Back to articles -->
  <div class="mt-12 pt-8 border-t border-slate-100/50">
    <a href="/portfolio/articles" class="inline-flex items-center gap-2 text-primary text-sm font-semibold hover:underline group">
      <PhArrowLeft size={16} weight="regular" class="transition-transform duration-300 group-hover:-translate-x-1" />
      Volver a Artículos
    </a>
  </div>
</ContentLayout>

<style>
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .article-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .article-content p {
    color: var(--color-ink-muted);
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }

  .article-content ul,
  .article-content ol {
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .article-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .article-content a:hover {
    color: var(--color-primary-deep);
  }

  .article-content blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .article-content img {
    border-radius: var(--radius-luma);
    margin: 0;
    width: 100%;
  }

  .article-content hr {
    border: none;
    height: 1px;
    background: rgba(226, 232, 240, 0.5);
    margin: 2.5rem 0;
  }
</style>
