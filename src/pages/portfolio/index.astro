---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { PhNewspaper, PhVideo, PhBookBookmark, PhArrowRight } from 'phosphor-icons-astro';
import { getCollection, getEntry } from 'astro:content';

const articles = await getCollection('articles');
const pageEntry = await getEntry('pages', 'portfolio-index');
const { title, subtitle, items = [] } = pageEntry?.data ?? {};

const pageTitle = title ?? "Portafolio Estudiantil";
const pageSubtitle = subtitle ?? "Proyectos, trabajos y producciones de los estudiantes de Comunicación Social";

// Icons hardcoded by index for the 3 sections
const sectionIcons = [PhNewspaper, PhVideo, PhBookBookmark];
const sections = items.slice(0, 3).map((item, i) => ({
  icon: sectionIcons[i] || PhNewspaper,
  title: item.title ?? "",
  description: item.description ?? "",
  href: item.href ?? "#",
  count: i === 0 ? articles.length : undefined,
  countLabel: i === 0 ? (articles.length === 1 ? 'artículo publicado' : 'artículos publicados') : undefined,
}));
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Portafolio" sectionTheme="portfolio">

  <!-- Portfolio sections — editorial magazine-style listings -->
  <div class="portfolio-sections">
    {sections.map((section, i) => {
      const Icon = section.icon;
      const isFeatured = i === 0;
      return (
        <>
          {i > 0 && <div class="section-divider"></div>}
          <a href={section.href} class={`portfolio-section group flex flex-col md:flex-row md:items-center gap-5 md:gap-10 py-10 md:py-12 ${isFeatured ? 'md:flex-row-reverse' : ''}`}>
            <!-- Icon block — larger and bolder for featured, compact for rest -->
            <div class={`flex-shrink-0 flex items-center justify-center transition-all duration-300 group-hover:scale-105 ${isFeatured ? 'w-20 h-20 rounded-2xl bg-accent/10' : 'w-14 h-14 rounded-full bg-primary/10'}`}>
              <Icon size={isFeatured ? 32 : 22} weight={isFeatured ? "fill" : "duotone"} class={isFeatured ? "text-accent" : "text-primary"} />
            </div>
            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-1">
                <h2 class={`font-display font-bold text-ink tracking-tight leading-[1.1] group-hover:text-primary transition-colors ${isFeatured ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl'}`}>
                  {section.title}
                </h2>
                {isFeatured && (
                  <span class="badge-naranja flex-shrink-0">Destacado</span>
                )}
              </div>
              <p class="text-sm md:text-base text-ink-muted mt-1 leading-relaxed">{section.description}</p>
              {section.count !== undefined && (
                <span class="inline-flex items-center gap-1.5 text-xs text-ink-faint mt-2">
                  <span class="w-1 h-1 rounded-full bg-green"></span>
                  {section.count} {section.countLabel}
                </span>
              )}
            </div>
            <!-- CTA chevron — visible on hover -->
            <div class="flex items-center gap-2 text-primary text-sm font-bold opacity-0 group-hover:opacity-100 transition-all duration-300 md:self-center">
              <span>Explorar</span>
              <PhArrowRight size={16} weight="bold" class="transition-transform duration-300 group-hover:translate-x-1" />
            </div>
          </a>
        </>
      );
    })}
  </div>

</ContentLayout>

<style>
  /* Sections container */
  .portfolio-sections {
    display: flex;
    flex-direction: column;
  }

  .section-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
  }

  .portfolio-section {
    text-decoration: none;
    transition: background 0.3s ease;
    border-radius: 0.75rem;
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .portfolio-section:hover {
    background: rgba(248, 151, 40, 0.03);
  }

  /* Count badge inline */
  .count-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-faint);
    margin-top: 0.375rem;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .portfolio-section {
      padding: 1.5rem 0;
    }
  }
</style>
