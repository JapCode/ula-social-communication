---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { PhVideo, PhMicrophone, PhCamera, PhPaintBrush, PhClock, PhMapPin, PhMonitor } from 'phosphor-icons-astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'portfolio-media-lab');
const { title, subtitle, items = [] } = pageEntry?.data ?? {};
const body = pageEntry?.data?.body ?? pageEntry?.body ?? "";

const pageTitle = title ?? "Laboratorio de Medios";
const pageSubtitle = subtitle ?? "Producción audiovisual, radio y contenido multimedia de los estudiantes";

// items[0-3] = disciplines (title, description)
const discIcons = [PhVideo, PhMicrophone, PhCamera, PhPaintBrush];
const disciplines = items.slice(0, 4).map((item, i) => ({
  icon: discIcons[i] || PhVideo,
  title: item.title ?? "",
  description: item.description ?? "",
}));

// items[4-7] = equipment (title=label)
const equipIcons = [PhVideo, PhCamera, PhMicrophone, PhMonitor];
const equipment = items.slice(4, 8).map((item, i) => ({
  icon: equipIcons[i] || PhMonitor,
  label: item.title ?? "",
}));

const eyebrow = "Portafolio";
const breadcrumb = [{ label: "Portafolio", href: "/portfolio" }];
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} breadcrumb={breadcrumb} eyebrow={eyebrow} sectionTheme="portfolio">

  <!-- Intro -->
  <div class="media-lab-intro mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-5">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Espacio de creación</span>
    </div>
    <p class="text-slate-500 leading-relaxed max-w-2xl">
      {body || "El Laboratorio de Medios es un espacio de creación y producción donde los estudiantes de Comunicación Social desarrollan sus habilidades en la elaboración de contenido audiovisual, radio, fotografía y diseño digital. Equipado con tecnología de vanguardia para apoyar las actividades académicas y extracurriculares."}
    </p>
  </div>

  <!-- Disciplines -- alternating editorial rows -->
  <div class="disciplines mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-8">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Áreas de producción</span>
    </div>

    {disciplines.map((disc, i) => (
      <div class="discipline-row group flex flex-col md:flex-row gap-6 md:gap-10 py-8 md:py-10">
        {i % 2 === 0 ? (
          <>
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <disc.icon size={28} weight="duotone" class="text-primary" />
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-display font-bold text-slate-900 tracking-tight mb-2">{disc.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{disc.description}</p>
            </div>
          </>
        ) : (
          <>
            <div class="flex-1 md:order-1 md:text-right">
              <h3 class="text-lg font-display font-bold text-slate-900 tracking-tight mb-2">{disc.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{disc.description}</p>
            </div>
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 md:order-2">
              <disc.icon size={28} weight="duotone" class="text-primary" />
            </div>
          </>
        )}
      </div>
    ))}
  </div>

  <!-- Equipment Strip -->
  <div class="equipment-strip mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Equipos disponibles</span>
    </div>
    <div class="equipment-grid">
      {equipment.map(item => (
        <div class="equipment-item">
          <item.icon size={28} weight="duotone" class="text-primary/60" />
          <p class="text-sm font-medium text-slate-700 mt-3">{item.label}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Schedule -->
  <div class="schedule-panel">
    <div class="flex items-center gap-3 mb-6">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Horario y ubicación</span>
    </div>
    <div class="bg-surface-elevated border border-tinted p-6 md:p-8">
      <p class="text-slate-500 mb-5">
        El Laboratorio de Medios está disponible para todos los estudiantes de Comunicación Social.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-8">
        <div class="flex items-center gap-3 text-slate-600">
          <PhClock size={18} weight="regular" class="text-primary/60 flex-shrink-0" />
          <span class="text-sm">Lunes a Viernes: 8:00 AM – 6:00 PM</span>
        </div>
        <div class="flex items-center gap-3 text-slate-600">
          <PhMapPin size={18} weight="regular" class="text-primary/60 flex-shrink-0" />
          <span class="text-sm">Escuela de Comunicación Social, Planta Baja</span>
        </div>
      </div>
    </div>
  </div>

</ContentLayout>

<style>
  .discipline-row {
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .discipline-row:last-child {
    border-bottom: none;
  }

  .equipment-strip {
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    background: var(--color-surface-elevated);
    padding: 1.5rem;
  }

  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .equipment-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .equipment-item {
    text-align: center;
    padding: 1.25rem 0.75rem;
    border-radius: calc(var(--radius-luma) * 0.6);
    transition: background 0.2s ease;
  }

  .equipment-item:hover {
    background: rgba(0, 93, 170, 0.03);
  }
</style>
