---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { PhBookBookmark, PhCaretRight, PhDownloadSimple, PhNewspaper, PhGraduationCap, PhFilmStrip, PhUsersThree } from 'phosphor-icons-astro';

const pageTitle = "Revista de la Carrera";
const pageSubtitle = "Publicación oficial de la Escuela de Comunicación Social";

const editions = [
  { year: '2025', label: 'Edición 2025' },
  { year: '2024', label: 'Edición 2024' },
  { year: '2023', label: 'Edición 2023' },
];

const magazineSections = [
  {
    icon: PhNewspaper,
    title: 'Periodismo',
    description: 'Reportajes, notas y crónicas periodísticas',
  },
  {
    icon: PhGraduationCap,
    title: 'Académico',
    description: 'Ensayos y artículos de investigación',
  },
  {
    icon: PhFilmStrip,
    title: 'Producción',
    description: 'Proyectos audiovisuales y multimedia',
  },
];

const editorialCommittee = [
  { role: 'Director Editorial', name: 'Director de la Escuela' },
  { role: 'Editor Ejecutivo', name: 'Coordinador de la Carrera' },
  { role: 'Colaboradores', name: 'Docentes del área de Investigación' },
];
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Portafolio">

  <!-- About -->
  <div class="magazine-about mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-5">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Sobre la revista</span>
    </div>
    <p class="text-slate-500 leading-relaxed max-w-2xl">
      La Revista de la Escuela de Comunicación Social es una publicación oficial que reúne artículos, 
      ensayos, reportajes y producciones realizadas por estudiantes, docentes y egresados de la carrera. 
      Este espacio busca promover la producción académica y periodística, además de servir como vitrina 
      para el talento de nuestra comunidad.
    </p>
  </div>

  <!-- Editions + Contribution — 2-column editorial row -->
  <div class="mb-12 md:mb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <!-- Editions -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="block w-6 h-px bg-primary/40"></span>
          <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Ediciones anteriores</span>
        </div>
        <div class="bg-surface-elevated border border-slate-100/50 overflow-hidden">
          {editions.map((edition, i) => (
            <>
              {i > 0 && <div class="edition-divider"></div>}
              <a href="#" class="edition-item group flex items-center justify-between px-5 py-4 transition-colors duration-200 hover:bg-primary/5">
                <div class="flex items-center gap-3">
                  <PhBookBookmark size={18} weight="regular" class="text-primary/60" />
                  <span class="text-sm font-medium text-slate-700 group-hover:text-primary transition-colors">{edition.label}</span>
                </div>
                <PhCaretRight size={14} weight="regular" class="text-slate-300 group-hover:text-primary transition-colors" />
              </a>
            </>
          ))}
        </div>
      </div>

      <!-- Contribution -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="block w-6 h-px bg-primary/40"></span>
          <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Contribuye</span>
        </div>
        <div class="bg-surface-elevated border border-slate-100/50 p-6 md:p-8 h-full flex flex-col justify-center">
          <h3 class="text-lg font-display font-bold text-slate-900 tracking-tight mb-3">
            Envía tu contribución
          </h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">
            ¿Tienes un artículo, ensayo o trabajo que quieres publicar? Consulta las guías de estilo y 
            requisitos para enviar tu contribución a la próxima edición.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 text-primary text-sm font-semibold hover:underline">
            <PhDownloadSimple size={16} weight="regular" />
            Descargar Guía de Estilo
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Magazine Sections Strip -->
  <div class="magazine-sections-strip mb-12 md:mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Secciones</span>
    </div>
    <div class="magazine-sections-grid">
      {magazineSections.map(section => (
        <div class="magazine-section-item">
          <section.icon size={32} weight="duotone" class="text-primary/60" />
          <h3 class="font-display font-semibold text-slate-900 mt-4">{section.title}</h3>
          <p class="text-xs text-slate-500 mt-1">{section.description}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Editorial Committee -->
  <div class="editorial-committee">
    <div class="flex items-center gap-3 mb-6">
      <span class="block w-6 h-px bg-primary/40"></span>
      <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400">Comité editorial</span>
    </div>
    <div class="bg-surface-elevated border border-slate-100/50 p-6 md:p-8">
      <p class="text-sm text-slate-500 mb-5">
        El comité editorial está conformado por docentes de la Escuela de Comunicación Social y representantes estudiantiles.
      </p>
      <div class="space-y-3">
        {editorialCommittee.map(member => (
          <div class="flex items-center gap-3 text-slate-600">
            <PhUsersThree size={16} weight="regular" class="text-primary/60 flex-shrink-0" />
            <span class="text-sm font-medium text-slate-700">{member.role}</span>
            <span class="text-slate-300">—</span>
            <span class="text-sm text-slate-500">{member.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

</ContentLayout>

<style>
  .edition-divider {
    height: 1px;
    background: rgba(226, 232, 240, 0.5);
  }

  .edition-item {
    display: block;
  }

  .magazine-sections-strip {
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    background: var(--color-surface-elevated);
    padding: 1.5rem;
  }

  .magazine-sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .magazine-sections-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .magazine-section-item {
    text-align: center;
    padding: 1.5rem 1rem;
    border-radius: calc(var(--radius-luma) * 0.6);
    transition: background 0.2s ease;
  }

  .magazine-section-item:hover {
    background: rgba(0, 93, 170, 0.03);
  }
</style>
