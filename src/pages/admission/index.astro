---
import ContentLayout from '@/layouts/ContentLayout.astro';
import SectionCard from '@/components/SectionCard.astro';

const pageTitle = "Admisión";
const pageSubtitle = "Información sobre ingresos, procesos y requisitos para estudiar Comunicación Social";
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Admisión">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <SectionCard title="Proceso de Admisión" description="Pasos y fechas para tu inscripción" icon="user-plus" href="/admission/process" />
    <SectionCard title="Requisitos" description="Documentación necesaria para ingreso" icon="assignment" href="/admission/requirements" />
  </div>

  <div class="mt-12 bg-white border border-slate-100/50 rounded-luma p-6 md:p-8">
    <h2 class="text-xl font-bold text-slate-900 mb-4">¿Por qué estudiar Comunicación Social en la ULA?</h2>
    <p class="text-slate-500 mb-6">
      La Escuela de Comunicación Social del Núcleo Universitario Rafael Rangel (NURR) de la Universidad 
      de los Andes ofrece una formación integral en las áreas de periodismo, producción audiovisual, 
      comunicación organizacional y relaciones públicas.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <span class="ph-light text-primary">school</span>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Excelencia Académica</h3>
          <p class="text-sm text-slate-500">Programa avalado por décadas de tradición universitaria</p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <span class="ph-light text-primary">groups</span>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Comunidad Activa</h3>
          <p class="text-sm text-slate-500">Vida estudiantil丰富的社团和组织</p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <span class="ph-light text-primary">work</span>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Práctica Profesional</h3>
          <p class="text-sm text-slate-500">Convenios con medios y organizaciones</p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <span class="ph-light text-primary">buildings</span>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Ubicación Estratégica</h3>
          <p class="text-sm text-slate-500">En el corazón de los Andes venezolanos</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 bg-primary/5 border border-primary/20 rounded-luma p-6 md:p-8">
    <div class="flex items-start gap-4">
      <span class="ph-light text-primary text-2xl">info</span>
      <div>
        <h3 class="font-semibold text-slate-900">Información importante</h3>
        <p class="text-sm text-slate-500 mt-1">
          Las inscripciones se realizan a través del portal de la Universidad de los Andes. 
          Consulta las fechas importantes y no pierdas la oportunidad de formar parte de nuestra comunidad.
        </p>
      </div>
    </div>
  </div>
</ContentLayout>
