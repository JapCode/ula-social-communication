---
import { requestWithMetadata } from "@tinacms/astro/data";
import { client } from "../../tina/__generated__/client";
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import HeroSection from "../components/HeroSection.astro";
import NewsSection from "../components/NewsSection.astro";
import VideoSection from "../components/VideoSection.astro";
import QuickAccessSection from "../components/QuickAccessSection.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import SearchModal from "../components/SearchModal.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import "../styles/global.css";

const enriched = await requestWithMetadata(
  client.queries.pageHome({ relativePath: 'home.md' }),
  { priority: 'primary' }
);
const page = enriched.data.pageHome;
if (!page) {
  throw new Error(
    '[index.astro] Tina query for "pages/home" returned no data.'
  );
}
const { hero, quickAccess, news, video, footer } = page;
---

<Layout title="Comunicación Social ULA NURR | Discovery">
	<TopNav />
	<TinaIsland name="pageHome" wrapper={{ tag: 'main' }} params={{}} primary>
		<main id="main-content" class="relative" role="main">
			<HeroSection hero={hero} />
			<QuickAccessSection quickAccess={quickAccess} />
			<NewsSection news={news} />
			<VideoSection video={video} />
		</main>
	</TinaIsland>
	<Footer footer={footer} />
	<WhatsAppButton />
	<BackToTop />
	<SearchModal />
</Layout>

<!-- GSAP/Lenis animations removed — CSS-native hover/scroll effects used instead. Saved ~55KB gzipped. -->

<style is:global>
	#inicio,
	#noticias,
	#video,
	#accesos {
		scroll-margin-top: 5rem;
	}

	@media (min-width: 768px) {
		#inicio,
		#noticias,
		#video,
		#accesos {
			scroll-margin-top: 6rem;
		}
	}
</style>
