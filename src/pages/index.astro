---
import Layout from '../layouts/Layout.astro';
import FloatingNav from '../components/FloatingNav.astro';
import TopNav from '../components/TopNav.astro';
import HeroSection from '../components/HeroSection.astro';
import NewsSection from '../components/NewsSection.astro';
import VideoSection from '../components/VideoSection.astro';
import QuickAccessSection from '../components/QuickAccessSection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';
---

<Layout title="Comunicación Social ULA NURR | Discovery">
	<FloatingNav />
	<TopNav />
	<main id="main-content" class="relative" role="main">
		<HeroSection />
		<NewsSection />
		<VideoSection />
		<QuickAccessSection />
	</main>
	<Footer />
	<WhatsAppButton />
	<SearchModal />
</Layout>

<style is:global>
	#inicio,
	#noticias,
	#video,
	#accesos {
		scroll-margin-top: 5rem;
	}
	
	@media (min-width: 768px) {
		#inicio,
		#noticias,
		#video,
		#accesos {
			scroll-margin-top: 6rem;
		}
	}
</style>
