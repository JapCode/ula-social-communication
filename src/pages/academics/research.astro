---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhBookOpen,
  PhNewspaper,
  PhUsers,
  PhVideo,
  PhMegaphone,
  PhBrain,
  PhGraduationCap,
  PhEnvelope,
  PhPhone,
  PhMapPin,
} from 'phosphor-icons-astro';
import { getEntry } from 'astro:content';

const DEFAULT_INTRO = "La investigación es el motor de la innovación comunicacional. Nuestras líneas de investigación exploran los desafíos contemporáneos de la comunicación desde una perspectiva crítica, creativa y comprometida con la realidad regional.";

const pageEntry = await getEntry('pages', 'academics-research');
const { title, body, items = [], thesis, contact } = pageEntry?.data ?? {};

const pageTitle = title ?? "Líneas de Investigación";
const introText = body ?? DEFAULT_INTRO;

// Icons cycle through the list for each research line
const lineaIcons = [PhBookOpen, PhNewspaper, PhUsers, PhVideo, PhMegaphone, PhBrain];
const lineas = items.map((item, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: item.title ?? "",
  description: item.description ?? "",
  icon: lineaIcons[i % lineaIcons.length] || PhBookOpen,
}));

const thesisTitle = thesis?.title ?? "Trabajos de Grado";
const thesisText = thesis?.text ?? "Los estudiantes pueden desarrollar sus trabajos de grado en cualquiera de las líneas de investigación establecidas. Cada línea cuenta con docentes asesores especializados.";
const thesisNote = thesis?.note ?? "Consulta las líneas disponibles y asigna tu asesor antes de inscribir tu tema de tesis.";

const contactInfo = {
  coordinador: contact?.name ?? "Dr. Carlos Mendoza",
  cargo: contact?.role ?? "Coordinador de Investigación",
  email: contact?.email ?? "investigacion.comunicacion@ula.ve",
  telefono: contact?.phone ?? "+58 274 000-0000",
  oficina: contact?.office ?? "Edificio Principal, Oficina 8",
};

const breadcrumb = [{ label: "Académico", href: "/academics" }];
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb} sectionTheme="academic">
  <section class="research-page">

    <!-- Opening -->
    <div class="rp-opening">
      <div class="rp-opening__accent" aria-hidden="true">
        <span class="rp-opening__line"></span>
      </div>
      <p class="rp-opening__text">
        {introText}
      </p>
    </div>

    <!-- Research lines — editorial numbered list -->
    <div class="rp-lines">
      <div class="rp-section-header">
        <span class="rp-section-header__line"></span>
        <span class="rp-section-header__eyebrow">Exploración</span>
      </div>
      <h2 class="rp-section-title">Líneas de Investigación</h2>
      <p class="rp-section-intro">
        Cada línea agrupa proyectos, publicaciones y trabajos de grado orientados a comprender y transformar la comunicación en sus múltiples dimensiones.
      </p>

      <div class="rp-lines__list">
        {lineas.map((linea, i) => (
          <div class:list={["rp-line", i === 0 ? "rp-line--featured" : ""]}>
            <div class="rp-line__number">{linea.number}</div>
            <div class="rp-line__content">
              <div class="rp-line__header">
                <linea.icon size={i === 0 ? 22 : 18} weight={i === 0 ? "duotone" : "light"} class="rp-line__icon" />
                <h3 class="rp-line__title">{linea.title}</h3>
              </div>
              <p class="rp-line__desc">{linea.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Thesis + Contact -->
    <div class="rp-bottom">
      <div class="rp-thesis">
        <PhGraduationCap size={24} weight="duotone" class="rp-thesis__icon" />
        <h3 class="rp-thesis__title">{thesisTitle}</h3>
        <p class="rp-thesis__text">
          {thesisText}
        </p>
        <p class="rp-thesis__note">
          {thesisNote}
        </p>
      </div>

      <div class="rp-contact">
        <h3 class="rp-contact__title">Coordinación de Investigación</h3>
        <p class="rp-contact__person">{contactInfo.coordinador}</p>
        <p class="rp-contact__role">{contactInfo.cargo}</p>
        <div class="rp-contact__details">
          <a href={`mailto:${contactInfo.email}`} class="rp-contact__link">
            <PhEnvelope size={14} weight="light" />
            {contactInfo.email}
          </a>
          <span class="rp-contact__detail">
            <PhPhone size={14} weight="light" />
            {contactInfo.telefono}
          </span>
          <span class="rp-contact__detail">
            <PhMapPin size={14} weight="light" />
            {contactInfo.oficina}
          </span>
        </div>
      </div>
    </div>

  </section>
</ContentLayout>

<style>
  /* ============================================================
     Research — Editorial Layout
     ============================================================ */

  .research-page {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .research-page {
      gap: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .research-page {
      gap: 6rem;
    }
  }

  /* --- Opening --- */
  .rp-opening {
    position: relative;
    padding-left: 1.5rem;
  }

  .rp-opening__accent {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.15));
    border-radius: 2px;
  }

  .rp-opening__text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    font-weight: 400;
    max-width: 48rem;
    margin: 0;
  }

  /* --- Section headers --- */
  .rp-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rp-section-header__line {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.4;
  }

  .rp-section-header__eyebrow {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .rp-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .rp-section-intro {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin: 0 0 2.5rem;
    max-width: 40rem;
  }

  /* --- Research lines --- */
  .rp-lines__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .rp-line {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
    transition: background 0.25s ease;
  }

  .rp-line:first-child {
    padding-top: 0;
  }

  .rp-line:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .rp-line--featured {
    padding: 1.75rem 0;
  }

  .rp-line--featured .rp-line__title {
    font-size: 1.125rem;
  }

  .rp-line__number {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.5;
    line-height: 1.5;
    padding-top: 0.125rem;
  }

  .rp-line__content {
    min-width: 0;
  }

  .rp-line__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
  }

  .rp-line__icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .rp-line__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .rp-line__desc {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 36rem;
  }

  /* --- Bottom: Thesis + Contact --- */
  .rp-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .rp-bottom {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  /* Thesis */
  .rp-thesis {
    position: relative;
    background: var(--color-primary);
    border-radius: var(--radius-luma);
    padding: 2rem 1.75rem;
    overflow: hidden;
  }

  .rp-thesis::before {
    content: '';
    position: absolute;
    right: -2rem;
    top: -2rem;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .rp-thesis__icon {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
  }

  .rp-thesis__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .rp-thesis__text {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  .rp-thesis__note {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  /* Contact */
  .rp-contact {
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    padding: 2rem 1.75rem;
  }

  .rp-contact__title {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin: 0 0 0.75rem;
  }

  .rp-contact__person {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.125rem;
  }

  .rp-contact__role {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    margin: 0 0 1rem;
  }

  .rp-contact__details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rp-contact__link,
  .rp-contact__detail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .rp-contact__link:hover {
    color: var(--color-primary);
  }

  .rp-contact__link svg,
  .rp-contact__detail svg {
    flex-shrink: 0;
    color: var(--color-primary);
    opacity: 0.6;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .rp-thesis,
    .rp-contact {
      padding: 1.5rem 1.25rem;
    }

    .rp-line {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
      padding: 1.25rem 0;
    }
  }
</style>
