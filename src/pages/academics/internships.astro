---
import { getEntry } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhCheckCircle,
  PhBriefcase,
  PhHeart,
  PhGraduationCap,
  PhBuildings,
  PhHandsClapping,
  PhUsersThree,
  PhGlobe,
  PhLeaf,
  PhStar,
  PhRocket,
  PhLightbulb,
  PhBookOpen,
  PhDownloadSimple,
  PhEnvelope,
  PhPhone,
  PhMapPin,
} from 'phosphor-icons-astro';

const iconMap: Record<string, any> = {
  Briefcase: PhBriefcase,
  Heart: PhHeart,
  GraduationCap: PhGraduationCap,
  Buildings: PhBuildings,
  HandsClapping: PhHandsClapping,
  UsersThree: PhUsersThree,
  Globe: PhGlobe,
  Leaf: PhLeaf,
  Star: PhStar,
  Rocket: PhRocket,
  Lightbulb: PhLightbulb,
  BookOpen: PhBookOpen,
};

const pageEntry = await getEntry('pages', 'academics-internships');

if (!pageEntry) {
  throw new Error('Internships page entry not found');
}

const { title, body, requirements, modalities, formUrl, contact } = pageEntry.data;

const breadcrumb = [{ label: "Académico", href: "/academics" }];
---

<ContentLayout title={title} breadcrumb={breadcrumb} sectionTheme="academic">
  <section class="internships-page">

    <!-- Opening -->
    {body && (
      <div class="ip-opening">
        <div class="ip-opening__accent" aria-hidden="true">
          <span class="ip-opening__line"></span>
        </div>
        <p class="ip-opening__text">{body}</p>
      </div>
    )}

    <!-- Requirements — clean checklist -->
    {requirements && requirements.length > 0 && (
      <div class="ip-requirements">
        <div class="ip-section-header">
          <span class="ip-section-header__line"></span>
          <span class="ip-section-header__eyebrow">Práctica</span>
        </div>
        <h2 class="ip-section-title">Requisitos</h2>

        <div class="ip-requirements__list">
          {requirements.map((req: string) => (
            <div class="ip-requirement">
              <PhCheckCircle size={18} weight="duotone" class="ip-requirement__icon" />
              <span class="ip-requirement__text">{req}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Modalities — horizontal cards -->
    {modalities && modalities.length > 0 && (
      <div class="ip-modalities">
        <div class="ip-section-header">
          <span class="ip-section-header__line"></span>
          <span class="ip-section-header__eyebrow">Opciones</span>
        </div>
        <h2 class="ip-section-title">Modalidades</h2>

        <div class="ip-modalities__grid">
          {modalities.map((mod: { title: string; description?: string; icon?: string }) => {
            const Icon = iconMap[mod.icon ?? 'Briefcase'] ?? PhBriefcase;
            return (
              <div class="ip-modality">
                <Icon size={22} weight="duotone" class="ip-modality__icon" />
                <h3 class="ip-modality__title">{mod.title}</h3>
                {mod.description && <p class="ip-modality__desc">{mod.description}</p>}
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- CTA + Contact -->
    {(formUrl || contact) && (
      <div class="ip-bottom">
        {formUrl && (
          <div class="ip-cta">
            <h3 class="ip-cta__title">¿Cumples los requisitos?</h3>
            <p class="ip-cta__text">Descarga el formato de solicitud para iniciar tu proceso de pasantía.</p>
            <a href={formUrl} class="ip-cta__button" download>
              <PhDownloadSimple size={16} weight="regular" class="ip-cta__icon" />
              Descargar Formato de Solicitud
            </a>
          </div>
        )}

        {contact && (
          <div class="ip-contact">
            <h3 class="ip-contact__title">¿Necesitas orientación?</h3>
            <p class="ip-contact__person">{contact.name}</p>
            {contact.role && <p class="ip-contact__role">{contact.role}</p>}
            <div class="ip-contact__details">
              {contact.email && (
                <a href={`mailto:${contact.email}`} class="ip-contact__link">
                  <PhEnvelope size={14} weight="light" />
                  {contact.email}
                </a>
              )}
              {contact.phone && (
                <span class="ip-contact__detail">
                  <PhPhone size={14} weight="light" />
                  {contact.phone}
                </span>
              )}
              {contact.office && (
                <span class="ip-contact__detail">
                  <PhMapPin size={14} weight="light" />
                  {contact.office}
                </span>
              )}
            </div>
          </div>
        )}
      </div>
    )}

  </section>
</ContentLayout>

<style>
  /* ============================================================
     Internships — Editorial Layout
     ============================================================ */

  .internships-page {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .internships-page {
      gap: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .internships-page {
      gap: 6rem;
    }
  }

  /* --- Opening --- */
  .ip-opening {
    position: relative;
    padding-left: 1.5rem;
  }

  .ip-opening__accent {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.15));
    border-radius: 2px;
  }

  .ip-opening__text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    font-weight: 400;
    max-width: 48rem;
    margin: 0;
  }

  /* --- Section headers --- */
  .ip-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ip-section-header__line {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.4;
  }

  .ip-section-header__eyebrow {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .ip-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  /* --- Requirements --- */
  .ip-requirements__list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ip-requirement {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .ip-requirement__icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .ip-requirement__text {
    font-size: 0.9375rem;
    color: var(--color-ink);
    line-height: 1.6;
  }

  /* --- Modalities --- */
  .ip-modalities__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .ip-modalities__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .ip-modality {
    padding: 1.5rem;
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .ip-modality:hover {
    border-color: rgba(0, 93, 170, 0.15);
    box-shadow: var(--shadow-luma);
  }

  .ip-modality__icon {
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .ip-modality__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.375rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .ip-modality__desc {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* --- Bottom: CTA + Contact --- */
  .ip-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .ip-bottom {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  /* CTA */
  .ip-cta {
    position: relative;
    background: var(--color-primary);
    border-radius: var(--radius-luma);
    padding: 2rem 1.75rem;
    overflow: hidden;
  }

  .ip-cta::before {
    content: '';
    position: absolute;
    right: -2rem;
    top: -2rem;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .ip-cta__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.375rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .ip-cta__text {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  .ip-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: #ffffff;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .ip-cta__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ip-cta__button:active {
    transform: translateY(0);
  }

  .ip-cta__icon {
    transition: transform 0.3s ease;
  }

  .ip-cta__button:hover .ip-cta__icon {
    transform: translateY(2px);
  }

  /* Contact */
  .ip-contact {
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    padding: 2rem 1.75rem;
  }

  .ip-contact__title {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin: 0 0 0.75rem;
  }

  .ip-contact__person {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.125rem;
  }

  .ip-contact__role {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    margin: 0 0 1rem;
  }

  .ip-contact__details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ip-contact__link,
  .ip-contact__detail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ip-contact__link:hover {
    color: var(--color-primary);
  }

  .ip-contact__link svg,
  .ip-contact__detail svg {
    flex-shrink: 0;
    color: var(--color-primary);
    opacity: 0.6;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .ip-cta,
    .ip-contact {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
