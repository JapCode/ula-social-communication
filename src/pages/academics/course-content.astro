---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhDownloadSimple,
  PhFileText,
} from 'phosphor-icons-astro';
import { getCollection } from 'astro:content';

const pageTitle = "Contenido de Cursos";
const breadcrumb = [{ label: "Académico", href: "/academics" }];

const allCourses = await getCollection('courses');
const sortedCourses = allCourses.sort((a, b) => a.data.semester - b.data.semester);

// Group by semester
const semesters = sortedCourses.reduce<Record<number, typeof sortedCourses>>((acc, course) => {
  const sem = course.data.semester;
  if (!acc[sem]) acc[sem] = [];
  acc[sem].push(course);
  return acc;
}, {});

const semesterKeys = Object.keys(semesters).map(Number).sort((a, b) => a - b);
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb}>
  <section class="courses-page">

    <!-- Opening -->
    <div class="cp-opening">
      <div class="cp-opening__accent" aria-hidden="true">
        <span class="cp-opening__line"></span>
      </div>
      <p class="cp-opening__text">
        Material de estudio, programas y recursos de cada materia del pénsum — organizados por semestre para que encuentres lo que necesitas rápidamente.
      </p>
    </div>

    <!-- Semester groups -->
    {semesterKeys.map((semNum) => (
      <div class="cp-semester" id={`semestre-${semNum}`}>
        <div class="cp-semester__header">
          <span class="cp-semester__number">{String(semNum).padStart(2, '0')}</span>
          <div>
            <h2 class="cp-semester__title">Semestre {semNum}</h2>
            <span class="cp-semester__count">{semesters[semNum].length} {semesters[semNum].length === 1 ? 'materia' : 'materias'}</span>
          </div>
        </div>

        <div class="cp-semester__courses">
          {semesters[semNum].map(course => (
            <div class="cp-course">
              <div class="cp-course__main">
                <div class="cp-course__top">
                  <span class="cp-course__code">{course.data.code}</span>
                  <span class="cp-course__credits">{course.data.credits} {course.data.credits === 1 ? 'crédito' : 'créditos'}</span>
                </div>
                <h3 class="cp-course__name">{course.data.name}</h3>
                <p class="cp-course__desc">{course.data.description}</p>
              </div>
              {course.data.pdfUrl ? (
                <a href={course.data.pdfUrl} class="cp-course__download" aria-label={`Descargar programa de ${course.data.name}`}>
                  <PhDownloadSimple size={16} weight="regular" />
                  <span>Programa</span>
                </a>
              ) : (
                <div class="cp-course__no-pdf">
                  <PhFileText size={16} weight="light" />
                  <span>Sin programa disponible</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

  </section>
</ContentLayout>

<style>
  /* ============================================================
     Course Content — Editorial Layout
     ============================================================ */

  .courses-page {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  @media (min-width: 768px) {
    .courses-page {
      gap: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .courses-page {
      gap: 4.5rem;
    }
  }

  /* --- Opening --- */
  .cp-opening {
    position: relative;
    padding-left: 1.5rem;
  }

  .cp-opening__accent {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.15));
    border-radius: 2px;
  }

  .cp-opening__text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    font-weight: 400;
    max-width: 48rem;
    margin: 0;
  }

  /* --- Semester --- */
  .cp-semester__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .cp-semester__number {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.25;
    line-height: 1;
    min-width: 2.5rem;
  }

  .cp-semester__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .cp-semester__count {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .cp-semester__courses {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* --- Course --- */
  .cp-course {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .cp-course:hover {
    border-color: rgba(0, 93, 170, 0.15);
    box-shadow: var(--shadow-luma);
  }

  .cp-course__main {
    flex: 1;
    min-width: 0;
  }

  .cp-course__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }

  .cp-course__code {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background: rgba(0, 93, 170, 0.08);
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
  }

  .cp-course__credits {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .cp-course__name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .cp-course__desc {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  .cp-course__download {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 0.875rem;
    background: rgba(0, 93, 170, 0.06);
    border: 1px solid rgba(0, 93, 170, 0.12);
    border-radius: 0.75rem;
    color: var(--color-primary);
    font-size: 0.6875rem;
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .cp-course__download:hover {
    background: rgba(0, 93, 170, 0.1);
    border-color: rgba(0, 93, 170, 0.2);
    transform: translateY(-1px);
  }

  .cp-course__download:active {
    transform: translateY(0);
  }

  .cp-course__download svg {
    color: var(--color-primary);
  }

  .cp-course__no-pdf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 0.875rem;
    color: var(--color-ink-faint);
    font-size: 0.6875rem;
    font-weight: 500;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .cp-course__no-pdf svg {
    color: var(--color-ink-faint);
  }

  /* --- Responsive --- */
  @media (max-width: 640px) {
    .cp-course {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }

    .cp-course__download,
    .cp-course__no-pdf {
      flex-direction: row;
      align-self: flex-start;
    }
  }
</style>
