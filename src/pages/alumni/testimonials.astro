---
import ContentLayout from '@/layouts/ContentLayout.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import { PhQuotes, PhEnvelopeSimple, PhArrowRight } from 'phosphor-icons-astro';
import { getCollection, getEntry } from 'astro:content';

const testimonials = await getCollection('testimonials');

const pageEntry = await getEntry('pages', 'alumni-testimonials');
const { title, subtitle, body: introBody } = pageEntry?.data ?? {};

const pageTitle = title ?? "Testimonios de Egresados";
const pageSubtitle = subtitle ?? "Voces de quienes transformaron su formación en impacto real";
const introText = introBody ?? "La Escuela de Comunicación Social del NURR ha formado profesionales que hoy ejercen con rigor y compromiso en medios, instituciones y organizaciones. Estas son sus historias.";
---

<ContentLayout 
  title={pageTitle} 
  subtitle={pageSubtitle} 
  eyebrow="Egresados"
  breadcrumb={[
    { label: "Egresados", href: "/alumni" }
  ]}
  sectionTheme="admission"
>
  <!-- Intro — inline, not boxed -->
  <div class="testimonial-intro">
    <p>{introText}</p>
  </div>

  {testimonials.length > 0 ? (
    <>
      <!-- Featured testimonial — first one, prominent -->
      <div class="featured-testimonial-wrapper">
        <TestimonialCard 
          quote={testimonials[0].data.quote}
          author={testimonials[0].data.name}
          role={testimonials[0].data.currentRole}
          year={testimonials[0].data.graduationYear}
          image={testimonials[0].data.photo}
          featured={true}
        />
      </div>

      <!-- Remaining testimonials — staggered grid -->
      {testimonials.length > 1 && (
        <div class="testimonials-grid">
          {testimonials.slice(1).map(testimonial => (
            <TestimonialCard 
              quote={testimonial.data.quote}
              author={testimonial.data.name}
              role={testimonial.data.currentRole}
              year={testimonial.data.graduationYear}
              image={testimonial.data.photo}
            />
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="empty-state">
      <PhQuotes size={40} weight="fill" class="text-slate-300" />
      <p class="empty-state-text">Aún no hay testimonios publicados.</p>
      <p class="empty-state-hint">¿Eres egresado? <a href="#comparte">Comparte tu historia</a> y aparece aquí.</p>
    </div>
  )}

  <!-- CTA — distinct band, primary background -->
  <section class="testimonial-cta" id="comparte">
    <div class="testimonial-cta-inner">
      <div class="testimonial-cta-content">
        <span class="testimonial-cta-eyebrow">Tu historia importa</span>
        <h2>¿Eres egresado de Comunicación Social?</h2>
        <p>
          Nos encantaría conocer tu trayectoria. Comparte cómo la formación en el NURR 
          influyó en tu camino profesional y inspira a futuros comunicadores.
        </p>
      </div>
      <a href="/contact" class="testimonial-cta-button">
        <PhEnvelopeSimple size={18} weight="regular" />
        <span>Comparte tu historia</span>
        <PhArrowRight size={16} weight="regular" />
      </a>
    </div>
  </section>
</ContentLayout>

<style>
  /* Intro — inline, editorial */
  .testimonial-intro {
    margin-bottom: 3rem;
    max-width: 48rem;
  }

  .testimonial-intro p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Featured testimonial */
  .featured-testimonial-wrapper {
    margin-bottom: 2rem;
  }

  /* Remaining testimonials — asymmetric grid */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface-elevated);
    border-radius: var(--radius-luma);
    margin-bottom: 4rem;
  }

  .empty-state-text {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 1rem 0 0.5rem;
  }

  .empty-state-hint {
    font-size: 0.9375rem;
    color: var(--color-ink-faint);
    margin: 0;
  }

  .empty-state-hint a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .empty-state-hint a:hover {
    color: var(--color-primary-deep);
  }

  /* CTA band — primary background, editorial */
  .testimonial-cta {
    background: var(--color-primary);
    border-radius: var(--radius-luma);
    padding: 3rem 2rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .testimonial-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .testimonial-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .testimonial-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .testimonial-cta {
      padding: 3.5rem 3rem;
    }
  }

  .testimonial-cta-content {
    flex: 1;
    max-width: 36rem;
  }

  .testimonial-cta-eyebrow {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.75rem;
  }

  .testimonial-cta-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: rgba(255,255,255,0.4);
    vertical-align: middle;
    margin-right: 0.75rem;
  }

  .testimonial-cta-content h2 {
    font-family: var(--font-display), sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .testimonial-cta-content h2 {
      font-size: 1.75rem;
    }
  }

  .testimonial-cta-content p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.75);
    margin: 0;
  }

  .testimonial-cta-button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: #ffffff;
    color: var(--color-primary);
    font-family: var(--font-display), sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.15);
  }

  .testimonial-cta-button:active {
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .testimonial-cta {
      padding: 2.5rem 1.5rem;
    }

    .testimonial-cta-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
