---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhNewspaper,
  PhVideo,
  PhMegaphone,
  PhCamera,
  PhClock,
  PhEnvelopeSimple,
  PhArrowRight,
  PhCaretRight,
} from 'phosphor-icons-astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'alumni-continuing-education');
const { title, subtitle, items = [] } = pageEntry?.data ?? {};
const body = pageEntry?.data?.body ?? pageEntry?.body ?? "";

const pageTitle = title ?? "Formación Continua";
const pageSubtitle = subtitle ?? "Cursos, talleres y programas de actualización para egresados";

// Icon lookup — map icon name strings to Phosphor components
const iconLookup: Record<string, typeof PhNewspaper> = {
  newspaper: PhNewspaper,
  video: PhVideo,
  megaphone: PhMegaphone,
  camera: PhCamera,
};

// Fallback icons by index for backward compat
const fallbackIcons: (typeof PhNewspaper)[] = [PhNewspaper, PhVideo, PhMegaphone, PhCamera];

const courses = items.map((item, i) => ({
  icon: (item.icon && iconLookup[item.icon]) || fallbackIcons[i] || PhNewspaper,
  title: item.title ?? "",
  description: item.description ?? "",
  hours: item.detail ?? "",
  href: item.href ?? "#",
}));
---

<ContentLayout
  title={pageTitle}
  subtitle={pageSubtitle}
  eyebrow="Egresados"
  breadcrumb={[
    { label: "Egresados", href: "/alumni" }
  ]}
  sectionTheme="admission"
>
  <!-- Intro — editorial, not boxed -->
  <div class="ce-intro">
    <p>
      {body || "La Escuela de Comunicación Social ofrece programas diseñados para actualizar y profundizar los conocimientos de nuestros egresados y profesionales del área. Cada programa combina teoría y práctica con enfoque en las demandas actuales del campo comunicacional."}
    </p>
  </div>

  <!-- Course Grid -->
  <div class="ce-grid">
    {courses.map((course) => (
      <a href={course.href} class="ce-card group">
        <div class="ce-card-icon">
          <course.icon size={22} weight="light" class="text-primary" />
        </div>
        <div class="ce-card-content">
          <h3 class="ce-card-title">{course.title}</h3>
          <p class="ce-card-desc">{course.description}</p>
          <div class="ce-card-meta">
            <span class="ce-card-meta-item">
              <PhClock size={14} weight="regular" />
              {course.hours}
            </span>
          </div>
          <span class="ce-card-cta">
            Más información
            <PhArrowRight size={14} weight="regular" />
          </span>
        </div>
      </a>
    ))}
  </div>

  <!-- CTA Band — primary background, actionable -->
  <section class="ce-cta" id="suscripcion">
    <div class="ce-cta-inner">
      <div class="ce-cta-content">
        <span class="ce-cta-eyebrow">Mantente al día</span>
        <h2>¿Quieres estar informado?</h2>
        <p>
          Suscríbete a nuestro boletín para recibir información sobre próximos programas,
          fechas de inscripción y eventos exclusivos para egresados.
        </p>
      </div>
      <a href="/contact" class="ce-cta-button">
        <PhEnvelopeSimple size={18} weight="regular" />
        <span>Suscribirme</span>
        <PhArrowRight size={16} weight="regular" />
      </a>
    </div>
  </section>

  <!-- Contact — inline, minimal -->
  <div class="ce-contact">
    <p>
      Para más información sobre los programas de formación continua,
      <a href="/contact" class="ce-contact-link">
        contacta a la coordinación de la Escuela
        <PhCaretRight size={14} weight="regular" />
      </a>
    </p>
  </div>
</ContentLayout>

<style>
  /* Intro — editorial, inline */
  .ce-intro {
    margin-bottom: 3rem;
    max-width: 48rem;
  }

  .ce-intro p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Course Grid */
  .ce-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .ce-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Course Card — interactive, hover lift */
  .ce-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    padding: 2rem;
    text-decoration: none;
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .ce-card:hover {
    box-shadow: var(--shadow-luma);
    border-color: rgba(226, 232, 240, 0.8);
    transform: translateY(-2px);
  }

  .ce-card:active {
    transform: translateY(0);
  }

  .ce-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .ce-card-icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-luma);
    background: rgba(0, 93, 170, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ce-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .ce-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .ce-card:hover .ce-card-title {
    color: var(--color-primary);
  }

  .ce-card-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .ce-card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ce-card-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }

  .ce-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 0.25rem;
    transition: gap 0.2s ease;
  }

  .ce-card:hover .ce-card-cta {
    gap: 0.75rem;
  }

  /* CTA Band — primary background */
  .ce-cta {
    background: var(--color-primary);
    border-radius: var(--radius-luma);
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }

  .ce-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .ce-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .ce-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .ce-cta {
      padding: 3rem 2.5rem;
    }
  }

  .ce-cta-content {
    flex: 1;
    max-width: 36rem;
  }

  .ce-cta-eyebrow {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.75rem;
  }

  .ce-cta-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: rgba(255,255,255,0.4);
    vertical-align: middle;
    margin-right: 0.75rem;
  }

  .ce-cta-content h2 {
    font-family: var(--font-display), sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .ce-cta-content h2 {
      font-size: 1.75rem;
    }
  }

  .ce-cta-content p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.75);
    margin: 0;
  }

  .ce-cta-button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: #ffffff;
    color: var(--color-primary);
    font-family: var(--font-display), sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ce-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.15);
  }

  .ce-cta-button:active {
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .ce-cta {
      padding: 2.5rem 1.5rem;
    }

    .ce-cta-button {
      width: 100%;
      justify-content: center;
    }
  }

  /* Contact — inline, minimal */
  .ce-contact {
    margin-bottom: 2rem;
  }

  .ce-contact p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .ce-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .ce-contact-link:hover {
    color: var(--color-primary-deep);
    gap: 0.5rem;
  }
</style>
