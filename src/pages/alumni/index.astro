---
import ContentLayout from '@/layouts/ContentLayout.astro';
import SectionCard from '@/components/SectionCard.astro';
import { PhUsersThree, PhIdentificationCard, PhCalendar, PhBooks, PhUserPlus } from 'phosphor-icons-astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'alumni-index');
const { title, subtitle, items = [], stats = [] } = pageEntry?.data ?? {};

const pageTitle = title ?? "Egresados";
const pageSubtitle = subtitle ?? "Red de egresados, testimonios y formación continua";

const displayStats = stats.length ? stats : [
  { value: "500+", label: "Egresados activos" },
  { value: "95%", label: "Tasa de empleo" },
  { value: "20+", label: "Años de trayectoria" },
];
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Egresados" sectionTheme="admission">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {items.slice(0, 6).map(item => (
      <SectionCard title={item.title ?? ""} description={item.description ?? ""} icon="quote" href={item.href ?? "#"} />
    ))}
  </div>

  <div class="mt-12 bg-white border border-tinted rounded-luma p-6 md:p-8">
    <h2 class="text-xl font-bold text-slate-900 mb-4">Red de Egresados</h2>
    <p class="text-slate-500 mb-6">
      La Escuela de Comunicación Social mantiene una activa red de egresados que incluye profesionales 
      destacados en periodismo, producción audiovisual, comunicación organizacional y relaciones públicas. 
      Nuestra comunidad de egresados es un pilar fundamental para el desarrollo de la carrera.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {displayStats.map(stat => (
        <div class="text-center p-6 bg-slate-50 rounded-lg">
          <span class="text-3xl font-bold text-primary">{stat.value}</span>
          <p class="text-sm text-slate-500 mt-2">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-8 bg-white border border-tinted rounded-luma p-6 md:p-8">
    <h2 class="text-xl font-bold text-slate-900 mb-4">Beneficios para Egresados</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <PhUsersThree size={18} weight="light" class="text-primary" />
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Red Profesional</h3>
          <p class="text-sm text-slate-500">Acceso a la red de contactos profesionales y oportunidades de networking</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <PhIdentificationCard size={18} weight="light" class="text-primary" />
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Descuentos en Cursos</h3>
          <p class="text-sm text-slate-500">Beneficios en programas de formación continua y posgrado</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <PhCalendar size={18} weight="light" class="text-primary" />
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Eventos Exclusivos</h3>
          <p class="text-sm text-slate-500">Invitación a eventos, foros y actividades de la carrera</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
          <PhBooks size={18} weight="light" class="text-primary" />
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">Biblioteca Virtual</h3>
          <p class="text-sm text-slate-500">Acceso a recursos digitales y bases de datos académicas</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 bg-primary/5 border border-primary/20 rounded-luma p-6 md:p-8">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
        <PhUserPlus size={20} weight="light" class="text-primary" />
      </div>
      <div>
        <h3 class="font-semibold text-slate-900">¿Eres egresado?</h3>
        <p class="text-sm text-slate-500 mt-1">
          Actualiza tus datos en nuestra base de datos para mantenerte conectado con la comunidad 
          y recibir información sobre oportunidades laborales y eventos.
        </p>
      </div>
    </div>
  </div>
</ContentLayout>
