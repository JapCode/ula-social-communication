---
// Decap CMS admin panel — serves at /admin/
// Script must be in <body> so document.body exists when Decap initializes
// Config is served from public/admin/config.yml at /admin/config.yml
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Administración</title>
  </head>
  <body>
    <script is:inline src="/admin/decap-cms.js"></script>
    <script is:inline>
      // Decap CMS preview fix: ensure the preview iframe resolves images
      // relative to the current origin instead of the hardcoded site_url.
      // This allows newly uploaded images to load in both local dev and production.
      (function() {
        var origin = window.location.origin;
        setInterval(function() {
          document.querySelectorAll('iframe').forEach(function(iframe) {
            try {
              var doc = iframe.contentDocument;
              if (doc && doc.head && !doc.querySelector('base[data-fixed]')) {
                var base = doc.createElement('base');
                base.href = origin;
                base.setAttribute('data-fixed', '');
                doc.head.prepend(base);
              }
            } catch(e) {
              // Cross-origin iframe — skip
            }
          });
        }, 1000);
      })();
    </script>
  </body>
</html>
