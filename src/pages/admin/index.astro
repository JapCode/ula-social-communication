    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Administración</title>
  </head>
  <body>
    <script is:inline src="/admin/decap-cms.js"></script>
    <script is:inline src="/admin/cms-preview-fix.js"></script>
  </body>
</html>
