---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhUsersThree,
  PhMaskHappy,
  PhHeart,
  PhCalendar,
  PhCalendarCheck,
  PhArrowRight,
} from 'phosphor-icons-astro';
import { getCollection, getEntry } from 'astro:content';

const allEvents = await getCollection('events');
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = allEvents
  .filter(e => new Date(e.data.date) >= today)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const pageEntry = await getEntry('pages', 'student-life-index');
const { title, subtitle, items = [] } = pageEntry?.data ?? {};

const pageTitle = title ?? "Vida Estudiantil";
const pageSubtitle = subtitle ?? "Actividades, organizaciones y oportunidades para los estudiantes de Comunicación Social";

// Icons hardcoded by index for the 5 sections
const sectionIcons = [PhUsersThree, PhMaskHappy, PhHeart, PhCalendar, PhCalendarCheck];
const sections = items.slice(0, 5).map((item, i) => ({
  icon: sectionIcons[i] || PhUsersThree,
  title: item.title ?? "",
  subtitle: item.description ?? "",
  href: item.href ?? "#",
}));
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Comunidad" sectionTheme="student-life">
  <div class="py-4 md:py-8">

    <!-- Intro -->
    <div class="mb-10 md:mb-14 max-w-2xl">
      <p class="text-slate-500 leading-relaxed text-lg">
        La vida estudiantil en Comunicación Social va más allá del aula. Conocé las organizaciones, actividades y oportunidades que forman parte de tu experiencia académica.
      </p>
    </div>

    <!-- Navigation strip — horizontal on desktop, 2-col grid on mobile -->
    <div class="mb-12 md:mb-16">
      <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Secciones</h2>

      <!-- Mobile: 2-col grid -->
      <div class="md:hidden grid grid-cols-2 gap-3">
        {sections.map(section => {
          const Icon = section.icon;
          return (
            <a href={section.href} class="group flex flex-col items-center gap-3 p-5 bg-white border border-tinted rounded-luma text-center transition-all duration-300 hover:shadow-luma active:scale-[0.98]">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-active:scale-95">
                <Icon size={22} weight="light" class="text-primary" />
              </div>
              <div>
                <span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">{section.title}</span>
                <span class="text-xs text-slate-500">{section.subtitle}</span>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Desktop: editorial row with varied visual weights -->
      <div class="hidden md:grid md:grid-cols-5 gap-4">
        {sections.map((section, i) => {
          const Icon = section.icon;
          const isCenter = i === 2; // middle item gets accent treatment
          return (
            <a href={section.href} class={`group flex flex-col gap-4 p-6 md:p-7 bg-white border border-tinted rounded-luma text-center transition-all duration-300 hover:shadow-luma hover:-translate-y-0.5 active:scale-[0.98] ${isCenter ? 'md:col-span-1 bg-section-student-life border-green/20' : ''}`}>
              <div class={`w-14 h-14 mx-auto rounded-full flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-active:scale-95 ${isCenter ? 'bg-green/10' : 'bg-primary/10'}`}>
                <Icon size={24} weight={isCenter ? "fill" : "light"} class={isCenter ? "text-green" : "text-primary"} />
              </div>
              <div class="flex flex-col items-center gap-1">
                <span class="text-xs font-bold tracking-widest uppercase text-ink">{section.title}</span>
                <span class="text-xs text-ink-muted leading-tight">{section.subtitle}</span>
              </div>
              <div class={`flex items-center justify-center gap-1 opacity-0 group-hover:opacity-100 transition-all duration-300 ${isCenter ? 'text-green' : 'text-primary'}`}>
                <span class="text-xs font-semibold">Explorar</span>
                <PhArrowRight size={12} weight="bold" class="transition-transform duration-300 group-hover:translate-x-0.5" />
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Upcoming Events Preview -->
    {upcomingEvents.length > 0 && (
      <div class="mb-12 md:mb-16">
        <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6">Próximos Eventos</h2>
        <div class="space-y-3">
          {upcomingEvents.map(event => (
            <a href={`/student-life/events#${event.slug}`} class="group flex items-center gap-4 p-4 bg-white border border-tinted rounded-luma transition-all duration-300 hover:shadow-luma hover:-translate-y-0.5">
              <div class="w-12 h-12 rounded-full bg-green/10 flex items-center justify-center flex-shrink-0">
                <span class="text-xs font-bold text-green">
                  {new Date(event.data.date).getDate()}
                </span>
              </div>
              <div class="flex-1 min-w-0">
                <span class="block text-sm font-semibold text-slate-900 truncate group-hover:text-green transition-colors">{event.data.title}</span>
                <span class="block text-xs text-slate-500">
                  {new Date(event.data.date).toLocaleDateString('es-ES', { month: 'long', day: 'numeric' })}
                </span>
              </div>
              <PhArrowRight size={14} weight="light" class="text-slate-300 group-hover:text-green transition-colors flex-shrink-0" />
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</ContentLayout>
