---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { requestWithMetadata } from '@tinacms/astro/data';
import { client } from '../../../../tina/__generated__/client';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { PhArrowRight } from 'phosphor-icons-astro';
import { getTypeLabel, getTypeColors } from '@/lib/events';

const { slug } = Astro.params;
const enriched = await requestWithMetadata(
  client.queries.events({ relativePath: `${slug}.md` })
);
const event = enriched.data.events;
if (!event) {
  return new Response('Evento no encontrado', { status: 404 });
}

// Normalize image paths from Decap CMS
function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

const coverImageUrl = normalizeImagePath(event.coverImage);

const eventDate = new Date(event.date);
const formattedDate = eventDate.toLocaleDateString('es-VE', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const pageTitle = event.title;
const pageSubtitle = formattedDate;
---

<ContentLayout 
  title={pageTitle} 
  subtitle={pageSubtitle}
  eyebrow={getTypeLabel(event.type) || "Evento"}
  sectionTheme="student-life"
  breadcrumb={[
    { label: "Vida Estudiantil", href: "/student-life" },
    { label: "Eventos", href: "/student-life/events" },
  ]}
>
  <article class="max-w-3xl">

    <!-- Event info bar — minimal, no icons -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8 text-sm">
      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${getTypeColors(event.type)}`}>
        {getTypeLabel(event.type)}
      </span>
      <span class="text-slate-300">·</span>
      <span class="text-slate-500">{event.location}</span>
    </div>

    <!-- Cover Image -->
    {coverImageUrl && (
      <div class="mb-8">
        <img src={coverImageUrl} alt={`Imagen del evento: ${event.title}`} class="w-full rounded-[var(--radius-luma)]" loading="lazy" />
      </div>
    )}

    <!-- Event Content -->
    <div class="content-area">
      {event.body && <TinaMarkdown content={event.body} />}
    </div>

    <!-- CTA -->
    <div class="mt-10 pt-8 border-t border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h3 class="text-base font-bold text-slate-900">¿Quieres participar?</h3>
          <p class="text-sm text-slate-500 mt-1">Contacta a la coordinación para más información o inscripción.</p>
        </div>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-full hover:shadow-luma hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 flex-shrink-0">
          Contactar
          <PhArrowRight size={14} weight="regular" />
        </a>
      </div>
    </div>

  </article>
</ContentLayout>