---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import {
  PhCalendarBlank,
  PhClock,
  PhMapPin,
  PhArrowRight,
  PhQuestion,
} from 'phosphor-icons-astro';
import { getTypeLabel, getTypeColors, getTypeIcon } from '@/lib/events';

// ============================================================
// Data
// ============================================================

const events = await getCollection('events');

// Sort by date ascending for timeline
const sortedEvents = events.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Separate upcoming vs past
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = sortedEvents.filter(e => new Date(e.data.date) >= today);
const pastEvents = sortedEvents.filter(e => new Date(e.data.date) < today);

const pageTitle = "Calendario Académico";
const pageSubtitle = "Fechas importantes y eventos programados durante el año lectivo";
---

<ContentLayout 
  title={pageTitle} 
  subtitle={pageSubtitle} 
  eyebrow="Vida Estudiantil"
  breadcrumb={[
    { label: "Vida Estudiantil", href: "/student-life" },
  ]}
>
  <div class="py-8 md:py-12">
    <!-- Intro -->
    <div class="mb-10 md:mb-14 max-w-2xl reveal-intro">
      <p class="text-slate-500 leading-relaxed text-lg">
        Mantente al día con todas las actividades académicas, culturales y especiales de la Escuela de Comunicación Social. A continuación los próximos eventos del calendario.
      </p>
    </div>

    <!-- Timeline: Upcoming Events -->
    <div class="relative" id="events-container">
      {upcomingEvents.length > 0 ? (
        <>
          <!-- Vertical timeline line -->
          <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-200 md:left-0" />

          <!-- Event count indicator -->
          <div class="mb-8 p-4 rounded-lg bg-primary/[0.03] border border-primary/10 reveal-intro">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-primary animate-pulse" />
              <p class="text-sm text-slate-600">
                <span class="font-medium text-slate-800">{upcomingEvents.length} próximos eventos</span>
                <span class="text-slate-400"> — </span>
                <span class="text-primary font-mono text-xs tracking-wide" id="event-count-label">actualizado hoy</span>
              </p>
            </div>
          </div>

          {upcomingEvents.map((event, index) => {
            const eventDate = new Date(event.data.date);
            const formattedDate = eventDate.toLocaleDateString('es-VE', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            });
            const dayName = eventDate.toLocaleDateString('es-VE', { weekday: 'long' });
            const TypeIcon = getTypeIcon(event.data.type);
            const isLast = index === upcomingEvents.length - 1;
            return (
              <article
                class:list={[
                  "step-row group relative pl-8 md:pl-12",
                  isLast ? "" : "mb-0",
                ]}
                data-type={event.data.type}
              >
                {/* Timeline dot */}
                <div
                  class="step-dot absolute left-[-5px] top-10 w-2.5 h-2.5 rounded-full border-2 border-surface bg-slate-300 transition-all duration-300"
                />

                <div class="step-content relative">
                  {/* Event number — subtle background */}
                  <div class="absolute right-4 md:right-8 top-6 pointer-events-none select-none">
                    <span
                      class:list={[
                        "step-bg-number text-6xl md:text-8xl font-bold font-body leading-none",
                        "text-slate-200/60",
                      ]}
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>

                  {/* Type badge */}
                  <div class="mb-3">
                    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${getTypeColors(event.data.type)}`}>
                      <TypeIcon size={12} weight="regular" />
                      {getTypeLabel(event.data.type)}
                    </span>
                  </div>

                  <div class="flex flex-col md:flex-row md:items-start md:justify-between md:gap-8">
                    {/* Content */}
                    <div class="flex-1 mb-3 md:mb-0 pr-16 md:pr-24">
                      <a href={`/student-life/events/${event.id}`} class="block">
                        <h2 class="step-title text-lg md:text-xl font-medium tracking-tight mb-1.5 text-slate-700">
                          {event.data.title}
                        </h2>
                      </a>
                      <p class="step-desc leading-relaxed max-w-xl text-slate-400">
                        {event.data.description}
                      </p>
                      <div class="flex items-center gap-1.5 mt-2 text-xs text-slate-300">
                        <PhMapPin size={14} weight="regular" />
                        <span>{event.data.location}</span>
                      </div>
                    </div>

                    {/* Date — Monospace Label */}
                    <div class="flex-shrink-0 self-start text-right">
                      <div class="step-date-line w-6 h-px ml-auto mb-1.5 bg-slate-200" />
                      <p class="step-date-text text-[10px] font-mono tracking-wider uppercase text-slate-300">
                        {formattedDate}
                      </p>
                      <p class="text-[10px] font-mono tracking-wider text-slate-200 mt-0.5 capitalize">
                        {dayName}
                      </p>
                    </div>
                  </div>
                </div>

                {/* Separator line between events */}
                {!isLast && (
                  <div class="step-separator ml-1.5 mt-6 mb-6 md:mt-8 md:mb-8">
                    <div class="h-px bg-slate-100" />
                  </div>
                )}
              </article>
            );
          })}
        </>
      ) : (
        <!-- Empty State: No upcoming events -->
        <div class="empty-state text-center py-16 px-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-5">
            <PhCalendarBlank size={32} weight="light" class="text-slate-300" />
          </div>
          <h3 class="text-lg font-bold text-slate-700 mb-2">No hay eventos próximos</h3>
          <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">
            No hay eventos programados para este período. Revisa próximamente o contacta a la coordinación para más información.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-full hover:shadow-luma hover:-translate-y-0.5 transition-all duration-300">
            Contactar Coordinación
            <PhArrowRight size={14} weight="regular" />
          </a>
        </div>
      )}
    </div>

    <!-- Past Events (collapsible) -->
    {pastEvents.length > 0 && (
      <details class="past-events-group border-t border-slate-100 pt-8 mt-10 md:mt-14">
        <summary class="flex items-center gap-3 cursor-pointer group list-none">
          <PhClock size={18} weight="regular" class="text-slate-400 group-hover:text-primary transition-colors" />
          <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400 group-hover:text-slate-600 transition-colors">
            Eventos Pasados ({pastEvents.length})
          </h2>
          <span class="ml-auto text-slate-300 group-open:rotate-180 transition-transform duration-300">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </summary>
        <div class="mt-6 relative">
          <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-100" />
          <div class="space-y-0">
            {pastEvents.map(event => {
              const eventDate = new Date(event.data.date);
              const formattedDate = eventDate.toLocaleDateString('es-VE', { day: 'numeric', month: 'short', year: 'numeric' });
              return (
                <a
                  href={`/student-life/events/${event.id}`}
                  class="past-event-row group relative pl-8 md:pl-12 py-4 flex items-center gap-4 transition-all duration-200 hover:bg-slate-50/50 rounded-lg"
                >
                  <div class="step-dot absolute left-[-5px] top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-slate-200" />
                  <div class="flex-shrink-0 text-xs font-semibold text-slate-300 w-28 font-mono">{formattedDate}</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-medium text-slate-400 group-hover:text-slate-600 transition-colors truncate">
                      {event.data.title}
                    </h3>
                  </div>
                  <span class={`type-badge inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider opacity-50 ${getTypeColors(event.data.type)}`}>
                    {getTypeLabel(event.data.type)}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </details>
    )}

    <!-- Contextual Help — matching admission page style -->
    <div class="mt-10 md:mt-14 p-6 md:p-8 rounded-xl bg-slate-50/80 border border-slate-100">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 border border-primary/10 flex items-center justify-center">
          <PhQuestion size={20} weight="light" class="text-primary" />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-medium text-slate-700 mb-1">
            ¿Quieres proponer un evento?
          </h3>
          <p class="text-slate-400 leading-relaxed text-sm mb-4">
            ¿Eres estudiante o docente y quieres organizar un evento relacionado con Comunicación Social? 
            Consulta los requisitos y contacta a la coordinación.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-deep transition-colors"
            >
              Contactar Coordinación
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
            <span class="text-slate-300">|</span>
            <a
              href="/student-life/events"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition-colors"
            >
              Ver todos los eventos
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</ContentLayout>

<script>
  // ============================================================
  // Scroll-triggered reveal animations
  // ============================================================
  function initRevealAnimations() {
    const revealElements = document.querySelectorAll(
      ".reveal-intro, .step-row"
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  }

  // Run on full page load
  document.addEventListener("DOMContentLoaded", () => {
    initRevealAnimations();
  });

  // Run on Astro client-side navigation
  document.addEventListener("astro:page-load", () => {
    initRevealAnimations();
  });
</script>

<style>
  /* ============================================================
     Scroll Reveal Animations
     ============================================================ */

  .reveal-intro,
  .step-row {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-intro.is-visible,
  .step-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for step rows */
  .step-row:nth-child(1) {
    transition-delay: 0ms;
  }
  .step-row:nth-child(2) {
    transition-delay: 80ms;
  }
  .step-row:nth-child(3) {
    transition-delay: 160ms;
  }
  .step-row:nth-child(4) {
    transition-delay: 240ms;
  }
  .step-row:nth-child(5) {
    transition-delay: 320ms;
  }
  .step-row:nth-child(6) {
    transition-delay: 400ms;
  }
  .step-row:nth-child(7) {
    transition-delay: 480ms;
  }
  .step-row:nth-child(8) {
    transition-delay: 560ms;
  }

  /* ============================================================
     Step Row Layout — matching admission page
     ============================================================ */

  .step-row {
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Subtle hover: background tint only, no layout shift */
  .step-row:hover {
    background-color: rgba(248, 250, 252, 0.4);
    border-radius: 6px;
  }

  .step-row .step-title {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-title {
    color: var(--color-primary);
  }

  .step-row .step-desc {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-desc {
    color: #94a3b8;
  }

  .step-row .step-bg-number {
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-row:hover .step-bg-number {
    opacity: 0.15;
    transform: scale(1.03);
  }

  .step-row .step-date-line {
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .step-row:hover .step-date-line {
    width: 16px;
    background-color: var(--color-primary);
  }

  .step-row .step-date-text {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-date-text {
    color: var(--color-primary);
  }

  /* ============================================================
     Past Events
     ============================================================ */

  .past-events-group[open] summary ~ * {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Remove default details marker for custom chevron */
  .past-events-group summary::-webkit-details-marker {
    display: none;
  }

  /* ============================================================
     Reduced Motion
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .reveal-intro,
    .step-row {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .step-row:hover {
      background-color: transparent;
    }

    .step-row .step-title,
    .step-row .step-desc,
    .step-row .step-bg-number,
    .step-row .step-date-line,
    .step-row .step-date-text {
      transition: none;
    }

    .step-row:hover .step-bg-number {
      opacity: 0.05;
      transform: none;
    }

    .past-events-group[open] summary ~ * {
      animation: none !important;
    }
  }
</style>
