---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { requestWithMetadata } from '@tinacms/astro/data';
import { tinaField } from '@tinacms/astro/tina-field';
import { client } from '../../../tina/__generated__/client';
import {
  PhCalendarX,
  PhEnvelopeSimple,
  PhArrowRight,
  PhMapPin,
} from 'phosphor-icons-astro';
import { getTypeLabel, getTypeColors, getTypeIcon } from '@/lib/events';

// Normalize image paths from Decap CMS
function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

const events = await getCollection('events');
const sortedEvents = events.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Featured = most recent event
const featured = sortedEvents[0] || null;
const remaining = sortedEvents.slice(1);

// ============================================================
// Page content from CMS
// ============================================================

const enriched = await requestWithMetadata(
  client.queries.pageEventsListing({ relativePath: 'student-life-events-listing.md' })
);

const pageData = enriched.data.pageEventsListing;

if (!pageData) {
  throw new Error('Events listing page entry not found');
}

const { title, subtitle, body, cta, emptyState } = pageData;
const breadcrumb = [{ label: "Vida Estudiantil", href: "/student-life" }];
---

<ContentLayout title={title} subtitle={subtitle} breadcrumb={breadcrumb} eyebrow="Vida Estudiantil" sectionTheme="student-life" data-tina-field={tinaField(pageData, 'title')} >
  <div class="py-4 md:py-8">

    <!-- Intro -->
    {body && (
      <div class="mb-10 md:mb-14 max-w-2xl reveal-intro">
        <p class="text-slate-500 leading-relaxed text-lg" data-tina-field={tinaField(pageData, 'body')}>{body}</p>
      </div>
    )}

    {sortedEvents.length > 0 ? (
      <>
        <!-- Featured Event — most recent, prominent treatment -->
        {featured && (
          <div class="mb-12 md:mb-16 reveal-intro">
            <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Destacado</h2>

            {(() => {
              const eventDate = new Date(featured.data.date);
              const formattedDate = eventDate.toLocaleDateString('es-VE', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              });
              const TypeIcon = getTypeIcon(featured.data.type);
              return (
                <a href={`/student-life/events/${featured.id}`} class="group block">
                  <div class="bg-white border border-tinted rounded-luma overflow-hidden transition-all duration-300 hover:shadow-luma">
                    {(() => {
                      const coverUrl = normalizeImagePath(featured.data.coverImage);
                      return coverUrl ? (
                        <div class="aspect-video w-full overflow-hidden">
                          <img src={coverUrl} alt={`Imagen del evento: ${featured.data.title}`} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
                        </div>
                      ) : null;
                    })()}
                    <div class="p-6 md:p-8 lg:p-10">
                      {/* Type badge + date */}
                      <div class="flex items-center gap-3 mb-4">
                        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${getTypeColors(featured.data.type)}`}>
                          <TypeIcon size={12} weight="regular" />
                          {getTypeLabel(featured.data.type)}
                        </span>
                        <span class="text-xs text-slate-400">{formattedDate}</span>
                      </div>

                      {/* Title */}
                      <h3 class="text-xl md:text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight mb-3 group-hover:text-primary transition-colors duration-300 leading-tight">
                        {featured.data.title}
                      </h3>

                      {/* Description */}
                      <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-5 max-w-2xl">
                        {featured.data.description}
                      </p>

                      {/* Location + CTA */}
                      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                        <div class="flex items-center gap-1.5 text-xs text-slate-400">
                          <PhMapPin size={14} weight="regular" />
                          <span>{featured.data.location}</span>
                        </div>
                        <span class="inline-flex items-center gap-1.5 text-sm font-bold text-primary group-hover:gap-2.5 transition-all duration-300">
                          Ver detalles
                          <PhArrowRight size={14} weight="regular" class="transition-transform duration-300 group-hover:translate-x-0.5" />
                        </span>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })()}
          </div>
        )}

        <!-- All other events — list rows with dividers -->
        {remaining.length > 0 && (
          <div class="mb-12 md:mb-16">
            <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Todos los Eventos</h2>

            <div class="divide-y divide-tinted">
              {remaining.map((event, index) => {
                const eventDate = new Date(event.data.date);
                const formattedDate = eventDate.toLocaleDateString('es-VE', {
                  day: 'numeric',
                  month: 'short',
                });
                const TypeIcon = getTypeIcon(event.data.type);
                return (
                  <div class="group py-5 md:py-6 first:pt-0 reveal-intro">
                    <a href={`/student-life/events/${event.id}`} class="flex items-start gap-4 md:gap-6">
                      {/* Date block */}
                      <div class="flex-shrink-0 w-14 text-center pt-0.5">
                        <span class="block text-lg font-bold text-ink leading-none">{eventDate.getDate()}</span>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-green mt-0.5">{formattedDate.split(' ')[1]}</span>
                      </div>

                      {/* Thumbnail */}
                      {(() => {
                        const thumbUrl = normalizeImagePath(event.data.coverImage);
                        return thumbUrl ? (
                          <div class="flex-shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-lg overflow-hidden">
                            <img src={thumbUrl} alt="" class="w-full h-full object-cover" loading="lazy" />
                          </div>
                        ) : null;
                      })()}

                      {/* Content */}
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1.5">
                          <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider ${getTypeColors(event.data.type)}`}>
                            <TypeIcon size={10} weight="regular" />
                            {getTypeLabel(event.data.type)}
                          </span>
                        </div>
                        <h3 class="text-sm md:text-base font-bold text-slate-900 tracking-tight group-hover:text-primary transition-colors duration-300 leading-snug">
                          {event.data.title}
                        </h3>
                        <p class="text-xs md:text-sm text-slate-400 mt-1 leading-relaxed line-clamp-2 max-w-xl">
                          {event.data.description}
                        </p>
                        <div class="flex items-center gap-1.5 mt-2 text-xs text-slate-300">
                          <PhMapPin size={12} weight="regular" />
                          <span>{event.data.location}</span>
                        </div>
                      </div>

                      {/* Arrow */}
                      <PhArrowRight size={14} weight="light" class="text-slate-300 group-hover:text-primary transition-colors flex-shrink-0 mt-2" />
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </>
    ) : (
      <!-- Empty State -->
      <div class="text-center py-16 px-6 mb-12 md:mb-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-5">
          <PhCalendarX size={32} weight="light" class="text-slate-300" />
        </div>
        <h3 class="text-lg font-bold text-slate-700 mb-2" data-tina-field={tinaField(emptyState, 'title')}>{emptyState?.title ?? 'No hay eventos programados'}</h3>
        {emptyState?.body && <p class="text-sm text-slate-500 max-w-md mx-auto mb-6" data-tina-field={tinaField(emptyState, 'body')}>{emptyState.body}</p>}
        {emptyState?.label && (
          <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-full hover:shadow-luma hover:-translate-y-0.5 transition-all duration-300">
            <span data-tina-field={tinaField(emptyState, 'label')}>{emptyState.label}</span>
            <PhArrowRight size={14} weight="regular" />
          </a>
        )}
      </div>
    )}

    <!-- CTA: Organize your own event -->
    {cta && (
      <div class="mt-10 md:mt-14 p-6 md:p-8 rounded-xl bg-slate-50/80 border border-slate-100">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 border border-primary/10 flex items-center justify-center">
            <PhEnvelopeSimple size={20} weight="light" class="text-primary" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base font-medium text-slate-700 mb-1" data-tina-field={tinaField(cta, 'title')}>{cta.title}</h3>
            {cta.body && <p class="text-slate-400 leading-relaxed text-sm mb-4" data-tina-field={tinaField(cta, 'body')}>{cta.body}</p>}
            <div class="flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-deep transition-colors"
              >
                <span data-tina-field={tinaField(cta, 'label')}>{cta.label ?? 'Contactar Coordinación'}</span>
                <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

  </div>
</ContentLayout>

<script>
  function initRevealAnimations() {
    const revealElements = document.querySelectorAll(".reveal-intro");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  }

  document.addEventListener("DOMContentLoaded", () => {
    initRevealAnimations();
  });

  document.addEventListener("astro:page-load", () => {
    initRevealAnimations();
  });
</script>

<style>
  .reveal-intro {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-intro.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger for list items */
  .divide-y > .reveal-intro:nth-child(1) { transition-delay: 0ms; }
  .divide-y > .reveal-intro:nth-child(2) { transition-delay: 80ms; }
  .divide-y > .reveal-intro:nth-child(3) { transition-delay: 160ms; }
  .divide-y > .reveal-intro:nth-child(4) { transition-delay: 240ms; }
  .divide-y > .reveal-intro:nth-child(5) { transition-delay: 320ms; }

  @media (prefers-reduced-motion: reduce) {
    .reveal-intro {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
