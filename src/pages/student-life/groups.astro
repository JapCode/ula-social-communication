---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhFilmStrip,
  PhMaskHappy,
  PhMicrophoneStage,
  PhCamera,
  PhArrowRight,
  PhUsers,
} from 'phosphor-icons-astro';

const pageTitle = "Grupos y Talleres";
const breadcrumb = [{ label: "Vida Estudiantil", href: "/student-life" }];

const groups = [
  {
    name: "Cine Club",
    description: "Producción y análisis cinematográfico. Proyecciones, debates y cortometrajes realizados por estudiantes.",
    details: "Encuentros semanales · Proyecciones mensuales",
    icon: PhFilmStrip,
  },
  {
    name: "Grupo de Teatro",
    description: "Creación escénica y actuación. Montajes propios y participación en festivales universitarios.",
    details: "Ensayos martes y jueves · Montaje semestral",
    icon: PhMaskHappy,
  },
  {
    name: "Radio Universidad",
    description: "Producción radial y locución. Programas en vivo, podcasts y cobertura de eventos del núcleo.",
    details: "Programación semanal · Taller de locución",
    icon: PhMicrophoneStage,
  },
  {
    name: "Club de Fotografía",
    description: "Fotografía documental y artística. Salidas fotográficas, exposiciones y técnicas de revelado.",
    details: "Salidas quincenales · Exposición anual",
    icon: PhCamera,
  },
];

const workshops = [
  {
    name: "Taller de Escritura Creativa",
    description: "Narrativa breve, guion y crónica. Espacio de producción y revisión de textos con enfoque en comunicación.",
    details: "Duración: 8 semanas · Cupo limitado",
    icon: PhUsers,
  },
  {
    name: "Taller de Edición de Video",
    description: "Postproducción audiovisual con herramientas profesionales. Desde el corte básico hasta efectos visuales.",
    details: "Duración: 6 semanas · Requiere laptop",
    icon: PhFilmStrip,
  },
];
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb}>
  <div class="py-4 md:py-8">

    <!-- Intro -->
    <div class="mb-10 md:mb-14 max-w-2xl">
      <p class="text-slate-500 leading-relaxed text-lg">
        Los grupos y talleres son espacios extracurriculares donde los estudiantes desarrollan habilidades creativas, trabajan en equipo y representan a la escuela en eventos culturales.
      </p>
    </div>

    <!-- Groups directory — full-width rows with separators -->
    <div class="mb-12 md:mb-16">
      <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Grupos Activos</h2>

      <div class="divide-y divide-slate-100">
        {groups.map((group, index) => {
          const Icon = group.icon;
          return (
            <div class="group py-6 md:py-8 first:pt-0">
              <div class="flex items-start gap-5 md:gap-8">
                {/* Icon — larger, no circle wrapper */}
                <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-primary/5 border border-primary/10 flex items-center justify-center transition-all duration-300 group-hover:bg-primary/10 group-hover:scale-105">
                  <Icon size={26} weight="light" class="text-primary transition-transform duration-300 group-hover:scale-110" />
                </div>

                {/* Content */}
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg md:text-xl font-bold text-slate-900 tracking-tight mb-1.5 group-hover:text-primary transition-colors duration-300">
                    {group.name}
                  </h3>
                  <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-3 max-w-xl">
                    {group.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <span class="text-xs text-slate-400 font-medium">{group.details}</span>
                    <a href="/contact" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-deep transition-colors group/link">
                      Cómo participar
                      <PhArrowRight size={12} weight="light" class="transition-transform duration-200 group-hover/link:translate-x-0.5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Workshops directory — full-width rows with separators -->
    <div class="mb-12 md:mb-16">
      <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Talleres</h2>

      <div class="divide-y divide-slate-100">
        {workshops.map((workshop, index) => {
          const Icon = workshop.icon;
          return (
            <div class="group py-6 md:py-8 first:pt-0">
              <div class="flex items-start gap-5 md:gap-8">
                <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-accent/5 border border-accent/10 flex items-center justify-center transition-all duration-300 group-hover:bg-accent/10 group-hover:scale-105">
                  <Icon size={26} weight="light" class="text-accent transition-transform duration-300 group-hover:scale-110" />
                </div>

                <div class="flex-1 min-w-0">
                  <h3 class="text-lg md:text-xl font-bold text-slate-900 tracking-tight mb-1.5 group-hover:text-accent transition-colors duration-300">
                    {workshop.name}
                  </h3>
                  <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-3 max-w-xl">
                    {workshop.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <span class="text-xs text-slate-400 font-medium">{workshop.details}</span>
                    <a href="/contact" class="inline-flex items-center gap-1 text-xs font-bold text-accent hover:text-accent-soft transition-colors group/link">
                      Inscribirse
                      <PhArrowRight size={12} weight="light" class="transition-transform duration-200 group-hover/link:translate-x-0.5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- CTA: Start a new group -->
    <div class="p-6 md:p-8 rounded-xl bg-slate-50/80 border border-slate-100">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 border border-primary/10 flex items-center justify-center">
          <PhUsers size={20} weight="light" class="text-primary" />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-medium text-slate-700 mb-1">
            ¿Querés crear un nuevo grupo o taller?
          </h3>
          <p class="text-slate-400 leading-relaxed text-sm mb-4">
            Si tenés una idea para un grupo o taller que no está en la lista, presentá tu propuesta ante la coordinación. 
            Siempre hay espacio para nuevas iniciativas estudiantiles.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-deep transition-colors"
            >
              Proponer una actividad
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</ContentLayout>
