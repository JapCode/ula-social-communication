---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhFilmStrip,
  PhMaskHappy,
  PhMicrophoneStage,
  PhCamera,
  PhUsers,
  PhPenNib,
  PhMusicNote,
  PhPalette,
  PhGameController,
  PhBookOpen,
  PhHeadphones,
  PhVideo,
  PhLightbulb,
  PhStar,
  PhRocket,
  PhArrowRight,
} from 'phosphor-icons-astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'student-life-groups');

if (!pageEntry) {
  throw new Error('Groups page entry not found');
}

const { title, body, groups, workshops, cta } = pageEntry.data;

const iconMap: Record<string, any> = {
  FilmStrip: PhFilmStrip,
  MaskHappy: PhMaskHappy,
  MicrophoneStage: PhMicrophoneStage,
  Camera: PhCamera,
  Users: PhUsers,
  PenNib: PhPenNib,
  MusicNote: PhMusicNote,
  Palette: PhPalette,
  GameController: PhGameController,
  BookOpen: PhBookOpen,
  Headphones: PhHeadphones,
  Video: PhVideo,
  Lightbulb: PhLightbulb,
  Star: PhStar,
  Rocket: PhRocket,
};

const breadcrumb = [{ label: "Vida Estudiantil", href: "/student-life" }];
---

<ContentLayout title={title} breadcrumb={breadcrumb} sectionTheme="student-life">
  <div class="py-4 md:py-8">

    <!-- Intro -->
    {body && (
      <div class="mb-10 md:mb-14 max-w-2xl">
        <p class="text-slate-500 leading-relaxed text-lg">{body}</p>
      </div>
    )}

    <!-- Groups directory -->
    {groups && groups.length > 0 && (
      <div class="mb-12 md:mb-16">
        <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Grupos Activos</h2>

        <div class="divide-y divide-slate-100">
          {groups.map((group: { title: string; description?: string; detail?: string; icon?: string }) => {
            const Icon = iconMap[group.icon ?? 'Users'] ?? PhUsers;
            return (
              <div class="group py-6 md:py-8 first:pt-0">
                <div class="flex items-start gap-5 md:gap-8">
                  <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-primary/5 border border-primary/10 flex items-center justify-center transition-all duration-300 group-hover:bg-primary/10 group-hover:scale-105">
                    <Icon size={26} weight="light" class="text-primary transition-transform duration-300 group-hover:scale-110" />
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg md:text-xl font-bold text-slate-900 tracking-tight mb-1.5 group-hover:text-primary transition-colors duration-300">
                      {group.title}
                    </h3>
                    {group.description && (
                      <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-3 max-w-xl">{group.description}</p>
                    )}
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                      {group.detail && <span class="text-xs text-slate-400 font-medium">{group.detail}</span>}
                      <a href="/contact" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-deep transition-colors group/link">
                        Cómo participar
                        <PhArrowRight size={12} weight="light" class="transition-transform duration-200 group-hover/link:translate-x-0.5" />
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Workshops directory -->
    {workshops && workshops.length > 0 && (
      <div class="mb-12 md:mb-16">
        <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8">Talleres</h2>

        <div class="divide-y divide-slate-100">
          {workshops.map((workshop: { title: string; description?: string; detail?: string; icon?: string }) => {
            const Icon = iconMap[workshop.icon ?? 'Users'] ?? PhUsers;
            return (
              <div class="group py-6 md:py-8 first:pt-0">
                <div class="flex items-start gap-5 md:gap-8">
                  <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-accent/10 border border-accent/15 flex items-center justify-center transition-all duration-300 group-hover:bg-accent/15 group-hover:scale-105">
                    <Icon size={26} weight="light" class="text-accent transition-transform duration-300 group-hover:scale-110" />
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg md:text-xl font-bold text-slate-900 tracking-tight mb-1.5 group-hover:text-primary transition-colors duration-300">
                      {workshop.title}
                    </h3>
                    {workshop.description && (
                      <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-3 max-w-xl">{workshop.description}</p>
                    )}
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                      {workshop.detail && <span class="text-xs text-slate-400 font-medium">{workshop.detail}</span>}
                      <a href="/contact" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary/80 transition-colors group/link">
                        Inscribirse
                        <PhArrowRight size={12} weight="light" class="transition-transform duration-200 group-hover/link:translate-x-0.5" />
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- CTA: Start a new group -->
    {cta && (
      <div class="p-6 md:p-8 rounded-xl bg-slate-50/80 border border-slate-100">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 border border-primary/10 flex items-center justify-center">
            <PhUsers size={20} weight="light" class="text-primary" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base font-medium text-slate-700 mb-1">{cta.title}</h3>
            {cta.body && <p class="text-slate-400 leading-relaxed text-sm mb-4">{cta.body}</p>}
            <div class="flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-deep transition-colors"
              >
                {cta.label ?? 'Proponer una actividad'}
                <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

  </div>
</ContentLayout>
