---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { 
  PhStudent, 
  PhCalendar, 
  PhGraduationCap, 
  PhTrendUp, 
  PhRocketLaunch,
  PhUsers,
  PhGlobe,
  PhMapPin,
  PhArrowRight,
  PhQuestion
} from 'phosphor-icons-astro';
import { requestWithMetadata } from '@tinacms/astro/data';
import { tinaField } from '@tinacms/astro/tina-field';
import { client } from '../../../tina/__generated__/client';
const enriched = await requestWithMetadata(
  client.queries.pageHistory({ relativePath: 'program-history.md' })
);
const pageData = enriched.data.pageHistory;
const { title, items = [], stats = [] } = pageData;
const body = pageData.body ?? "";

const pageTitle = title ?? "Historia del Programa";
const introText = body || "El programa de Comunicación Social en el Núcleo Universitario Rafael Rangel (NURR) de la Universidad de los Andes fue creado con el propósito de formar profesionales de la comunicación en la región andina venezolana, respondiendo a las necesidades de desarrollo cultural y comunicacional del estado Trujillo y sus alrededores.";

// Timeline supports dynamic number of items from CMS
// Icons cycle through the set; first item always marked as critical (origin)
const timelineIcons = [PhRocketLaunch, PhGraduationCap, PhGlobe, PhTrendUp];
const timeline = items.map((item, i) => ({
  icon: timelineIcons[i % timelineIcons.length],
  year: item.detail ?? item.title ?? "",
  title: item.title,
  description: item.description ?? "",
  emphasis: (i === 0 ? "critical" : "standard") as "critical" | "standard",
}));

const displayStats = stats.length ? stats : [
  { value: "20+", label: "Años de historia" },
  { value: "500+", label: "Graduados" },
  { value: "15+", label: "Convenios" },
  { value: "8", label: "Líneas de investigación" },
];

const breadcrumb = [
  { label: "Programa", href: "/program" }
];
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb} sectionTheme="academic" data-tina-field={tinaField(pageData, "title")}>
  <div class="py-8 md:py-12">
    <!-- Intro -->
    <div class="mb-10 md:mb-14 max-w-2xl reveal-intro">
      <p class="text-slate-500 leading-relaxed text-lg" data-tina-field={tinaField(pageData, "body")}>
        {introText}
      </p>
    </div>

    <!-- Timeline Header -->
    <div class="flex items-center gap-4 mb-12">
      <span class="block w-8 h-px bg-primary/40"></span>
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-slate-900">Línea de Tiempo</h2>
    </div>

    <!-- Steps Timeline -->
    <div class="relative">
      <!-- Vertical timeline line -->
      <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-200 md:left-0" />

      {
        timeline.map((item, index) => {
          const isCritical = item.emphasis === "critical";
          const isLast = index === timeline.length - 1;
          const Icon = item.icon;
          return (
            <article
              class:list={[
                "step-row group relative pl-8 md:pl-12",
                isCritical ? "step-row--critical" : "",
                isLast ? "" : "mb-0",
              ]}
            >
              {/* Timeline dot */}
              <div
                class:list={[
                  "step-dot absolute left-[-5px] top-10 w-2.5 h-2.5 rounded-full border-2 border-surface bg-slate-300 transition-all duration-300",
                  isCritical ? "step-dot--critical" : "",
                ]}
              />

              <div
                class:list={[
                  "step-content relative",
                  isCritical ? "step-content--critical" : "",
                ]}
              >
                {/* Step number — subtle, solid color, no gradient */}
                <div class="absolute right-4 md:right-8 top-6 pointer-events-none select-none">
                  <span
                    class:list={[
                      "step-bg-number text-6xl md:text-8xl font-bold font-body leading-none",
                      isCritical
                        ? "text-primary/10"
                        : "text-slate-200/60",
                    ]}
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                {/* Era label for critical items */}
                {isCritical && (
                  <div class="step-phase-label mb-3">
                    <span class="inline-block text-[10px] font-mono tracking-widest uppercase text-primary bg-primary/5 px-3 py-1 rounded-full">
                      {index === 0 ? "Origen" : "Período actual"}
                    </span>
                  </div>
                )}

                <div class="flex flex-col md:flex-row md:items-start md:justify-between md:gap-8">
                  {/* Content */}
                  <div class="flex-1 mb-3 md:mb-0 pr-16 md:pr-24">
                    <div class="flex items-center gap-3 mb-2">
                      <Icon size={20} weight="duotone" class="text-primary/60" />
                      <h2
                        class:list={[
                          "step-title text-lg md:text-xl font-medium tracking-tight",
                          isCritical
                            ? "text-slate-900"
                            : "text-slate-700",
                        ]}
                        data-tina-field={tinaField(items[index], "title")}
                      >
                        {item.title}
                      </h2>
                    </div>
                    <p
                      class:list={[
                        "step-desc leading-relaxed max-w-xl",
                        isCritical
                          ? "text-slate-500"
                          : "text-slate-400",
                      ]}
                      data-tina-field={tinaField(items[index], "description")}
                    >
                      {item.description}
                    </p>
                  </div>

                  {/* Year — Monospace Label */}
                  <div class="flex-shrink-0 self-start text-right">
                    <div
                      class:list={[
                        "step-date-line w-6 h-px ml-auto mb-1.5",
                        isCritical
                          ? "bg-primary/30"
                          : "bg-slate-200",
                      ]}
                    />
                    <p
                      class:list={[
                        "step-date-text text-[10px] font-mono tracking-wider uppercase",
                        isCritical
                          ? "text-primary/60"
                          : "text-slate-300",
                      ]}
                      data-tina-field={tinaField(items[index], "detail")}
                    >
                      {item.year}
                    </p>
                  </div>
                </div>
              </div>

              {/* Separator line between steps */}
              {!isLast && (
                <div class="step-separator ml-1.5 mt-6 mb-6 md:mt-8 md:mb-8">
                  <div class="h-px bg-slate-100" />
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <!-- Impact Stats -->
    <div class="mt-16">
      <div class="flex items-center gap-4 mb-8">
        <span class="block w-8 h-px bg-primary/40"></span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-slate-900">Impacto</h2>
      </div>

      <div class="p-8 md:p-10 bg-primary/5 rounded-luma border border-primary/10">
        <div class="flex items-center gap-4 mb-8">
          <PhStudent size={28} weight="duotone" class="text-primary" />
          <div>
            <h3 class="text-xl md:text-2xl font-display font-bold text-slate-900">Más de 20 años de trayectoria</h3>
            <p class="text-sm text-slate-500">Formando comunicadores para Venezuela</p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          {displayStats.map(stat => (
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-display font-bold text-primary mb-1" data-tina-field={tinaField(stat, "value")}>{stat.value}</div>
              <div class="text-xs md:text-sm text-slate-500 font-medium" data-tina-field={tinaField(stat, "label")}>{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Contextual Help -->
    <div class="mt-10 md:mt-14 p-6 md:p-8 rounded-xl bg-slate-50/80 border border-slate-100">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 border border-primary/10 flex items-center justify-center">
          <PhQuestion size={20} weight="light" class="text-primary" />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-medium text-slate-700 mb-1">
            ¿Quieres conocer más sobre el programa?
          </h3>
          <p class="text-slate-400 leading-relaxed text-sm mb-4">
            Explora otras secciones para conocer a nuestro equipo docente, las autoridades del programa y el perfil de nuestros egresados.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/program/faculty"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-deep transition-colors"
            >
              Faculty
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
            <span class="text-slate-300">|</span>
            <a
              href="/program/authorities"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition-colors"
            >
              Autoridades
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
            <span class="text-slate-300">|</span>
            <a
              href="/program/graduate-profile"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition-colors"
            >
              Perfil del Egresado
              <PhArrowRight size={14} weight="light" class="transition-transform duration-200 hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>

<style>
  /* ============================================================
     Scroll Reveal Animations
     ============================================================ */

  .reveal-intro,
  .step-row {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-intro.is-visible,
  .step-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for step rows */
  .step-row:nth-child(1) {
    transition-delay: 0ms;
  }
  .step-row:nth-child(2) {
    transition-delay: 80ms;
  }
  .step-row:nth-child(3) {
    transition-delay: 160ms;
  }
  .step-row:nth-child(4) {
    transition-delay: 240ms;
  }

  /* ============================================================
     Step Row Layout
     ============================================================ */

  .step-row {
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Subtle hover: background tint only, no layout shift */
  .step-row:hover {
    background-color: rgba(248, 250, 252, 0.4);
    border-radius: 6px;
  }

  .step-row .step-title {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-title {
    color: var(--color-primary);
  }

  .step-row .step-desc {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-desc {
    color: #94a3b8;
  }

  .step-row .step-bg-number {
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-row:hover .step-bg-number {
    opacity: 0.15;
    transform: scale(1.03);
  }

  .step-row .step-date-line {
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .step-row:hover .step-date-line {
    width: 16px;
    background-color: var(--color-primary);
  }

  .step-row .step-date-text {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-date-text {
    color: var(--color-primary);
  }

  /* ============================================================
     Critical Step Emphasis
     ============================================================ */

  .step-row--critical {
    padding: 1.5rem 1rem;
    margin: 0 -1rem;
    background-color: rgba(0, 93, 170, 0.02);
    border-radius: 8px;
    border-left: 2px solid var(--color-primary);
  }

  .step-row--critical:hover {
    background-color: rgba(0, 93, 170, 0.04);
  }

  .step-dot--critical {
    background-color: var(--color-primary) !important;
    border-color: var(--color-surface) !important;
    box-shadow: 0 0 0 3px rgba(0, 93, 170, 0.15);
  }

  .step-content--critical {
    padding-left: 0.5rem;
  }

  /* ============================================================
     Reduced Motion
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .reveal-intro,
    .step-row {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .step-row:hover {
      background-color: transparent;
    }

    .step-row .step-title,
    .step-row .step-desc,
    .step-row .step-bg-number,
    .step-row .step-date-line,
    .step-row .step-date-text {
      transition: none;
    }

    .step-row:hover .step-bg-number {
      opacity: 0.05;
      transform: none;
    }
  }
</style>

<script>
  // ============================================================
  // Scroll-triggered reveal animations
  // ============================================================
  function initRevealAnimations() {
    const revealElements = document.querySelectorAll(
      ".reveal-intro, .step-row"
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  }

  // Run on full page load
  document.addEventListener("DOMContentLoaded", () => {
    initRevealAnimations();
  });

  // Run on Astro client-side navigation
  document.addEventListener("astro:page-load", () => {
    initRevealAnimations();
  });
</script>
