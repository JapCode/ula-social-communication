---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'program-mission');
const { title, headings = [], items = [] } = pageEntry?.data ?? {};

const pageTitle = title ?? "Misión y Visión";
const missionHeading = headings[0] ?? { title: "Misión", description: "", eyebrow: "Propósito" };
const visionHeading = headings[1] ?? { title: "Visión", description: "", eyebrow: "Aspiración" };
const values = items;

const breadcrumb = [
  { label: "Programa", href: "/program" }
];
const missionText = missionHeading.description || "Formar profesionales de la comunicación social con excelencia académica, compromiso ético y sensibilidad social, capaces de investigar, producir y gestionar mensajes comunicacionales en diversos contextos mediáticos, contribuyendo al desarrollo integral de la región andina venezolana.";
const visionText = visionHeading.description || "Ser un programa de referencia nacional en la formación de comunicadores sociales, reconocido por su producción académica, su vinculación con la comunidad y su contribución al democratización de la comunicación en el estado Trujillo y la región andina.";
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb} sectionTheme="academic">
  <div>

    <!-- Misión — foundation, subtle background -->
    <div class="p-8 md:p-10 bg-primary/5 rounded-luma mb-8">
      <span class="inline-block text-[10px] md:text-[11px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-2">
        {missionHeading.eyebrow || "Propósito"}
      </span>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-ink tracking-tight mb-5 leading-[1.1]">
        {missionHeading.title}
      </h2>
      <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-prose">
        {missionText}
      </p>
    </div>

    <!-- Visión — plain, forward-looking -->
    <div class="mb-20">
      <span class="inline-block text-[10px] md:text-[11px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-2">
        {visionHeading.eyebrow || "Aspiración"}
      </span>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-ink tracking-tight mb-5 leading-[1.1]">
        {visionHeading.title}
      </h2>
      <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-prose">
        {visionText}
      </p>
    </div>

    <!-- Valores Institucionales — left-accent list, numbered -->
    <div>
      <div class="flex items-center gap-4 mb-12">
        <span class="block w-8 h-px bg-primary/40"></span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-slate-900">
          Valores Institucionales
        </h2>
      </div>

      <div class="space-y-8">
        {values.map((value, i) => (
          <div class="flex items-start gap-6 pl-6 border-l-2 border-primary/20 hover:border-primary transition-colors duration-300">
            <span class="text-xs font-mono font-bold text-slate-300 tabular-nums mt-0.5">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-display font-bold text-slate-900 tracking-tight mb-1">
                {value.title}
              </h3>
              <p class="text-sm text-slate-500 leading-relaxed">
                {value.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</ContentLayout>
