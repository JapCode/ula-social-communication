---
import ContentLayout from '@/layouts/ContentLayout.astro';
import StaffCard from '@/components/StaffCard.astro';
import { PhBuildingOffice, PhClock, PhMapPin, PhEnvelope, PhPhone } from 'phosphor-icons-astro';
import { getCollection } from 'astro:content';

const pageTitle = "Autoridades";
const breadcrumb = [
  { label: "Programa", href: "/program" }
];

const staff = await getCollection('staff');

// Separate director (featured) from supporting staff
const director = staff.find(s => s.data.department === 'Dirección');
const supportingStaff = staff.filter(s => s.data.department !== 'Dirección');
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb} sectionTheme="academic">

  <!-- Introductory context -->
  <p class="text-base md:text-lg text-slate-500 leading-relaxed max-w-2xl mb-12">
    Conoce al equipo directivo que guía la Escuela de Comunicación Social del Núcleo Universitario Rafael Rangel.
  </p>

  <!-- Empty state -->
  {staff.length === 0 && (
    <div class="text-center py-16">
      <PhBuildingOffice size={40} weight="light" class="text-slate-300 mx-auto mb-4" />
      <h3 class="text-lg font-bold text-slate-900 mb-2">Sin autoridades registradas</h3>
      <p class="text-sm text-slate-400 max-w-sm mx-auto">
        Aún no se ha registrado información sobre el equipo directivo. Contacta a secretaría para más detalles.
      </p>
    </div>
  )}

  {staff.length > 0 && (
    <>
      <!-- Featured Director -->
      {director && (
        <div class="mb-10">
          <span class="inline-block text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400 mb-4">
            Dirección
          </span>
          <StaffCard
            name={director.data.name}
            role={director.data.role}
            department={director.data.department}
            email={director.data.email}
            phone={director.data.phone}
            photo={director.data.photo}
            featured
          />
        </div>
      )}

      <!-- Supporting Staff Grid -->
      {supportingStaff.length > 0 && (
        <div>
          <span class="inline-block text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400 mb-4">
            Equipo Directivo
          </span>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {supportingStaff.map(person => (
              <StaffCard
                name={person.data.name}
                role={person.data.role}
                department={person.data.department}
                email={person.data.email}
                phone={person.data.phone}
                photo={person.data.photo}
              />
            ))}
          </div>
        </div>
      )}

      <!-- Contact / Office Hours -->
      <div class="mt-14 p-6 md:p-8 bg-surface-elevated border border-tinted rounded-luma">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <PhClock size={20} weight="light" class="text-primary" />
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900 mb-1">Horario de Atención</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Lunes a viernes: 8:00 AM — 4:00 PM
            </p>
            <div class="flex flex-col gap-1.5 mt-3">
              <span class="inline-flex items-center gap-2 text-xs text-slate-400">
                <PhMapPin size={14} weight="light" />
                Núcleo Universitario Rafael Rangel, Trujillo, Venezuela
              </span>
              {director && director.data.email && (
                <a href={`mailto:${director.data.email}`} class="inline-flex items-center gap-2 text-xs text-slate-400 hover:text-primary transition-colors" aria-label={`Enviar correo a dirección: ${director.data.email}`}>
                  <PhEnvelope size={14} weight="light" />
                  {director.data.email}
                </a>
              )}
              {director && director.data.phone && (
                <span class="inline-flex items-center gap-2 text-xs text-slate-400">
                  <PhPhone size={14} weight="light" />
                  {director.data.phone}
                </span>
              )}
            </div>
          </div>
        </div>
      </div>
    </>
  )}
</ContentLayout>
