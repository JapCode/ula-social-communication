---
import ContentLayout from '@/layouts/ContentLayout.astro';
import {
  PhPencilSimple,
  PhMegaphone,
  PhVideo,
  PhGlobe,
  PhTrendUp,
  PhCamera,
  PhMicrophone,
  PhNewspaperClipping,
  PhUsers,
  PhChatText,
  PhPresentationChart,
  PhBookOpen,
  PhBroadcast,
  PhDeviceMobile,
  PhMagnifyingGlass,
  PhLightbulb,
  PhStar,
  PhArrowRight,
} from 'phosphor-icons-astro';
import { requestWithMetadata } from '@tinacms/astro/data';
import { tinaField } from '@tinacms/astro/tina-field';
import { client } from '../../../tina/__generated__/client';
const enriched = await requestWithMetadata(
  client.queries.pageGraduateProfile({ relativePath: 'program-graduate-profile.md' })
);
const pageData = enriched.data.pageGraduateProfile;
const { title, items = [], headings = [] } = pageData;
const body = pageData.body ?? "";

const pageTitle = title ?? "Perfil del Egresado";
const introText = body || "Formamos comunicadores capaces de interpretar la realidad, construir narrativas y transformar la sociedad a través de la palabra, la imagen y el pensamiento crítico.";

// Icon map: each competence selects its icon in the CMS
const iconMap: Record<string, typeof PhPencilSimple> = {
  pencil: PhPencilSimple,
  megaphone: PhMegaphone,
  video: PhVideo,
  globe: PhGlobe,
  trend: PhTrendUp,
  camera: PhCamera,
  microphone: PhMicrophone,
  newspaper: PhNewspaperClipping,
  users: PhUsers,
  chat: PhChatText,
  presentation: PhPresentationChart,
  book: PhBookOpen,
  broadcast: PhBroadcast,
  cellphone: PhDeviceMobile,
  search: PhMagnifyingGlass,
  lightbulb: PhLightbulb,
  star: PhStar,
};

const competencias = items.map((item, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: item.title ?? "",
  description: item.description ?? "",
  Icon: iconMap[item.icon] || PhStar,
}));

// Fields from headings
const primariosHeading = headings[0];
const secundariosHeading = headings[1];
const camposPrimarios = primariosHeading?.items ?? [];
const camposSecundarios = secundariosHeading?.items ?? [];

const breadcrumb = [
  { label: "Programa", href: "/program" }
];
---

<ContentLayout title={pageTitle} breadcrumb={breadcrumb} sectionTheme="academic" data-tina-field={tinaField(pageData, "title")}>
  <section class="graduate-profile-page">

    <!-- Aspirational opening -->
    <div class="gp-opening">
      <div class="gp-opening__accent" aria-hidden="true">
        <span class="gp-opening__line"></span>
      </div>
      <p class="gp-opening__text" data-tina-field={tinaField(pageData, "body")}>
        {introText}
      </p>
    </div>

    <!-- Competencies — editorial numbered list, not cards -->
    <div class="gp-competencies">
      <div class="gp-section-header">
        <span class="gp-section-header__line"></span>
        <span class="gp-section-header__eyebrow">Formación</span>
      </div>
      <h2 class="gp-section-title">Competencias del Egresado</h2>
      <p class="gp-section-intro">
        Al finalizar sus estudios, el Licenciado en Comunicación Social de la ULA NURR habrá desarrollado las siguientes competencias profesionales:
      </p>

      <div class="gp-competencies__list">
        {competencias.map((comp, i) => (
          <div class:list={["gp-competency", i === 0 ? "gp-competency--featured" : ""]}>
            <div class="gp-competency__number">{comp.number}</div>
            <div class="gp-competency__content">
              <div class="gp-competency__header">
                <comp.Icon size={i === 0 ? 22 : 18} weight={i === 0 ? "duotone" : "light"} class="gp-competency__icon" />
                <h3 class="gp-competency__title" data-tina-field={tinaField(items[i], "title")}>{comp.title}</h3>
              </div>
              <p class="gp-competency__desc" data-tina-field={tinaField(items[i], "description")}>{comp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Professional fields — grouped hierarchy -->
    <div class="gp-fields">
      <div class="gp-section-header">
        <span class="gp-section-header__line"></span>
        <span class="gp-section-header__eyebrow">Trayectoria</span>
      </div>
      <h2 class="gp-section-title">Campos de Acción Profesional</h2>
      <p class="gp-section-intro">
        Nuestros egresados se desempeñan en una amplia variedad de entornos profesionales:
      </p>

      <div class="gp-fields__grid">
        <div class="gp-fields__group gp-fields__group--primary">
          <h3 class="gp-fields__group-title" data-tina-field={tinaField(primariosHeading, "title")}>{primariosHeading?.title || "Áreas Principales"}</h3>
          <div class="gp-fields__items">
            {camposPrimarios.map((field, i) => (
              <div class="gp-field gp-field--primary" data-tina-field={tinaField(primariosHeading, "items", i)}>
                <span class="gp-field__dot"></span>
                {field}
              </div>
            ))}
          </div>
        </div>
        <div class="gp-fields__group gp-fields__group--secondary">
          <h3 class="gp-fields__group-title" data-tina-field={tinaField(secundariosHeading, "title")}>{secundariosHeading?.title || "Áreas Complementarias"}</h3>
          <div class="gp-fields__items">
            {camposSecundarios.map((field, i) => (
              <div class="gp-field gp-field--secondary" data-tina-field={tinaField(secundariosHeading, "items", i)}>
                <span class="gp-field__dot"></span>
                {field}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Closing CTA -->
    <div class="gp-cta">
      <div class="gp-cta__content">
        <h3 class="gp-cta__title">¿Listo para comenzar?</h3>
        <p class="gp-cta__text">
          Conoce el proceso de inscripción y da el primer paso hacia tu carrera en Comunicación Social.
        </p>
        <a href="/admission/process" class="gp-cta__button">
          Cómo Inscribirse
          <PhArrowRight size={16} weight="regular" class="gp-cta__icon" />
        </a>
      </div>
    </div>

  </section>
</ContentLayout>

<style>
  /* ============================================================
     Graduate Profile — Editorial Layout
     ============================================================ */

  .graduate-profile-page {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .graduate-profile-page {
      gap: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .graduate-profile-page {
      gap: 6rem;
    }
  }

  /* --- Opening --- */
  .gp-opening {
    position: relative;
    padding-left: 1.5rem;
  }

  .gp-opening__accent {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.15));
    border-radius: 2px;
  }

  .gp-opening__text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    font-weight: 400;
    max-width: 48rem;
    margin: 0;
  }

  /* --- Section headers --- */
  .gp-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .gp-section-header__line {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.4;
  }

  .gp-section-header__eyebrow {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .gp-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .gp-section-intro {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin: 0 0 2.5rem;
    max-width: 40rem;
  }

  /* --- Competencies --- */
  .gp-competencies__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gp-competency {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
    transition: background 0.25s ease;
  }

  .gp-competency:first-child {
    padding-top: 0;
  }

  .gp-competency:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .gp-competency--featured {
    padding: 1.75rem 0;
  }

  .gp-competency--featured .gp-competency__title {
    font-size: 1.125rem;
  }

  .gp-competency__number {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.5;
    line-height: 1.5;
    padding-top: 0.125rem;
  }

  .gp-competency__content {
    min-width: 0;
  }

  .gp-competency__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
  }

  .gp-competency__icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .gp-competency__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .gp-competency__desc {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 36rem;
  }

  /* --- Fields --- */
  .gp-fields__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .gp-fields__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .gp-fields__group-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin: 0 0 1rem;
  }

  .gp-fields__items {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .gp-field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .gp-field__dot {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .gp-field--primary {
    color: var(--color-ink);
    font-weight: 500;
  }

  .gp-field--primary .gp-field__dot {
    background: var(--color-primary);
  }

  .gp-field--secondary {
    color: var(--color-ink-muted);
  }

  .gp-field--secondary .gp-field__dot {
    background: var(--color-primary);
    opacity: 0.35;
  }

  /* --- CTA --- */
  .gp-cta {
    position: relative;
    background: var(--color-primary);
    border-radius: var(--radius-luma);
    padding: 2.5rem 2rem;
    overflow: hidden;
  }

  .gp-cta::before {
    content: '';
    position: absolute;
    right: -3rem;
    top: -3rem;
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .gp-cta::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2rem;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .gp-cta__content {
    position: relative;
    z-index: 1;
    max-width: 32rem;
  }

  .gp-cta__title {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .gp-cta__text {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.65;
    margin: 0 0 1.5rem;
  }

  .gp-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #ffffff;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .gp-cta__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .gp-cta__button:active {
    transform: translateY(0);
  }

  .gp-cta__icon {
    transition: transform 0.3s ease;
  }

  .gp-cta__button:hover .gp-cta__icon {
    transform: translateX(3px);
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .gp-cta {
      padding: 2rem 1.5rem;
    }

    .gp-competency {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
      padding: 1.25rem 0;
    }
  }
</style>
