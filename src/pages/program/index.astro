---
import ContentLayout from '@/layouts/ContentLayout.astro';
import ContentBlock from '@/components/ContentBlock.astro';
import SectionCard from '@/components/SectionCard.astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'program-index');
const { title, subtitle, items = [] } = pageEntry?.data ?? {};
const body = pageEntry?.data?.body ?? pageEntry?.body ?? "";

const pageTitle = title ?? "Nuestro Programa";
const pageSubtitle = subtitle ?? "Conoce la identidad, misión y personas que hacen posible la Comunicación Social en el NURR";
---

<ContentLayout title={pageTitle} subtitle={pageSubtitle} eyebrow="Institucionalidad" sectionTheme="academic">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {items.slice(0, 6).map(item => (
      <SectionCard 
        title={item.title ?? ""}
        description={item.description ?? ""}
        icon="eye"
        href={item.href ?? "#"}
      />
    ))}
  </div>
  
  <div class="mt-16">
    <ContentBlock title="Sobre el Programa" eyebrow="Información">
      <p class="text-slate-500 leading-relaxed">
        {body || "La carrera de Comunicación Social en el Núcleo Universitario Rafael Rangel (NURR) de la Universidad de los Andes forma profesionales integrales capaces de analizar, producir y gestionar mensajes comunicacionales en diversos medios y plataformas digitales."}
      </p>
    </ContentBlock>
  </div>
</ContentLayout>
