<section
	class="layered-card z-20 news-section"
	id="noticias"
	aria-labelledby="news-title"
>
	<div class="card-content bg-white">
		<div class="relative w-full flex flex-col md:flex-row">
			<!-- Image side (60%) -->
			<div
				class="relative w-full md:w-[60%] min-h-[250px] md:min-h-[550px] overflow-hidden"
			>
				<div class="news-image-container absolute inset-0">
					<img
						alt="Showcase - Estudiantes de Comunicación Social en actividad académica"
						class="w-full h-full object-cover"
						src="/images/brooke-cagle-g1Kr4Ozfoac-unsplash.jpg "
						loading="lazy"
						width="800"
						height="600"
					/>
				</div>
				<!-- Gradient overlay: white on right side to blend with text area -->
				<div
					class="absolute inset-0 bg-gradient-to-t from-white/80 via-white/20 to-transparent md:bg-gradient-to-l md:from-white/60 md:via-white/20 md:to-transparent"
				>
				</div>
				<!-- Floating tag -->
				<div class="absolute top-6 left-6 md:top-8 md:left-8 z-10">
					<span
						class="inline-flex items-center gap-1.5 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase text-primary border border-primary/10"
					>
						<span
							class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
						></span>
						Actualidad
					</span>
				</div>
			</div>

			<!-- Text side (40%) -->
			<div
				class="w-full md:w-[40%] p-6 md:p-10 lg:p-14 flex flex-col justify-center relative"
			>
				<!-- Accent border -->
				<div
					class="absolute left-0 top-1/4 bottom-1/4 w-px bg-gradient-to-b from-transparent via-primary/30 to-transparent hidden md:block"
				>
				</div>

				<div class="md:pl-8 lg:pl-10 space-y-5" data-line-stagger="0.1">
					<span
						class="reveal-slide text-[10px] font-bold tracking-[0.4em] uppercase text-ink-faint block"
						>Investigación</span
					>
					<h2
						id="news-title"
						class="reveal-slide text-2xl md:text-3xl lg:text-4xl font-display font-semibold tracking-tight text-wrap balance leading-tight"
					>
						Nuevas narrativas transmedia en el entorno digital
					</h2>
					<p
						class="reveal-slide text-sm md:text-base text-ink-muted font-normal leading-relaxed"
					>
						Un recorrido por las últimas investigaciones de nuestra
						facultad sobre el impacto de la tecnología en el
						periodismo moderno.
					</p>
					<div class="reveal-slide pt-2">
						<a
							href="#"
							class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-deep transition-colors duration-300 group focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
						>
							Leer artículo
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
								<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Bottom accent line -->
		<div class="h-[3px] w-full bg-black/[0.03] relative overflow-hidden">
			<div
				class="reveal-scale h-full bg-gradient-to-r from-primary to-primary-light w-1/3 progress-glow"
			>
			</div>
		</div>
	</div>
</section>
