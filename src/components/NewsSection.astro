---
import type { InferEntrySchema } from "astro:content";
import { PhArrowRight } from "phosphor-icons-astro";

export interface Props {
  news: InferEntrySchema<"pages">["news"];
}

const { news } = Astro.props;

// Normalize image paths from Decap CMS
function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

/**
 * Converts a date string (YYYY-MM-DD) to a relative time string in Spanish.
 * Calculated at build time — best for static sites with regular deploys.
 */
function timeAgo(dateStr: string): string {
  const date = new Date(dateStr + "T00:00:00");
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffDays < 0) return "Próximamente";
  if (diffDays === 0) return "Hoy";
  if (diffDays === 1) return "Ayer";
  if (diffDays < 7) return `Hace ${diffDays} días`;
  if (diffDays < 30) {
    const weeks = Math.floor(diffDays / 7);
    return `Hace ${weeks} ${weeks === 1 ? "semana" : "semanas"}`;
  }
  if (diffDays < 365) {
    const months = Math.floor(diffDays / 30);
    return `Hace ${months} ${months === 1 ? "mes" : "meses"}`;
  }
  const years = Math.floor(diffDays / 365);
  return `Hace ${years} ${years === 1 ? "año" : "años"}`;
}
---

<!-- News section — split card layout with image -->
<section class="news-section" id="noticias" aria-labelledby="news-title">
	<div class="news-container">
		<div class="news-card">
			<!-- Image side -->
			<div class="news-card-image">
				<img
					alt={news.image_alt}
					src={normalizeImagePath(news.image) ?? ''}
					loading="lazy"
					width="800"
					height="600"
				/>
			</div>

			<!-- Text side -->
			<div class="news-card-content">
				<!-- Tag -->
				<span class="news-tag">{news.tag}</span>

				<!-- Category -->
				<span
					class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 block"
				>
					{news.category}
				</span>

				<!-- Title — editorial headline -->
				<h2
					id="news-title"
					class="text-2xl md:text-4xl font-display font-bold text-ink tracking-tight text-wrap balance leading-[1.05]"
				>
					{news.title}
				</h2>

				<!-- Description -->
				<p
					class="text-sm md:text-base text-slate-500 font-normal leading-relaxed"
				>
					{news.description}
				</p>

				<!-- Link -->
				<div class="pt-2">
					<a
						href={news.link_href}
						class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-deep transition-colors duration-300 group"
					>
						<span>{news.link_text}</span>
						<PhArrowRight
							size={16}
							weight="regular"
							class="transition-transform duration-300 group-hover:translate-x-1"
							aria-hidden="true"
						/>
					</a>
				</div>
			</div>
		</div>

		<!-- Secondary articles -->
		<div class="news-secondary">
			{news.secondary.map((item) => (
				<a href={item.href} class="news-secondary-item group">
					<span class="text-[9px] font-bold tracking-[0.25em] uppercase text-primary/70 block mb-2">{item.category}</span>
					<h3 class="text-base md:text-lg font-display font-bold text-ink group-hover:text-primary transition-colors duration-300 leading-snug tracking-tight">
						{item.title}
					</h3>
					<time class="text-xs text-slate-400 mt-1 block" datetime={item.date}>{timeAgo(item.date)}</time>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.news-section {
		padding: 5rem 2rem;
	}

	.news-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Simple text label instead of pill badge */
	.news-tag {
		display: inline-block;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-primary);
		padding-left: 0.75rem;
		border-left: 2px solid var(--color-primary);
		line-height: 1.4;
	}

	/* Main card — split layout */
	.news-card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface-elevated);
		border-radius: var(--radius-luma);
		overflow: hidden;
		box-shadow: var(--shadow-luma);
	}

	@media (min-width: 768px) {
		.news-card {
			flex-direction: row;
		}
	}

	.news-card-image {
		flex: 0 0 100%;
		overflow: hidden;
	}

	@media (max-width: 767px) {
		.news-card-image {
			aspect-ratio: 16 / 9;
			max-height: 200px;
		}
	}

	@media (min-width: 768px) {
		.news-card-image {
			flex: 0 0 55%;
			min-height: 400px;
		}
	}

	@media (min-width: 1024px) {
		.news-card-image {
			min-height: 500px;
		}
	}

	.news-card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.news-card:hover .news-card-image img {
		transform: scale(1.03);
	}

	.news-card-content {
		flex: 1;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.25rem;
	}

	@media (min-width: 768px) {
		.news-card-content {
			padding: 2.5rem;
		}
	}

	@media (min-width: 1024px) {
		.news-card-content {
			padding: 3rem;
		}
	}

	/* Secondary articles */
	.news-secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-top: 2rem;
	}

	@media (min-width: 640px) {
		.news-secondary {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.news-secondary-item {
		padding: 1.5rem 1.5rem 1.5rem 0;
		border-right: 1px solid rgba(226, 232, 240, 0.6);
	}

	.news-secondary-item:first-child {
		padding-left: 0;
	}

	.news-secondary-item:last-child {
		border-right: none;
		padding-right: 0;
	}

	@media (max-width: 768px) {
		.news-section {
			padding: 4rem 1.5rem;
		}

		.news-secondary {
			grid-template-columns: 1fr;
			gap: 0;
			margin-top: 2.5rem;
			padding-top: 2rem;
			border-top: 2px solid rgba(226, 232, 240, 0.6);
		}

		.news-secondary::before {
			content: 'Más noticias';
			display: block;
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--color-primary);
			margin-bottom: 1rem;
		}

		.news-secondary-item {
			padding: 1rem 0;
			border-right: none;
			border-bottom: 1px solid rgba(226, 232, 240, 0.6);
		}

		.news-secondary-item:first-child {
			padding-top: 0;
		}

		.news-secondary-item:last-child {
			padding-bottom: 0;
			border-bottom: none;
		}
	}
</style>
