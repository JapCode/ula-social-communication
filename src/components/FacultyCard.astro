---
import { PhUser, PhEnvelope, PhGraduationCap } from 'phosphor-icons-astro';

interface Props {
  name: string;
  title: string;
  specialization: string;
  email?: string;
  bio?: string;
  status?: "active" | "retired";
}

const { name, title, specialization, email, bio, status = "active" } = Astro.props;
const isRetired = status === "retired";
---

<article class:list={[
  'faculty-card',
  isRetired && 'faculty-card--retired',
]} data-faculty-name={name.toLowerCase()} data-faculty-spec={specialization.toLowerCase()} data-faculty-title={title.toLowerCase()}>
  <div class="faculty-card__inner">
    <!-- Avatar -->
    <div class="faculty-card__avatar">
      <PhUser size={22} weight="light" class="faculty-card__avatar-icon" />
    </div>

    <!-- Info -->
    <div class="faculty-card__info">
      <div class="faculty-card__header">
        <h3 class="faculty-card__name">{name}</h3>
        {isRetired && (
          <span class="faculty-card__badge">Emérito</span>
        )}
      </div>
      <p class="faculty-card__title">{title}</p>

      <!-- Specialization tag -->
      <div class="faculty-card__spec">
        <PhGraduationCap size={12} weight="light" />
        <span>{specialization}</span>
      </div>

      <!-- Bio (clamped to 3 lines) -->
      {bio && (
        <p class="faculty-card__bio">{bio}</p>
      )}

      <!-- Contact (only for active faculty) -->
      {!isRetired && email && (
        <a
          href={`mailto:${email}`}
          class="faculty-card__email"
          aria-label={`Enviar correo a ${name}: ${email}`}
        >
          <PhEnvelope size={14} weight="light" />
          {email}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .faculty-card {
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .faculty-card:hover {
    box-shadow: var(--shadow-luma);
    transform: translateY(-2px);
  }

  .faculty-card--retired {
    opacity: 0.75;
    background: var(--color-surface);
  }

  .faculty-card--retired:hover {
    opacity: 1;
  }

  .faculty-card__inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
  }

  .faculty-card__avatar {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: rgba(0, 93, 170, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faculty-card__avatar-icon {
    color: var(--color-primary);
  }

  .faculty-card__info {
    min-width: 0;
    flex: 1;
  }

  .faculty-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .faculty-card__name {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0;
  }

  .faculty-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: rgba(226, 232, 240, 0.5);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .faculty-card__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }

  .faculty-card__spec {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: rgba(0, 93, 170, 0.06);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-ink-muted);
  }

  .faculty-card__bio {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0.625rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .faculty-card__email {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .faculty-card__email:hover {
    color: var(--color-primary);
  }
</style>
