---
import { tinaField } from "@tinacms/astro/tina-field";
import { getIcon } from "@/lib/phosphorIcons";
import { PhArrowRight } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'cards';
    heading?: string;
    cards: Array<{
      title: string;
      description?: string;
      href: string;
      icon?: string;
    }>;
  };
}

const { block } = Astro.props;

const cards = (block.cards || []).map(card => ({
  ...card,
  Icon: card.icon ? getIcon(card.icon) : null,
}));
---

{cards.length > 0 && (
  <section class="gp-cards">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-20 md:py-28 lg:py-32">
    {block.heading && (
      <div class="flex items-center gap-4 mb-10 md:mb-14">
        <span class="block w-8 h-px bg-primary/40" aria-hidden="true"></span>
        <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-slate-400" data-tina-field={tinaField(block, 'heading')}>
          {block.heading}
        </h2>
      </div>
    )}

    <div class="gp-cards__grid">
      {cards.map((card, i) => {
        const isFeatured = i === 0;
        const Tag = card.href ? 'a' : 'div';
        const linkProps = card.href ? { href: card.href } : {};
        return (
          <Tag
            key={i}
            {...linkProps}
            class="gp-cards__card"
            class:list={[
              "gp-cards__card group",
              isFeatured ? "gp-cards__card--featured" : "",
            ]}
            data-tina-field={tinaField(block, 'cards', i)}
          >
            {card.Icon && (
              <div class="gp-cards__icon" aria-hidden="true">
                <card.Icon size={isFeatured ? 24 : 18} weight="light" />
              </div>
            )}
            <div class="gp-cards__body">
              <h3 class="gp-cards__title" data-tina-field={tinaField(card, 'title')}>
                {card.title}
              </h3>
              {card.description && (
                <p class="gp-cards__desc" data-tina-field={tinaField(card, 'description')}>
                  {card.description}
                </p>
              )}
              {card.href && (
                <span class="gp-cards__link">
                  Explorar
                  <PhArrowRight size={12} weight="bold" class="gp-cards__arrow" />
                </span>
              )}
            </div>
          </Tag>
        );
      })}
    </div>
    </div>
  </section>
)}

<style>
  .gp-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(226, 232, 240, 0.5);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma, 12px);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .gp-cards__grid {
      grid-template-columns: 1fr 1fr;
    }
    .gp-cards__card--featured {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .gp-cards__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .gp-cards__card--featured {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
  }

  .gp-cards__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: #ffffff;
    transition: background 0.3s ease;
    text-decoration: none;
  }

  .gp-cards__card:hover {
    background: rgba(248, 250, 252, 0.8);
  }

  .gp-cards__card--featured {
    padding: 2rem;
  }

  @media (min-width: 1024px) {
    .gp-cards__card--featured {
      padding: 2.5rem;
    }
  }

  .gp-cards__icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary);
    color: #ffffff;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .gp-cards__card--featured .gp-cards__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
  }

  .gp-cards__card:hover .gp-cards__icon {
    transform: scale(1.06);
  }

  .gp-cards__body {
    min-width: 0;
  }

  .gp-cards__title {
    font-family: var(--font-display), Georgia, Times, serif;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--color-ink);
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .gp-cards__card--featured .gp-cards__title {
    font-size: 1.25rem;
  }

  .gp-cards__card:hover .gp-cards__title {
    color: var(--color-primary);
  }

  .gp-cards__desc {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.6;
  }

  .gp-cards__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .gp-cards__arrow {
    transition: transform 0.3s ease;
  }

  .gp-cards__card:hover .gp-cards__arrow {
    transform: translateX(3px);
  }
</style>
