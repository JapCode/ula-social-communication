---
import { tinaField } from "@tinacms/astro/tina-field";

export interface Props {
  block: {
    _template: 'stats';
    heading?: string;
    intro?: string;
    stats: Array<{ value: string; label: string }>;
  };
}

const { block } = Astro.props;
const statCount = block.stats?.length ?? 0;
---

{block.stats && block.stats.length > 0 && (
  <section class="gp-stats">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-24">
    {block.heading && (
      <h2 class="gp-stats__heading" data-tina-field={tinaField(block, 'heading')}>
        {block.heading}
      </h2>
    )}
    {block.intro && (
      <p class="gp-stats__intro" data-tina-field={tinaField(block, 'intro')}>
        {block.intro}
      </p>
    )}

    <div
      class="gp-stats__grid"
      style={{ "--stat-count": statCount } as any}
    >
      {block.stats.map((stat, i) => {
        const isLast = i === statCount - 1;
        return (
          <div
            class="gp-stats__item"
            class:list={[isLast ? "gp-stats__item--last" : ""]}
            data-tina-field={tinaField(block, 'stats', i)}
          >
            <span class="gp-stats__value" data-tina-field={tinaField(stat, 'value')}>
              {stat.value}
            </span>
            <span class="gp-stats__label" data-tina-field={tinaField(stat, 'label')}>
              {stat.label}
            </span>
          </div>
        );
      })}
    </div>
    </div>
  </section>
)}

<style>
  .gp-stats__heading {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink-faint, #94a3b8);
    margin: 0 0 0.5rem;
  }

  .gp-stats__intro {
    font-size: 0.9375rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.7;
    margin: 0 0 3rem;
    max-width: 36rem;
  }

  .gp-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2px;
    background: rgba(226, 232, 240, 0.4);
    border-radius: 16px;
    overflow: hidden;
  }

  .gp-stats__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 2.5rem 1.5rem;
    background: #ffffff;
  }

  .gp-stats__item::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 2rem;
    height: 3px;
    background: var(--color-primary);
    border-radius: 2px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gp-stats__item:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  .gp-stats__value {
    font-family: var(--font-display), Georgia, Times, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  .gp-stats__label {
    font-size: 0.8125rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.4;
    text-align: center;
    max-width: 12ch;
  }

  @media (max-width: 640px) {
    .gp-stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gp-stats__item {
      padding: 1.75rem 1rem;
    }
  }
</style>
