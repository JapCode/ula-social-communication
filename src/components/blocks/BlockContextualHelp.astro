---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhQuestion, PhArrowRight, PhBookOpen } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'contextualHelp';
    eyebrow?: string;
    heading?: string;
    body?: string;
    links: Array<{
      label: string;
      href: string;
    }>;
  };
}

const { block } = Astro.props;
const links = block.links || [];
---

{links.length > 0 && (
  <section class="gp-help">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-12 md:py-16">
      <div class="gp-help__card">
        <div class="gp-help__top">
          <div class="gp-help__icon" aria-hidden="true">
            <PhBookOpen size={20} weight="light" />
          </div>
          <div class="gp-help__header">
            {block.eyebrow && (
              <span class="gp-help__eyebrow" data-tina-field={tinaField(block, 'eyebrow')}>
                {block.eyebrow}
              </span>
            )}
            {block.heading && (
              <h3 class="gp-help__title" data-tina-field={tinaField(block, 'heading')}>
                {block.heading}
              </h3>
            )}
          </div>
        </div>

        {block.body && (
          <p class="gp-help__body" data-tina-field={tinaField(block, 'body')}>
            {block.body}
          </p>
        )}

        <nav class="gp-help__links" aria-label="Enlaces de ayuda">
          {links.map((link, i) => (
            <a
              key={i}
              href={link.href}
              class="gp-help__link"
              data-tina-field={tinaField(block, 'links', i)}
            >
              <span class="gp-help__link-text">{link.label}</span>
              <PhArrowRight size={14} weight="light" class="gp-help__link-arrow" />
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>
)}

<style>
  .gp-help__card {
    background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
    border: 1px solid rgba(226, 232, 240, 0.7);
    border-radius: 16px;
    padding: 1.75rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .gp-help__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.2));
    border-radius: 4px 0 0 4px;
  }

  .gp-help__top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .gp-help__icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary);
    color: #ffffff;
  }

  .gp-help__header {
    min-width: 0;
    padding-top: 0.125rem;
  }

  .gp-help__eyebrow {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.125rem;
  }

  .gp-help__title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--color-ink);
    line-height: 1.3;
    margin: 0;
  }

  .gp-help__body {
    font-size: 0.875rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.65;
    margin: 0 0 1.25rem 3.5rem;
  }

  .gp-help__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: 3.5rem;
  }

  .gp-help__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.6);
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-muted, #64748b);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .gp-help__link:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 93, 170, 0.15);
  }

  .gp-help__link-arrow {
    transition: transform 0.3s ease;
  }

  .gp-help__link:hover .gp-help__link-arrow {
    transform: translateX(2px);
  }

  @media (max-width: 640px) {
    .gp-help__body {
      margin-left: 0;
    }
    .gp-help__links {
      margin-left: 0;
    }
  }
</style>
