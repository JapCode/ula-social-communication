---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhFilePdf, PhDownloadSimple, PhFileText } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'files';
    heading?: string;
    files: Array<{ label: string; url: string }>;
  };
}

const { block } = Astro.props;
---

{block.files && block.files.length > 0 && (
  <section class="gp-files">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-20">
    {block.heading && (
      <div class="flex items-center gap-3 mb-8">
        <PhFileText size={16} weight="light" class="text-primary" />
        <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-slate-400" data-tina-field={tinaField(block, 'heading')}>
          {block.heading}
        </h2>
      </div>
    )}

    <div class="gp-files__grid">
      {block.files.map((file, i) => {
        const isPdf = file.url?.toLowerCase().endsWith('.pdf');
        const ext = isPdf ? 'PDF' : 'DOC';
        return (
          <a
            key={i}
            href={file.url}
            class="gp-files__item group"
            download
            data-tina-field={tinaField(block, 'files', i)}
          >
            <div class="gp-files__icon" aria-hidden="true">
              <PhFilePdf size={22} weight="light" />
            </div>
            <div class="gp-files__info">
              <span class="gp-files__name" data-tina-field={tinaField(file, 'label')}>
                {file.label}
              </span>
              <span class="gp-files__meta">
                <span class="gp-files__badge">{ext}</span>
                <span class="gp-files__action">Descargar</span>
              </span>
            </div>
            <PhDownloadSimple size={18} weight="light" class="gp-files__download" />
          </a>
        );
      })}
    </div>
    </div>
  </section>
)}

<style>
  .gp-files__grid {
    display: grid;
    gap: 0.75rem;
  }

  .gp-files__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.6);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
  }

  .gp-files__item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 3px;
    height: 60%;
    background: var(--color-primary);
    border-radius: 0 3px 3px 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gp-files__item:hover {
    border-color: rgba(0, 93, 170, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transform: translateX(3px);
  }

  .gp-files__item:hover::after {
    transform: translateY(-50%) scaleY(1);
  }

  .gp-files__icon {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: oklch(0.96 0.02 250);
    color: var(--color-primary);
    transition: background 0.3s ease;
  }

  .gp-files__item:hover .gp-files__icon {
    background: oklch(0.93 0.03 250);
  }

  .gp-files__info {
    flex: 1;
    min-width: 0;
  }

  .gp-files__name {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .gp-files__item:hover .gp-files__name {
    color: var(--color-primary);
  }

  .gp-files__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
  }

  .gp-files__badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: oklch(0.95 0.02 250);
    border-radius: 4px;
    line-height: 1.4;
  }

  .gp-files__action {
    font-size: 0.75rem;
    color: var(--color-ink-faint, #94a3b8);
    transition: color 0.3s ease;
  }

  .gp-files__item:hover .gp-files__action {
    color: var(--color-primary);
  }

  .gp-files__download {
    flex-shrink: 0;
    color: var(--color-ink-faint, #94a3b8);
    transition: all 0.3s ease;
  }

  .gp-files__item:hover .gp-files__download {
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .gp-files__item {
      padding: 0.875rem 1rem;
    }
  }
</style>
