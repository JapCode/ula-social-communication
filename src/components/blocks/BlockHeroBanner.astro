---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhArrowRight, PhArrowDown } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'heroBanner';
    titleLine1?: string;
    titleLine2?: string;
    title?: string;
    subtitle?: string;
    eyebrow?: string;
    description?: string;
    ctas?: Array<{ label: string; href: string; isPrimary?: boolean }>;
  };
}

const { block } = Astro.props;
const hasTwoLineTitle = block.titleLine1 && block.titleLine2;
---

{
  hasTwoLineTitle ? (
    <section class="hero-editorial relative" id="inicio" aria-labelledby="hero-title">
      <div class="relative z-10 min-h-[60vh] md:min-h-[80vh] lg:min-h-screen lg:max-h-[56rem] flex items-center justify-center xs:pt-16 pt-28 pb-6 lg:pt-20 lg:pb-0">
        <div class="w-full max-w-[1400px] mx-auto px-5 md:px-12 lg:px-16 relative">
          <div class="relative z-10 text-center max-w-2xl mx-auto">
            <div class="mb-6 md:mb-8 flex justify-center">
              <figure class="relative aspect-square h-[150px] w-[150px] min-w-fit overflow-hidden">
                <img src="/images/161618.png" alt="ULA NURR" class="absolute object-cover object-center inset-0 w-[200px] h-[200px]" />
              </figure>
            </div>
            {block.eyebrow && (
              <div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6 justify-center" data-tina-field={tinaField(block, 'eyebrow')}>
                <span class="block w-6 md:w-10 h-px bg-ink/30"></span>
                <span class="hero-eyebrow text-[9px] md:text-[10px] font-bold tracking-[0.35em] md:tracking-[0.4em] uppercase text-ink">{block.eyebrow}</span>
                <span class="block w-4 md:w-8 h-px bg-ink/30"></span>
              </div>
            )}
            <h1 id="hero-title" class="hero-title font-display font-black text-primary leading-[0.85] tracking-tighter uppercase mb-4 md:mb-6 text-center break-words max-w-full" style="font-size: clamp(1.8rem, 6vw, 5rem);" data-tina-field={tinaField(block, 'titleLine1')}>
              <span class="hero-title-line">{block.titleLine1}</span><br />
              <span class="hero-title-line text-primary">{block.titleLine2}</span>
            </h1>
            {block.description && <p class="hero-value-prop text-sm md:text-base lg:text-lg text-ink/80 mt-4 md:mt-6 max-w-prose mx-auto leading-relaxed font-body" data-tina-field={tinaField(block, 'description')}>{block.description}</p>}
            {block.ctas && block.ctas.length > 0 && (
              <div class="flex flex-col sm:flex-row items-center gap-3 md:gap-4 mt-6 md:mt-10 justify-center">
                {block.ctas.map((cta, i) => (
                  cta.isPrimary ? (
                    <a key={i} href={cta.href} class="hero-cta-primary xs:w-full sm:w-auto inline-flex items-center gap-2 px-8 py-4 bg-accent text-white text-sm font-bold tracking-widest uppercase rounded-none hover:bg-accent-hover transition-colors duration-300" data-tina-field={tinaField(block, 'ctas', i)}>
                      {cta.label} <PhArrowRight size={16} weight="bold" />
                    </a>
                  ) : (
                    <a key={i} href={cta.href} class="hero-cta-secondary xs:w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent border-2 border-primary text-primary text-sm font-bold tracking-widest uppercase hover:bg-primary hover:text-white transition-colors duration-300 rounded-none" data-tina-field={tinaField(block, 'ctas', i)}>
                      {cta.label}
                    </a>
                  )
                ))}
              </div>
            )}
            <div class="hidden lg:flex items-center gap-3 mt-12 lg:mt-16 text-ink-faint hero-scroll-indicator justify-center">
              <PhArrowDown size={14} weight="light" />
              <span class="text-[9px] font-bold tracking-[0.3em] uppercase">Explora</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative overflow-hidden bg-gradient-to-b from-surface to-white border-b border-tinted">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 pt-24 pb-10 md:pt-28 md:pb-14">
        {block.eyebrow && (
          <span class="inline-block text-[10px] md:text-[11px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-3" data-tina-field={tinaField(block, 'eyebrow')}>
            {block.eyebrow}
          </span>
        )}
        {block.title && (
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-ink leading-[1.05] tracking-tighter text-wrap balance" data-tina-field={tinaField(block, 'title')}>
            {block.title}
          </h1>
        )}
        {block.subtitle && (
          <p class="mt-3 text-sm md:text-base text-slate-500 max-w-2xl leading-relaxed" data-tina-field={tinaField(block, 'subtitle')}>
            {block.subtitle}
          </p>
        )}
        {block.description && (
          <p class="mt-4 text-slate-500 max-w-3xl leading-relaxed" data-tina-field={tinaField(block, 'description')}>
            {block.description}
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .hero-editorial {
    background-color: var(--color-surface-elevated);
    min-height: 100vh;
  }

  @media (max-width: 767px) {
    .hero-editorial {
      min-height: auto;
    }
  }

  @keyframes title-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-title-line {
    display: inline-block;
    animation: title-fade-up 0.7s linear both;
  }
  .hero-title-line:last-child {
    animation-delay: 0.25s;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.25; }
    50% { transform: translateY(6px); opacity: 0.6; }
  }
  .hero-scroll-indicator {
    animation: scroll-bounce 2.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes desc-fade {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-value-prop {
    animation: desc-fade 0.5s linear 0.15s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-editorial * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
