---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhEnvelopeSimple, PhPhone, PhMapPin, PhLightbulb } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'researchLines';
    lines?: Array<{ title: string; description?: string }>;
    thesis?: { title?: string; text?: string; note?: string };
    contact?: { name?: string; role?: string; email?: string; phone?: string; office?: string };
  };
}

const { block } = Astro.props;
const hasLines = block.lines && block.lines.length > 0;
const hasThesis = block.thesis?.title || block.thesis?.text;
const hasContact = block.contact?.name;
---

{(hasLines || hasThesis || hasContact) && (
  <section class="gp-research">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-24">

    {hasLines && (
      <div class="gp-research__lines">
        <div class="flex items-center gap-3 mb-8">
          <PhLightbulb size={16} weight="light" class="text-primary" />
          <h2 class="gp-research__section-title">Líneas de Investigación</h2>
        </div>
        <div class="gp-research__grid">
          {block.lines!.map((line, i) => (
            <article key={i} class="gp-research__card" data-tina-field={tinaField(block, 'lines', i)}>
              <div class="gp-research__card-number" aria-hidden="true">
                <span>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="gp-research__card-title" data-tina-field={tinaField(line, 'title')}>
                {line.title}
              </h3>
              {line.description && (
                <p class="gp-research__card-desc" data-tina-field={tinaField(line, 'description')}>
                  {line.description}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    )}

    {(hasThesis || hasContact) && (
      <div class="gp-research__bottom">
        {hasThesis && (
          <div class="gp-research__thesis" data-tina-field={tinaField(block, 'thesis')}>
            {block.thesis!.title && (
              <h3 class="gp-research__thesis-title" data-tina-field={tinaField(block.thesis, 'title')}>
                {block.thesis.title}
              </h3>
            )}
            {block.thesis!.text && (
              <p class="gp-research__thesis-text" data-tina-field={tinaField(block.thesis, 'text')}>
                {block.thesis.text}
              </p>
            )}
            {block.thesis!.note && (
              <div class="gp-research__thesis-note" data-tina-field={tinaField(block.thesis, 'note')}>
                {block.thesis.note}
              </div>
            )}
          </div>
        )}

        {hasContact && (
          <div class="gp-research__contact">
            <h3 class="gp-research__contact-title">Contacto de Investigación</h3>
            <div class="gp-research__contact-body">
              <p class="gp-research__contact-name" data-tina-field={tinaField(block.contact, 'name')}>{block.contact!.name}</p>
              {block.contact!.role && <p class="gp-research__contact-role" data-tina-field={tinaField(block.contact, 'role')}>{block.contact.role}</p>}
              {block.contact!.email && (
                <p><PhEnvelopeSimple size={13} weight="light" /><a href={`mailto:${block.contact.email}`} data-tina-field={tinaField(block.contact, 'email')}>{block.contact.email}</a></p>
              )}
              {block.contact!.phone && (
                <p><PhPhone size={13} weight="light" /><span data-tina-field={tinaField(block.contact, 'phone')}>{block.contact.phone}</span></p>
              )}
              {block.contact!.office && (
                <p><PhMapPin size={13} weight="light" /><span data-tina-field={tinaField(block.contact, 'office')}>{block.contact.office}</span></p>
              )}
            </div>
          </div>
        )}
      </div>
    )}
    </div>
  </section>
)}

<style>
  .gp-research__section-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink, #0f172a);
    margin: 0;
  }

  /* ── Research Lines Grid ── */
  .gp-research__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(226, 232, 240, 0.3);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.3);
  }

  @media (min-width: 640px) {
    .gp-research__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .gp-research__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .gp-research__card {
    padding: 2rem 1.75rem;
    background: #ffffff;
    position: relative;
    transition: background 0.3s ease;
  }

  .gp-research__card:hover {
    background: rgba(248, 250, 252, 0.7);
  }

  .gp-research__card-number {
    font-family: var(--font-display), Georgia, Times, serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    opacity: 0.4;
    margin-bottom: 0.75rem;
  }

  .gp-research__card-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--color-ink);
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .gp-research__card:hover .gp-research__card-title {
    color: var(--color-primary);
  }

  .gp-research__card-desc {
    font-size: 0.8125rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Bottom section ── */
  .gp-research__bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .gp-research__bottom {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gp-research__thesis {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .gp-research__thesis-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .gp-research__thesis-text {
    font-size: 0.875rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .gp-research__thesis-note {
    padding: 0.875rem 1rem;
    background: rgba(0, 93, 170, 0.04);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 8px 8px 0;
    font-size: 0.8125rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.6;
  }

  .gp-research__contact {
    background: rgba(0, 93, 170, 0.03);
    border: 1px solid rgba(0, 93, 170, 0.08);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .gp-research__contact-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .gp-research__contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.5;
  }

  .gp-research__contact-body p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .gp-research__contact-body a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .gp-research__contact-body a:hover {
    text-decoration: underline;
  }

  .gp-research__contact-name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .gp-research__contact-role {
    font-size: 0.75rem;
    color: var(--color-ink-faint, #94a3b8);
  }
</style>
