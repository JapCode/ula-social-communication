---
import { tinaField } from "@tinacms/astro/tina-field";

interface ItemsListItem {
  title: string;
  description?: string;
  detail?: string;
  icon?: string;
  href?: string;
  emphasis?: boolean;
  Icon?: any;
}

interface Props {
  items: ItemsListItem[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item, i) => (
    <div
      class:list={[
        "group relative flex items-start gap-4 p-5 md:p-6 rounded-luma transition-all duration-300 overflow-hidden",
        item.emphasis
          ? "bg-gradient-to-r from-primary/[0.04] to-white border border-primary/20 shadow-[0_2px_8px_rgba(0,93,170,0.08)] hover:shadow-[0_4px_16px_rgba(0,93,170,0.12)] hover:border-primary/30"
          : "bg-white border border-tinted hover:shadow-luma hover:border-tinted-strong",
      ]}
    >
      {item.emphasis && (
        <>
          {/* Left accent bar — full height, thick, colorful */}
          <div class="absolute left-0 top-0 bottom-0 w-[5px] bg-gradient-to-b from-primary to-primary/70 rounded-l-[inherit] pointer-events-none" aria-hidden="true"></div>
          {/* Subtle decorative corner flourish */}
          <div class="absolute -top-6 -right-6 w-16 h-16 bg-primary/[0.03] rounded-full pointer-events-none" aria-hidden="true"></div>
          {/* Glow dot on top-right */}
          <div class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary/20 pointer-events-none" aria-hidden="true"></div>
        </>
      )}
      {item.Icon && (
        <div
          class:list={[
            "flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110",
            item.emphasis ? "bg-primary/12 shadow-[0_2px_6px_rgba(0,93,170,0.15)]" : "bg-primary/5",
          ]}
        >
          <item.Icon size={20} weight={item.emphasis ? 'fill' : 'light'} class={item.emphasis ? "text-primary" : "text-primary"} />
        </div>
      )}
      {!item.Icon && item.emphasis && (
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/12 flex items-center justify-center text-xs font-bold text-primary">
          {i + 1}
        </div>
      )}
      <div class="flex-1 min-w-0 relative z-[1]">
        <div class="flex items-center gap-2 flex-wrap">
          {item.href ? (
            <a href={item.href} class={`text-sm md:text-base font-bold tracking-tight group-hover:text-primary transition-colors leading-snug ${item.emphasis ? 'text-primary' : 'text-ink'}`}>
              {item.title}
            </a>
          ) : (
            <h3 class={`text-sm md:text-base font-bold tracking-tight leading-snug ${item.emphasis ? 'text-primary' : 'text-ink'}`}>
              {item.title}
            </h3>
          )}
          {item.emphasis && (
            <span class="inline-flex items-center gap-1 text-[9px] font-bold tracking-widest uppercase bg-primary text-white px-2.5 py-1 rounded-full leading-none shrink-0 shadow-[0_1px_4px_rgba(0,93,170,0.25)]">
              <svg class="w-2.5 h-2.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.719-4.192-3.046-2.97a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
              DESTACADO
            </span>
          )}
        </div>
        {item.description && (
          <p class:list={["mt-1 text-sm leading-relaxed", item.emphasis ? "text-slate-600" : "text-slate-500"]}>
            {item.description}
          </p>
        )}
        {item.detail && (
          <p class="text-xs text-slate-400 mt-1.5 font-medium">
            {item.detail}
          </p>
        )}
      </div>
    </div>
  ))}
</div>
