---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhHeart, PhInfo } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'alert';
    title?: string;
    body?: string;
    variant?: string;
  };
}

const { block } = Astro.props;
const variant = block.variant === 'info' ? 'info' : 'heart';
const Icon = variant === 'info' ? PhInfo : PhHeart;
---

{block.title || block.body ? (
  <section class="gp-alert" class:list={[`gp-alert--${variant}`]}>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-12 md:py-16">
      <div class="gp-alert__inner">
        <div class="gp-alert__icon" aria-hidden="true">
          <Icon size={22} weight="light" />
        </div>
        <div class="gp-alert__content">
          {block.title && (
            <h3 class="gp-alert__title" data-tina-field={tinaField(block, 'title')}>
              {block.title}
            </h3>
          )}
          {block.body && (
            <div class="gp-alert__body" data-tina-field={tinaField(block, 'body')}>
              {block.body}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
) : null}

<style>
  .gp-alert {
    position: relative;
  }

  .gp-alert--info {
    --alert-bg: oklch(0.96 0.02 250);
    --alert-border: oklch(0.88 0.04 250);
    --alert-icon-bg: oklch(0.85 0.06 250);
    --alert-icon-color: oklch(0.35 0.08 250);
    --alert-title-color: oklch(0.25 0.06 250);
    --alert-text-color: oklch(0.45 0.04 250);
  }

  .gp-alert--heart {
    --alert-bg: oklch(0.97 0.015 20);
    --alert-border: oklch(0.90 0.035 20);
    --alert-icon-bg: oklch(0.88 0.05 20);
    --alert-icon-color: oklch(0.40 0.08 20);
    --alert-title-color: oklch(0.25 0.04 20);
    --alert-text-color: oklch(0.45 0.03 20);
  }

  .gp-alert__inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem 1.75rem;
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    border-radius: 14px;
  }

  .gp-alert__icon {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--alert-icon-bg);
    color: var(--alert-icon-color);
  }

  .gp-alert__content {
    flex: 1;
    min-width: 0;
    padding-top: 0.25rem;
  }

  .gp-alert__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--alert-title-color);
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .gp-alert__body {
    font-size: 0.875rem;
    color: var(--alert-text-color);
    line-height: 1.65;
  }
</style>
