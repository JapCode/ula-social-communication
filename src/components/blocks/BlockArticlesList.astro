---
import { tinaField } from "@tinacms/astro/tina-field";
import { requestWithMetadata } from "@tinacms/astro/data";
import { client } from "../../../tina/__generated__/client";
import {
  PhNewspaper, PhCalendar, PhTag, PhArrowRight, PhEnvelopeSimple,
} from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'articlesList';
    heading?: string;
  };
}

const { block } = Astro.props;

// ── Fetch articles from TinaCMS ──────────────────────────────
let articles: any[] = [];
try {
  const result = await requestWithMetadata(
    client.queries.articlesConnection({ sort: 'date', last: 50 })
  );
  articles = result.data.articlesConnection.edges
    ?.map((e: any) => e.node)
    .filter(Boolean) || [];
} catch {
  const { getCollection } = await import('astro:content');
  articles = await getCollection('articles');
}

// Sort by date descending
articles.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categories = [
  { key: 'todos', label: 'Todos' },
  { key: 'investigacion', label: 'Investigación' },
  { key: 'actualidad', label: 'Actualidad' },
  { key: 'opinion', label: 'Opinión' },
  { key: 'cronica', label: 'Crónica' },
];

function formatDate(date: string | Date): string {
  return new Date(date).toLocaleDateString('es-VE', {
    day: 'numeric', month: 'short', year: 'numeric',
  });
}

function catLabel(key: string): string {
  return categories.find(c => c.key === key)?.label || key;
}

function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

// Get the article slug from the TinaCMS node
function getSlug(article: any): string {
  return article._sys?.filename || article.id || '';
}
---

{/* ── Heading (optional) ── */}
{block.heading && (
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 pt-8">
    <h2 class="text-xl font-display font-bold text-ink">{block.heading}</h2>
  </div>
)}

{/* ── Category Filter ── */}
<nav class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 mb-12" aria-label="Filtrar por categoría">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2" data-filter-bar>
    {categories.map((cat) => (
      <button
        type="button"
        class="filter-link text-sm font-medium text-ink-muted relative transition-colors duration-200 hover:text-primary cursor-pointer"
        data-category={cat.key}
        aria-pressed={cat.key === 'todos'}
      >
        {cat.label}
      </button>
    ))}
  </div>
</nav>

{/* ── Article Grid ── */}
{articles.length > 0 ? (
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 mb-12">
    <div class="flex flex-col gap-12 sm:grid sm:grid-cols-2 sm:gap-x-10 sm:gap-y-8">
      {articles.map((article, i) => {
        const slug = getSlug(article);
        return (
          <article
            class={i === 0 ? 'group col-span-full flex flex-col' : 'group flex flex-col'}
            data-category={article.category}
          >
            {/* Image */}
            {normalizeImagePath(article.coverImage) ? (
              <a href={`/portfolio/articles/${slug}`} class="mb-8 block overflow-hidden rounded-luma aspect-video w-full">
                <img
                  src={normalizeImagePath(article.coverImage)}
                  alt={article.title}
                  class={i === 0
                    ? 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] m-0!'
                    : 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] m-0!'
                  }
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
            ) : (
              <div class={
                i === 0
                  ? 'mb-6 flex aspect-video max-h-[300px] items-center justify-center rounded-luma border border-tinted bg-surface'
                  : 'mb-6 flex aspect-video max-h-[180px] items-center justify-center rounded-luma border border-tinted bg-surface'
              }>
                <PhNewspaper size={i === 0 ? 64 : 32} weight="light" class="text-primary/15" />
              </div>
            )}

            {/* Metadata row: author, date, category */}
            <ul class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-faint">
              <li class="font-medium text-ink-muted">
                <span>{article.author}</span>
              </li>
              <li class="flex items-center gap-1">
                <PhCalendar size={14} weight="regular" class="text-ink-faint" />
                <span>{formatDate(article.date)}</span>
              </li>
              <li class="flex items-center gap-1">
                <PhTag size={14} weight="regular" class="text-ink-faint" />
                <a href="#" class="font-medium text-primary transition-colors duration-200 hover:text-primary-deep hover:underline" data-filter={article.category}>
                  {catLabel(article.category)}
                </a>
              </li>
            </ul>

            {/* Title */}
            <h3 class={i === 0
              ? 'mb-3 text-2xl font-display font-bold tracking-tight text-ink leading-tight sm:text-3xl'
              : 'mb-3 text-lg font-display font-semibold tracking-tight text-ink leading-snug'
            }>
              <a href={`/portfolio/articles/${slug}`} class="transition-colors duration-300 hover:text-primary">
                {article.title}
              </a>
            </h3>

            {/* Excerpt */}
            <p class="line-clamp-2 text-sm leading-relaxed text-ink-muted">
              {article.excerpt}
            </p>
          </article>
        );
      })}
    </div>
  </div>
) : (
  /* ── Empty State ── */
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 text-center py-16 md:py-24 animate-[fadeIn_0.4s_ease]">
    <PhNewspaper size={48} weight="light" class="mx-auto mb-6 text-slate-200" />
    <h2 class="mb-2 text-xl font-display font-bold text-slate-900">Próximamente</h2>
    <p class="mx-auto mb-8 max-w-md text-slate-500">
      Estamos preparando los primeros artículos del portafolio.
      Pronto podrás leer el trabajo de nuestros estudiantes aquí.
    </p>
    <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow-[var(--shadow-luma)] transition-all hover:shadow-lg">
      <PhEnvelopeSimple size={16} weight="regular" />
      Contactar Coordinación
    </a>
  </div>
)}

<!-- Client-side filtering script -->
<script>
  // Category filter
  const filterBar = document.querySelector('[data-filter-bar]');
  if (filterBar) {
    const links = filterBar.querySelectorAll('.filter-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        links.forEach(l => {
          l.classList.remove('active');
          l.setAttribute('aria-pressed', 'false');
        });
        link.classList.add('active');
        link.setAttribute('aria-pressed', 'true');

        const category = link.getAttribute('data-category');
        const allArticles = document.querySelectorAll<HTMLElement>('[data-category]');

        allArticles.forEach(article => {
          if (category === 'todos') {
            article.style.display = '';
            return;
          }
          const articleCategory = article.getAttribute('data-category');
          article.style.display = articleCategory === category ? '' : 'none';
        });
      });
    });
  }

  // Category links in meta also trigger filter
  document.querySelectorAll('[data-filter]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const category = link.getAttribute('data-filter');
      const filterBtn = document.querySelector<HTMLElement>(`.filter-link[data-category="${category}"]`);
      if (filterBtn) {
        filterBtn.click();
      }
    });
  });
</script>

<style>
  /* Filter link active state with underline animation */
  .filter-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-primary);
    transition: width 0.3s ease;
  }

  .filter-link:hover::after {
    width: 100%;
  }

  .filter-link.active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .filter-link.active::after {
    width: 100%;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
