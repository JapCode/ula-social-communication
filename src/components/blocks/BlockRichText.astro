---
import { tinaField } from "@tinacms/astro/tina-field";

export interface Props {
  block: {
    _template: 'richText';
    variant?: 'default' | 'lead';
    constrainWidth?: boolean;
    body: string;
  };
}

const { block } = Astro.props;
const variant = block.variant || 'default';
---

{variant === 'lead' ? (
  <section>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-8 md:py-12 lg:py-16">
      {block.body && (
        <div class="gp-opening" data-tina-field={tinaField(block, 'body')}>
          <div class="gp-opening__accent" aria-hidden="true">
            <span class="gp-opening__line"></span>
          </div>
          <p class:list={["gp-opening__text", block.constrainWidth ? "gp-opening__text--constrained" : ""]}>{block.body}</p>
        </div>
      )}
    </div>
  </section>
) : (
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-8 md:py-12 lg:py-16">
    {block.body && (
      <div class="rich-text-content max-w-4xl" data-tina-field={tinaField(block, 'body')}>
        {block.body}
      </div>
    )}
  </div>
)}

<style>
  /* Match ContentLayout .content-area typography for editorial consistency */
  .rich-text-content h2 {
    font-family: var(--font-display), Georgia, Times, serif;
    font-size: 1.625rem;
    font-weight: 650;
    color: var(--color-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .rich-text-content h3 {
    font-family: var(--font-body), Arial, "Helvetica Neue", sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    letter-spacing: 0.005em;
  }

  .rich-text-content p {
    font-family: var(--font-body), Arial, "Helvetica Neue", sans-serif;
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    font-size: 1rem;
    max-width: 65ch;
  }

  .rich-text-content ul,
  .rich-text-content ol {
    color: var(--color-ink-muted);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .rich-text-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .rich-text-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .rich-text-content a:hover {
    color: var(--color-primary-deep);
  }

  .rich-text-content blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .rich-text-content img {
    border-radius: var(--radius-luma);
    margin: 1.5rem 0;
  }

  .rich-text-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .rich-text-content th,
  .rich-text-content td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .rich-text-content th {
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .rich-text-content td {
    color: var(--color-ink-muted);
  }

  .rich-text-content code {
    background: #f1f5f9;
    padding: 0.2em 0.4em;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, monospace;
  }

  .rich-text-content pre {
    background: #f8fafc;
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .rich-text-content pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .rich-text-content hr {
    border: none;
    height: 1px;
    background: rgba(226, 232, 240, 0.5);
    margin: 2rem 0;
  }

  @media (max-width: 768px) {
    .rich-text-content h2 {
      font-size: 1.375rem;
      margin-top: 2rem;
    }

    .rich-text-content h3 {
      font-size: 1.0625rem;
      margin-top: 1.5rem;
    }

    .rich-text-content p {
      font-size: 0.9375rem;
    }
  }

  /* ── Lead variant ── */
  .gp-opening {
    position: relative;
    padding-left: 1.5rem;
  }

  .gp-opening__accent {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), rgba(0, 93, 170, 0.15));
    border-radius: 2px;
  }

  .gp-opening__text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    font-weight: 400;
    margin: 0;
  }

  .gp-opening__text--constrained {
    max-width: 48rem;
  }
</style>
