---
import { tinaField } from "@tinacms/astro/tina-field";
import { getIcon } from "@/lib/phosphorIcons";
import { PhRocketLaunch, PhGraduationCap, PhGlobe, PhTrendUp } from "phosphor-icons-astro";
import BlockItemsListCompetencies from "./BlockItemsListCompetencies.astro";
import BlockItemsListNumbered from "./BlockItemsListNumbered.astro";
import BlockItemsListTimeline from "./BlockItemsListTimeline.astro";
import BlockItemsListDefault from "./BlockItemsListDefault.astro";

export interface Props {
  block: {
    _template: 'itemsList';
    heading?: string;
    intro?: string;
    eyebrow?: string;
    constrainWidth?: boolean;
    variant?: 'default' | 'numbered' | 'timeline' | 'competencies';
    items: Array<{
      title: string;
      description?: string;
      detail?: string;
      icon?: string;
      href?: string;
      emphasis?: boolean;
    }>;
  };
}

const { block } = Astro.props;
const variant = block.variant || 'default';

// Fixed timeline icons (same as old design)
const timelineIcons = [PhRocketLaunch, PhGraduationCap, PhGlobe, PhTrendUp];

// Pre-compute icon components
const items = (block.items || []).map((item, i) => ({
  ...item,
  Icon: item.icon ? getIcon(item.icon) : null,
  timelineIcon: timelineIcons[i % timelineIcons.length],
  isCritical: (variant === 'timeline' && (i === 0 || i === (block.items?.length ?? 1) - 1 || item.emphasis)) as boolean,
}));
---

{items.length > 0 && (
  <section>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-8 md:py-12 lg:py-16">
    {block.heading && variant === 'numbered' && (
      <div class="flex items-center gap-4 mb-8 md:mb-12">
        <span class="block w-8 h-px bg-primary/40"></span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-slate-900" data-tina-field={tinaField(block, 'heading')}>
          {block.heading}
        </h2>
      </div>
    )}
    {block.heading && variant === 'default' && (
      <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400 mb-6 md:mb-8" data-tina-field={tinaField(block, 'heading')}>
        {block.heading}
      </h2>
    )}
    {block.heading && variant === 'timeline' && (
      <div class="flex items-center gap-4 mb-10 md:mb-14">
        <span class="block w-8 h-px bg-primary/40"></span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-slate-900" data-tina-field={tinaField(block, 'heading')}>
          {block.heading}
        </h2>
      </div>
    )}
    {block.heading && variant === 'competencies' && (
      <div class="mb-10 md:mb-14 gp-section-header">
        <span class="block w-8 h-px bg-primary/40"></span>
        {block.eyebrow && (
          <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-slate-400" data-tina-field={tinaField(block, 'eyebrow')}>
            {block.eyebrow}
          </span>
        )}
      </div>
    )}

    {variant === 'competencies' && block.heading && (
      <h2 class="gp-section-title" data-tina-field={tinaField(block, 'heading')}>
        {block.heading}
      </h2>
    )}
    {variant === 'competencies' && block.intro && (
      <p class:list={["gp-section-intro", block.constrainWidth ? "gp-constrain" : ""]} data-tina-field={tinaField(block, 'intro')}>
        {block.intro}
      </p>
    )}

    {variant === 'competencies' && <BlockItemsListCompetencies items={items} constrainWidth={block.constrainWidth} />}

    {variant === 'numbered' && <BlockItemsListNumbered items={block.items || []} />}

    {variant === 'timeline' && <BlockItemsListTimeline items={items} />}

    {variant !== 'competencies' && variant !== 'numbered' && variant !== 'timeline' && <BlockItemsListDefault items={items} />}
    </div>
  </section>
)}

<style>
  /* ── Timeline: Scroll Reveal Animations ── */
  .step-row {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .step-row:nth-child(1) { transition-delay: 0ms; }
  .step-row:nth-child(2) { transition-delay: 80ms; }
  .step-row:nth-child(3) { transition-delay: 160ms; }
  .step-row:nth-child(4) { transition-delay: 240ms; }

  /* ── Timeline: Hover Effects ── */
  .step-row:hover {
    background-color: rgba(248, 250, 252, 0.4);
    border-radius: 6px;
  }

  .step-row .step-title {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-title {
    color: var(--color-primary);
  }

  .step-row .step-desc {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-desc {
    color: #94a3b8;
  }

  .step-row .step-bg-number {
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-row:hover .step-bg-number {
    opacity: 0.15;
    transform: scale(1.03);
  }

  .step-row .step-date-line {
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .step-row:hover .step-date-line {
    width: 16px;
    background-color: var(--color-primary);
  }

  .step-row .step-date-text {
    transition: color 0.3s ease;
  }

  .step-row:hover .step-date-text {
    color: var(--color-primary);
  }

  /* ── Critical Step Emphasis ── */
  .step-row--critical {
    padding: 1.75rem 1rem;
    margin: 0.5rem -1rem;
    background: linear-gradient(135deg, rgba(0, 93, 170, 0.05) 0%, rgba(255,255,255,0.95) 60%);
    border-radius: 10px;
    border-left: 4px solid var(--color-primary);
    box-shadow:
      0 1px 3px rgba(0, 93, 170, 0.06),
      inset 0 0 0 1px rgba(0, 93, 170, 0.08);
  }

  .step-row--critical:hover {
    background: linear-gradient(135deg, rgba(0, 93, 170, 0.08) 0%, rgba(255,255,255,0.95) 60%);
    box-shadow:
      0 4px 12px rgba(0, 93, 170, 0.1),
      inset 0 0 0 1px rgba(0, 93, 170, 0.12);
  }

  .step-dot--critical {
    box-shadow: 0 0 0 4px rgba(0, 93, 170, 0.2);
  }

  .step-content--critical {
    padding-left: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .step-row {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .step-row:hover {
      background-color: transparent;
    }

    .step-row .step-title,
    .step-row .step-desc,
    .step-row .step-bg-number,
    .step-row .step-date-line,
    .step-row .step-date-text {
      transition: none;
    }

    .step-row:hover .step-bg-number {
      opacity: 0.05;
      transform: none;
    }
  }

  /* ── Section header (shared) ── */
  .gp-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .gp-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .gp-section-intro {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin: 0 0 2.5rem;
  }

  .gp-section-intro.gp-constrain {
    max-width: 40rem;
  }

  /* ── Competencies ── */
  .gp-competencies__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gp-competency {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
    transition: background 0.25s ease;
  }

  .gp-competency:first-child {
    padding-top: 0;
  }

  .gp-competency:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .gp-competency--featured {
    padding: 1.75rem 0;
  }

  .gp-competency--featured .gp-competency__title {
    font-size: 1.125rem;
  }

  .gp-competency__number {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.5;
    line-height: 1.5;
    padding-top: 0.125rem;
  }

  .gp-competency__content {
    min-width: 0;
  }

  .gp-competency__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
  }

  .gp-competency__icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .gp-competency__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .gp-competency__desc {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin: 0;
  }

  .gp-competency__desc.gp-constrain {
    max-width: 36rem;
  }

  @media (max-width: 768px) {
    .gp-competency {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
      padding: 1.25rem 0;
    }
  }
</style>

<script is:inline>
  (function() {
    function initRevealAnimations() {
      var revealElements = document.querySelectorAll(".step-row");
      var observer = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );
      revealElements.forEach(function(el) { observer.observe(el); });
    }

    document.addEventListener("DOMContentLoaded", initRevealAnimations);
    document.addEventListener("astro:page-load", initRevealAnimations);
  })();
</script>
