---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhUsersThree, PhHandshake, PhStar, PhUser } from "phosphor-icons-astro";

export interface Props {
  block: {
    _template: 'associationInfo';
    activities?: string[];
    participationText?: string;
    voceros?: Array<{
      name: string;
      role?: string;
      description?: string;
      photo?: string;
    }>;
  };
}

const { block } = Astro.props;
const hasActivities = block.activities && block.activities.length > 0;
const hasParticipation = !!block.participationText;
const hasVoceros = block.voceros && block.voceros.length > 0;

function getInitials(name: string): string {
  return name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map(w => w[0])
    .join('')
    .toUpperCase();
}
---

{(hasActivities || hasParticipation) && (
  <section class="gp-assoc">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-24">

    <div class="gp-assoc__layout">
      {hasActivities && (
        <div class="gp-assoc__activities">
          <div class="gp-assoc__title-block">
            <div class="gp-assoc__title-icon" aria-hidden="true">
              <PhUsersThree size={22} weight="light" />
            </div>
            <div>
              <span class="gp-assoc__eyebrow">Asociación de Estudiantes</span>
              <h2 class="gp-assoc__heading">Funciones de la Asociación</h2>
            </div>
          </div>

          <div class="gp-assoc__list">
            {block.activities!.map((act, i) => (
              <div key={i} class="gp-assoc__item" data-tina-field={tinaField(block, 'activities', i)}>
                <div class="gp-assoc__item-num" aria-hidden="true">{i + 1}</div>
                <div class="gp-assoc__item-content">
                  <div class="gp-assoc__item-line" aria-hidden="true"></div>
                  <p class="gp-assoc__item-text">{act}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {hasParticipation && (
        <div class="gp-assoc__sidebar">
          <div class="gp-assoc__participation">
            <div class="gp-assoc__participation-icon" aria-hidden="true">
              <PhHandshake size={24} weight="light" />
            </div>
            <h3 class="gp-assoc__participation-title">¿Cómo participar?</h3>
            <p class="gp-assoc__participation-text" data-tina-field={tinaField(block, 'participationText')}>
              {block.participationText}
            </p>
          </div>
        </div>
      )}
    </div>

    </div>
  </section>
)}

{/* ── Voceros Section ── */}
{hasVoceros && (
  <section class="gp-voceros">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-24">
      <div class="gp-voceros__header">
        <div class="gp-voceros__icon" aria-hidden="true">
          <PhUser size={22} weight="light" />
        </div>
        <div>
          <span class="gp-voceros__eyebrow">Representación Estudiantil</span>
          <h2 class="gp-voceros__heading">Voceros de la Asociación</h2>
        </div>
      </div>

      <div class="gp-voceros__grid">
        {block.voceros!.map((vocero, i) => (
          <div key={i} class="gp-voceros__card" data-tina-field={tinaField(block, 'voceros', i)}>
            {vocero.photo ? (
              <img
                class="gp-voceros__photo"
                src={vocero.photo}
                alt={vocero.name}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="gp-voceros__fallback" aria-hidden="true">
                <span class="gp-voceros__initials">{getInitials(vocero.name)}</span>
              </div>
            )}
            <div class="gp-voceros__info">
              <h3 class="gp-voceros__name" data-tina-field={tinaField(vocero, 'name')}>
                {vocero.name}
              </h3>
              {vocero.role && (
                <span class="gp-voceros__role" data-tina-field={tinaField(vocero, 'role')}>
                  {vocero.role}
                </span>
              )}
              {vocero.description && (
                <p class="gp-voceros__desc" data-tina-field={tinaField(vocero, 'description')}>
                  {vocero.description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .gp-assoc__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .gp-assoc__layout {
      grid-template-columns: 1fr 340px;
    }
  }

  /* ── Title Block ── */
  .gp-assoc__title-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .gp-assoc__title-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--color-primary);
    color: #ffffff;
  }

  .gp-assoc__eyebrow {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint, #94a3b8);
    margin-bottom: 0.125rem;
  }

  .gp-assoc__heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  /* ── Activity List (timeline-like) ── */
  .gp-assoc__list {
    display: flex;
    flex-direction: column;
  }

  .gp-assoc__item {
    display: flex;
    gap: 1rem;
  }

  .gp-assoc__item-num {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 93, 170, 0.08);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .gp-assoc__item-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 1.25rem;
    position: relative;
  }

  .gp-assoc__item:last-child .gp-assoc__item-content {
    padding-bottom: 0;
  }

  .gp-assoc__item-line {
    position: absolute;
    left: calc(-1rem - 0.875rem + 0.875rem);
    top: 1.75rem;
    bottom: 0;
    width: 1px;
    background: rgba(226, 232, 240, 0.6);
  }

  .gp-assoc__item:last-child .gp-assoc__item-line {
    display: none;
  }

  .gp-assoc__item-text {
    font-size: 0.875rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.65;
    margin: 0;
    padding-top: 0.125rem;
  }

  /* ── Participation (sidebar card) ── */
  .gp-assoc__participation {
    padding: 2rem 1.75rem;
    background: linear-gradient(135deg, rgba(0, 93, 170, 0.04), rgba(14, 165, 233, 0.04));
    border: 1px solid rgba(0, 93, 170, 0.1);
    border-radius: 16px;
  }

  .gp-assoc__participation-icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--color-primary);
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .gp-assoc__participation-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .gp-assoc__participation-text {
    font-size: 0.875rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Voceros Section ── */
  .gp-voceros {
    border-top: 1px solid var(--color-tinted, #e2e8f0);
  }

  .gp-voceros__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .gp-voceros__icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--color-primary);
    color: #ffffff;
  }

  .gp-voceros__eyebrow {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-faint, #94a3b8);
    margin-bottom: 0.125rem;
  }

  .gp-voceros__heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  .gp-voceros__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .gp-voceros__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gp-voceros__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gp-voceros__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem 1.25rem;
    border: 1px solid var(--color-tinted, #e2e8f0);
    border-radius: 16px;
    background: #ffffff;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .gp-voceros__card:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .gp-voceros__photo {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 2px solid var(--color-tinted, #e2e8f0);
  }

  .gp-voceros__fallback {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 93, 170, 0.6));
  }

  .gp-voceros__initials {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
  }

  .gp-voceros__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .gp-voceros__name {
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.3;
  }

  .gp-voceros__role {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 600;
    line-height: 1.3;
  }

  .gp-voceros__desc {
    font-size: 0.8rem;
    color: var(--color-ink-muted, #64748b);
    line-height: 1.55;
    margin: 0.5rem 0 0;
    max-width: 28ch;
  }
</style>
