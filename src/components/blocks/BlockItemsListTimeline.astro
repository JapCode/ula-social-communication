---
import { tinaField } from "@tinacms/astro/tina-field";
import { PhRocketLaunch, PhGraduationCap, PhGlobe, PhTrendUp } from "phosphor-icons-astro";

interface ItemsListItem {
  title: string;
  description?: string;
  detail?: string;
  icon?: string;
  href?: string;
  emphasis?: boolean;
  Icon?: any;
  timelineIcon?: any;
  isCritical?: boolean;
}

interface Props {
  items: ItemsListItem[];
}

const { items } = Astro.props;
const timelineIcons = [PhRocketLaunch, PhGraduationCap, PhGlobe, PhTrendUp];

// Recompute enriched items (same as parent)
const enriched = items.map((item, i) => ({
  ...item,
  Icon: item.Icon || timelineIcons[i % timelineIcons.length],
  isCritical: i === 0 || i === items.length - 1 || item.emphasis,
}));
---

<div class="relative">
  {/* Vertical timeline line */}
  <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-200" aria-hidden="true"></div>

  {enriched.map((item, i) => {
    const Icon = item.Icon;
    const isCritical = item.isCritical;
    const isLast = i === enriched.length - 1;
    return (
      <article
        class:list={[
          "step-row group relative pl-8 md:pl-12",
          isCritical ? "step-row--critical" : "",
          isLast ? "" : "mb-0",
          item.emphasis ? "" : "",
        ]}
      >
        {/* Timeline dot */}
        <div
          class:list={[
            "step-dot absolute left-[-5px] top-10 w-2.5 h-2.5 rounded-full border-2 border-surface transition-all duration-300",
            isCritical
              ? "step-dot--critical bg-primary border-surface shadow-[0_0_0_4px_rgba(0,93,170,0.2)]"
              : "bg-slate-300",
          ]}
        />

        <div
          class:list={[
            "step-content relative",
            isCritical ? "step-content--critical" : "",
          ]}
        >
          {/* Step number — subtle background */}
          <div class="absolute right-4 md:right-8 top-6 pointer-events-none select-none">
            <span
              class:list={[
                "step-bg-number text-6xl md:text-8xl font-bold font-body leading-none",
                isCritical ? "text-primary/[0.08]" : "text-slate-200/60",
              ]}
            >
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          {/* Badge for emphasized items */}
          {item.emphasis && (
            <div class="mb-3">
              <span class="inline-flex items-center gap-1 text-[9px] font-bold tracking-widest uppercase bg-primary text-white px-2.5 py-1 rounded-full shadow-[0_1px_4px_rgba(0,93,170,0.25)]">
                <svg class="w-2.5 h-2.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.719-4.192-3.046-2.97a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
                DESTACADO
              </span>
            </div>
          )}

          <div class="flex flex-col md:flex-row md:items-start md:justify-between md:gap-8">
            {/* Content */}
            <div class="flex-1 mb-3 md:mb-0 pr-16 md:pr-24">
              <div class="flex items-center gap-3 mb-2">
                <Icon
                  size={22}
                  weight={isCritical ? "fill" : "duotone"}
                  class={isCritical ? "text-primary drop-shadow-[0_1px_2px_rgba(0,93,170,0.2)]" : "text-primary/60"}
                />
                <h2
                  class:list={[
                    "step-title text-lg md:text-xl tracking-tight",
                    isCritical ? "font-bold text-ink" : "font-medium text-slate-700",
                  ]}
                >
                  {item.title}
                </h2>
              </div>
              <p
                class:list={[
                  "step-desc leading-relaxed max-w-xl",
                  isCritical ? "text-slate-600" : "text-slate-400",
                ]}
              >
                {item.description}
              </p>
            </div>

            {/* Year — Monospace Label on the right */}
            <div class="flex-shrink-0 self-start text-right">
              <div
                class:list={[
                  "step-date-line w-8 h-px ml-auto mb-1.5",
                  isCritical ? "bg-primary/40" : "bg-slate-200",
                ]}
              />
              <p
                class:list={[
                  "step-date-text text-[10px] font-mono tracking-wider uppercase",
                  isCritical ? "text-primary/80 font-bold" : "text-slate-300",
                ]}
              >
                {item.detail}
              </p>
            </div>
          </div>
        </div>

        {/* Separator line between steps */}
        {!isLast && (
          <div class="step-separator ml-1.5 mt-6 mb-6 md:mt-8 md:mb-8">
            <div class="h-px bg-slate-100" />
          </div>
        )}
      </article>
    );
  })}
</div>
