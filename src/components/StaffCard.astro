---
import { PhUser, PhEnvelope, PhPhone } from 'phosphor-icons-astro';

// Normalize image paths from Decap CMS
function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

interface Props {
  name: string;
  role: string;
  department: string;
  email?: string;
  phone?: string;
  featured?: boolean;
  photo?: string;
}

const { name, role, department, email, phone, featured = false, photo } = Astro.props;
const photoUrl = normalizeImagePath(photo);
---

<article class:list={[
  'staff-card',
  featured && 'staff-card--featured',
]}>
  <div class="staff-card__inner">
    <!-- Avatar / Photo -->
    {photoUrl ? (
      <div class="staff-card__avatar staff-card__avatar--photo">
        <img src={photoUrl} alt={`Foto de ${name}`} class="staff-card__photo" loading="lazy" />
      </div>
    ) : (
      <div class="staff-card__avatar">
        <PhUser size={featured ? 28 : 20} weight="light" class="staff-card__avatar-icon" />
      </div>
    )}

    <!-- Info -->
    <div class="staff-card__info">
      <h3 class="staff-card__name">{name}</h3>
      <p class="staff-card__role">{role}</p>
      <p class="staff-card__dept">{department}</p>

      <!-- Contact -->
      {(email || phone) && (
        <div class="staff-card__contact">
          {email && (
            <a
              href={`mailto:${email}`}
              class="staff-card__contact-link"
              aria-label={`Enviar correo a ${name}: ${email}`}
            >
              <PhEnvelope size={14} weight="light" />
              {email}
            </a>
          )}
          {phone && (
            <span class="staff-card__contact-item">
              <PhPhone size={14} weight="light" />
              {phone}
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .staff-card {
    background: var(--color-surface-elevated);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .staff-card:hover {
    box-shadow: var(--shadow-luma);
    transform: translateY(-2px);
  }

  .staff-card--featured {
    border-color: rgba(0, 93, 170, 0.15);
  }

  .staff-card__inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
  }

  .staff-card--featured .staff-card__inner {
    padding: 2rem;
    gap: 1.5rem;
  }

  .staff-card__avatar {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(0, 93, 170, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .staff-card--featured .staff-card__avatar {
    width: 4rem;
    height: 4rem;
    background: rgba(0, 93, 170, 0.1);
  }

  .staff-card__avatar--photo {
    overflow: hidden;
    padding: 0;
  }

  .staff-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .staff-card__avatar-icon {
    color: var(--color-primary);
  }

  .staff-card__info {
    min-width: 0;
    flex: 1;
  }

  .staff-card__name {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0;
  }

  .staff-card--featured .staff-card__name {
    font-size: 1.125rem;
  }

  .staff-card__role {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }

  .staff-card__dept {
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }

  .staff-card__contact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .staff-card__contact-link,
  .staff-card__contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .staff-card__contact-link:hover {
    color: var(--color-primary);
  }
</style>
