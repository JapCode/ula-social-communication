---
import { requestWithMetadata } from "@tinacms/astro/data";
import { tinaField } from "@tinacms/astro/tina-field";
import { client } from "../../tina/__generated__/client";
import { PhInstagramLogo, PhXLogo, PhYoutubeLogo, PhTiktokLogo } from 'phosphor-icons-astro';

// Optional: receive footer data from parent (island). If not provided, fetch from Tina.
const { footerData: propFooterData } = Astro.props;
const footerData = propFooterData ?? (await requestWithMetadata(
  client.queries.footer({ relativePath: 'footer.json' })
)).data.footer;

// ── Destructure with defaults ──────────────────────────────
const brandDescription = footerData?.brandDescription ?? 'Universidad de los Andes — Núcleo Universitario "Rafael Rangel".';
const social_instagram = footerData?.social_instagram ?? 'https://www.instagram.com/comunicacionsocialulanurr/';
const social_twitter = footerData?.social_twitter ?? 'https://x.com/ulanurr_cs';
const social_youtube = footerData?.social_youtube ?? 'https://youtube.com/@comunicacionsocialulanurr';
const social_tiktok = footerData?.social_tiktok ?? 'https://www.tiktok.com/@comunicacionsocialnurr';
const contactHeading = footerData?.contactHeading ?? 'Contacto';
const email = footerData?.email ?? 'comunicacion@nurr.ula.ve';
const emailLabel = footerData?.emailLabel ?? 'Email';
const phone = footerData?.phone ?? '+58 412 263-2750';
const phoneLabel = footerData?.phoneLabel ?? 'Teléfono';
const schedule = footerData?.schedule ?? 'Lun–Vie 8:00 AM – 4:00 PM';
const scheduleLabel = footerData?.scheduleLabel ?? 'Horario';
const linkColumns = footerData?.linkColumns ?? [];
const secondaryLinks = footerData?.secondaryLinks ?? [];
const currentYear = new Date().getFullYear();
const copyright = footerData?.copyright ?? 'ULA NURR – Comunicación Social. Todos los derechos reservados.';
---

<footer class="footer bg-white relative px-6 md:px-12 border-t border-tinted" role="contentinfo" aria-label="Pie de página">
	<div class="max-w-7xl mx-auto py-12 md:py-16">

		<!-- 4 equal columns on desktop, 2×2 grid on mobile -->
		<div class="footer-grid mb-10 md:mb-12 pb-10 md:pb-12 border-b border-tinted">

			<!-- Brand -->
			<div class="footer-col">
				<div class="flex items-center gap-3 mb-4">
					<img src="/ula_logo.jpg" alt="ULA NURR" class="h-9 md:h-10 w-auto" />
				</div>
				<p class="text-slate-500 text-sm leading-relaxed" data-tina-field={tinaField(footerData, 'brandDescription')}>
					{brandDescription}
				</p>
				<div class="flex items-center gap-2 mt-4">
					<a href={social_instagram} target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Instagram" data-tina-field={tinaField(footerData, 'social_instagram')}>
						<PhInstagramLogo size={16} weight="regular" />
					</a>
					<a href={social_twitter} target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="X" data-tina-field={tinaField(footerData, 'social_twitter')}>
						<PhXLogo size={16} weight="regular" />
					</a>
					<a href={social_youtube} target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="YouTube" data-tina-field={tinaField(footerData, 'social_youtube')}>
						<PhYoutubeLogo size={16} weight="regular" />
					</a>
					<a href={social_tiktok} target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="TikTok" data-tina-field={tinaField(footerData, 'social_tiktok')}>
						<PhTiktokLogo size={16} weight="regular" />
					</a>
				</div>
			</div>

			<!-- Contacto -->
			<div class="footer-col">
				<h4 class="footer-heading" data-tina-field={tinaField(footerData, 'contactHeading')}>{contactHeading}</h4>
				<div class="space-y-2">
					<p class="footer-contact">
						<span class="footer-contact-label" data-tina-field={tinaField(footerData, 'emailLabel')}>{emailLabel}</span>
						<a href={`mailto:${email}`} class="footer-contact-link" data-tina-field={tinaField(footerData, 'email')}>{email}</a>
					</p>
					<p class="footer-contact">
						<span class="footer-contact-label" data-tina-field={tinaField(footerData, 'phoneLabel')}>{phoneLabel}</span>
						<span data-tina-field={tinaField(footerData, 'phone')}>{phone}</span>
					</p>
					<p class="footer-contact">
						<span class="footer-contact-label" data-tina-field={tinaField(footerData, 'scheduleLabel')}>{scheduleLabel}</span>
						<span data-tina-field={tinaField(footerData, 'schedule')}>{schedule}</span>
					</p>
				</div>
			</div>

			<!-- Link columns (Admisión, Académico, etc.) generated from data -->
			{
				linkColumns.map((col, ci) => (
					<div class="footer-links-col">
						<h4 class="footer-heading" data-tina-field={tinaField(footerData, `linkColumns.${ci}`)}>{col.heading}</h4>
						<ul class="footer-links-list">
							{
								(col.links ?? []).map((link, li) => (
									<li>
										<a class="footer-link" href={link.href} data-tina-field={tinaField(footerData, `linkColumns.${ci}.links.${li}`)}>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				))
			}
		</div>

		<!-- Secondary links — single row, compact — generated from data -->
		<div class="footer-secondary-links" data-tina-field={secondaryLinks.length > 0 ? tinaField(footerData, 'secondaryLinks') : undefined}>
			{
				secondaryLinks.map((link, i) => (
					<a class="footer-secondary-link" href={link.href} data-tina-field={tinaField(footerData, `secondaryLinks.${i}`)}>
						{link.label}
					</a>
				))
			}
		</div>

		<!-- Bottom bar -->
		<div class="mt-8 pt-6 border-t border-tinted">
			<p class="text-center text-[10px] text-slate-400 tracking-wider">
				&copy; {currentYear} <span data-tina-field={tinaField(footerData, 'copyright')}>{copyright}</span>
			</p>
		</div>
	</div>
</footer>

<style>
	/* 4-column grid — 2×2 on mobile, 4 across on desktop */
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 2.5rem;
	}

	@media (min-width: 768px) {
		.footer-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
		}
	}

	.footer-col {
		display: flex;
		flex-direction: column;
	}

	/* Link columns */
	.footer-links-col {
		display: flex;
		flex-direction: column;
	}

	.footer-links-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-heading {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: 0.625rem;
	}

	.footer-link {
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--color-ink-muted);
		text-decoration: none;
		transition: color 0.2s ease;
		display: inline-block;
		line-height: 1.4;
	}

	.footer-link:hover {
		color: var(--color-primary);
	}

	.footer-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-radius: 4px;
	}

	/* Contact info */
	.footer-contact {
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--color-ink);
		line-height: 1.5;
	}

	.footer-contact-label {
		display: block;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-ink-faint);
	}

	.footer-contact-link {
		color: var(--color-ink);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-contact-link:hover {
		color: var(--color-accent);
	}

	/* Social icons */
	.footer-social-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 9999px;
		border: 1px solid rgba(226, 232, 240, 0.5);
		color: var(--color-ink-muted);
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.footer-social-icon:hover {
		color: var(--color-green);
		border-color: rgba(0, 178, 90, 0.2);
		background: rgba(0, 178, 90, 0.04);
	}

	.footer-social-icon:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	/* Secondary links row */
	.footer-secondary-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		justify-content: center;
	}

	.footer-secondary-link {
		font-size: 0.75rem;
		color: var(--color-ink-faint);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-secondary-link:hover {
		color: var(--color-primary);
	}

	.footer-secondary-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-radius: 4px;
	}
</style>
