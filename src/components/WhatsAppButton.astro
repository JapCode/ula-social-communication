---
import { requestWithMetadata } from "@tinacms/astro/data";
import { tinaField } from "@tinacms/astro/tina-field";
import { client } from "../../tina/__generated__/client";

// Optional: receive data from parent. If not provided, fetch from Tina.
const { footerData: propFooterData } = Astro.props;
const footerData = propFooterData ?? (await requestWithMetadata(
  client.queries.footer({ relativePath: 'footer.json' })
)).data.footer;

const whatsappPhone = footerData?.whatsappPhone ?? '584120000000';
const whatsappMessage = footerData?.whatsappMessage ?? 'Hola, necesito ayuda con información sobre Comunicación Social ULA NURR';
const whatsappTooltip = footerData?.whatsappTooltip ?? 'Soporte';
const waUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
	href={waUrl}
	class="whatsapp-fab hidden md:flex fixed bottom-6 right-6 md:bottom-8 md:right-8 z-[90] items-center justify-center group"
	target="_blank"
	rel="noopener noreferrer"
	aria-label={whatsappTooltip}
>
	<!-- Pulse ring -->
	<span class="absolute inset-0 rounded-full bg-whatsapp opacity-20 animate-ping" aria-hidden="true"></span>
	
	<!-- Button -->
	<span class="relative flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-full bg-whatsapp shadow-lg shadow-whatsapp/30 transition-transform duration-300 group-hover:scale-110 group-active:scale-95">
		<!-- WhatsApp Feather-style SVG -->
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
		</svg>
	</span>
	
	<!-- Tooltip -->
	<span class="absolute right-full mr-3 px-3 py-1.5 bg-ink text-white text-[10px] font-bold tracking-wider uppercase rounded-luma opacity-0 translate-x-2 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:opacity-100 group-hover:translate-x-0" data-tina-field={tinaField(footerData, 'whatsappTooltip')}>
		{whatsappTooltip}
	</span>
</a>

<style>
	.whatsapp-fab {
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}
	
	@media (max-width: 375px) {
		.whatsapp-fab {
			bottom: 4rem;
			right: 4rem;
		}
		
		.whatsapp-fab > span:nth-child(2) {
			width: 3rem;
			height: 3rem;
		}
		
		.whatsapp-fab svg {
			width: 1.25rem;
			height: 1.25rem;
		}
	}
</style>
