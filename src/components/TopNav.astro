				<button id="mobile-menu-close" class="p-2 rounded-full hover:bg-black/5 transition-colors duration-300 min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Cerrar menú">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted" aria-hidden="true">
