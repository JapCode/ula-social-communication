---
import DropdownNav from "@/components/DropdownNav.astro";
import { dropdownGroups, type DropdownSection } from "@/data/navigation";
import {
  PhMagnifyingGlass,
  PhList,
  PhX,
  PhCaretDown,
  PhHouse,
  PhUserPlus,
  PhChatCircle,
  PhBookOpen,
  PhCalendar,
  PhWhatsappLogo,
} from "phosphor-icons-astro";

// Get current path for active state
const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

// Check if any section in a dropdown group has an active item
const isGroupActive = (sections: DropdownSection[]) =>
  sections.some((section) =>
    section.items.some((item) => isActive(item.href))
  );

// Generate a stable slug from a label for data-attributes
const slugify = (text: string) =>
  text.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
---

<nav
  transition:persist
  class="fixed top-0 left-0 right-0 z-[100] bg-surface-elevated border-b border-primary/20 transition-all duration-300"
  aria-label="Navegación principal"
>
  <div
    class="flex items-center justify-between px-5 md:px-12 lg:px-16 max-w-[1400px] mx-auto"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center ">
      <figure class="relative aspect-square h-[55px] w-[170px] min-w-fit overflow-hidden">
        <img
          src="/images/ula_logo.png"
          alt="ULA NURR"
          class="absolute object-cover object-center inset-0 w-[200px] h-[60px] -mt-0.5"
        />
      </figure>
    </a>

    <!-- Desktop Navigation (generated from data) -->
    <div class="hidden lg:flex items-center gap-5 py-2 md:py-3.5" data-desktop-nav>
      <a
        class:list={[
          "text-[10px] md:text-[12px] font-bold tracking-[0.15em] uppercase transition-colors duration-300 relative group py-1.5 px-2.5",
          isActive("/")
            ? "text-primary"
            : "text-[var(--color-ink-muted)] hover:text-primary",
        ]}
        href="/"
        aria-current={isActive("/") ? "page" : undefined}
      >
        <span class="relative">
          Inicio
          {
            isActive("/") && (
              <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-primary rounded-full" />
            )
          }
        </span>
      </a>

      {
        dropdownGroups.map((group) => (
          <DropdownNav label={group.label} sections={group.sections} />
        ))
      }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1.5">
      <button
        class="hidden lg:inline-flex items-center gap-1.5 p-1.5 rounded-none hover:bg-[rgba(248,250,252,0.8)] transition-colors duration-300 min-w-[36px] min-h-[36px]"
        id="search-btn"
        aria-label="Buscar"
        onclick="openSearch()"
      >
        <PhMagnifyingGlass
          size={18}
          weight="bold"
          class="text-[var(--color-ink)]"
        />
        <span class="text-[10px] md:text-[11px] font-bold tracking-[0.12em] uppercase text-[var(--color-ink)]">Buscar</span>
      </button>

      <a
        href="/contact"
        class="hidden lg:inline-flex items-center justify-center bg-accent text-white text-[10px] md:text-[11px] font-bold tracking-[0.12em] uppercase px-4 md:px-5 py-2 md:py-2.5 rounded-none hover:bg-accent-hover hover:-translate-y-0.5 active:bg-accent-active active:translate-y-0 transition-all duration-300 border border-transparent"
      >
        Contacto
      </a>

      <!-- Animated hamburger (morphs between list and X) -->
      <button
        class="lg:hidden menu-btn p-1.5 rounded-full hover:bg-[rgba(248,250,252,0.8)] transition-colors duration-300 min-w-[36px] min-h-[36px] flex items-center justify-center"
        id="mobile-menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="relative w-5 h-5 flex items-center justify-center">
          <PhList
            size={20}
            weight="duotone"
            class="menu-icon-hamburger absolute inset-0 transition-all duration-300 text-[var(--color-ink-muted)]"
          />
          <PhX
            size={20}
            weight="duotone"
            class="menu-icon-close absolute inset-0 transition-all duration-300 text-[var(--color-ink-muted)] opacity-0 rotate-90 scale-75"
          />
        </div>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu - Bottom Sheet -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[150] bg-ink/80 backdrop-blur-sm hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div
    class="absolute bottom-0 left-0 right-0 h-[85vh] bg-[var(--color-surface-elevated)] border-t-2 border-primary rounded-none transform translate-y-full transition-transform duration-300 ease-out"
    id="mobile-menu-panel"
  >
    <!-- Drag Handle (Removed rounded corners) -->
    <div class="flex justify-center pt-3 pb-1">
      <div class="w-10 h-1.5 bg-ink"></div>
    </div>

    <div class="p-6 h-full overflow-y-auto pb-12">
      <div class="flex items-center justify-between mb-6">
        <span
          class="font-bold tracking-[0.15em] text-[11px] uppercase text-[var(--color-ink)]"
          >Menú</span
        >
        <button
          id="mobile-menu-close"
          class="p-2 rounded-full hover:bg-[rgba(248,250,252,0.8)] transition-colors duration-300 min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-label="Cerrar menú"
        >
          <PhX
            size={20}
            weight="duotone"
            class="text-[var(--color-ink-muted)]"
          />
        </button>
      </div>

      <nav class="space-y-1" aria-label="Menú móvil">
        <!-- Quick Actions (now using Phosphor icons) -->
        <div class="mb-4 pb-4 border-b border-tinted">
          <p
            class="text-[10px] font-bold text-ink-faint uppercase tracking-wider mb-3 px-3"
          >
            Acciones rápidas
          </p>
          <div class="grid grid-cols-2 gap-2">
            <button
              id="mobile-search-btn"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-primary/5 rounded-xl hover:bg-primary/10 active:bg-primary/15 transition-colors cursor-pointer"
            >
              <span
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center"
              >
                <PhMagnifyingGlass size={20} weight="light" class="text-primary" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >Buscar</span
              >
            </button>
            <a
              href="/admission/process"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-primary/5 rounded-xl hover:bg-primary/10 active:bg-primary/15 transition-colors"
            >
              <span
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center"
              >
                <PhUserPlus size={20} weight="light" class="text-primary" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >Inscripciones</span
              >
            </a>
            <a
              href="/contact"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-primary/5 rounded-xl hover:bg-primary/10 active:bg-primary/15 transition-colors"
            >
              <span
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center"
              >
                <PhChatCircle size={20} weight="light" class="text-primary" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >Contacto</span
              >
            </a>
            <a
              href="/academics/curriculum"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-primary/5 rounded-xl hover:bg-primary/10 active:bg-primary/15 transition-colors"
            >
              <span
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center"
              >
                <PhBookOpen size={20} weight="light" class="text-primary" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >Pénsum</span
              >
            </a>
            <a
              href="/student-life/events"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-primary/5 rounded-xl hover:bg-primary/10 active:bg-primary/15 transition-colors"
            >
              <span
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center"
              >
                <PhCalendar size={20} weight="light" class="text-primary" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >Eventos</span
              >
            </a>
            <a
              href="https://wa.me/584120000000?text=Hola%2C%20necesito%20ayuda%20con%20informaci%C3%B3n%20sobre%20Comunicaci%C3%B3n%20Social%20ULA%20NURR"
              target="_blank"
              rel="noopener noreferrer"
              class="quick-action-card flex flex-col items-center gap-2 p-4 bg-whatsapp/5 rounded-xl hover:bg-whatsapp/10 active:bg-whatsapp/15 transition-colors"
              aria-label="Contactar por WhatsApp"
            >
              <span
                class="w-10 h-10 rounded-full bg-whatsapp/10 flex items-center justify-center"
              >
                <PhWhatsappLogo size={20} weight="light" class="text-whatsapp" />
              </span>
              <span
                class="text-[11px] font-bold text-ink text-center leading-tight"
                >WhatsApp</span
              >
            </a>
          </div>
        </div>

        <!-- Inicio -->
        <a
          href="/"
          class:list={[
            "flex items-center gap-3 py-3 text-[12px] font-bold tracking-[0.15em] uppercase rounded-xl px-3 -mx-3 transition-colors duration-300",
            isActive("/")
              ? "text-primary bg-primary/5"
              : "text-[var(--color-ink)] hover:text-primary",
          ]}
        >
          <PhHouse
            size={18}
            weight="duotone"
            class={isActive("/") ? "text-primary" : "text-primary/70"}
          />
          Inicio
          {isActive("/") && (
            <span class="ml-auto w-1.5 h-1.5 rounded-full bg-primary" />
          )}
        </a>

        <!-- Dropdown groups generated from data (eliminates template duplication) -->
        {dropdownGroups.map((group) => {
          const groupSlug = slugify(group.label);
          const groupActive = isGroupActive(group.sections);
          return (
            <div class="mobile-nav-group">
              <button
                class="mobile-nav-toggle w-full flex items-center justify-between py-3 text-[12px] font-bold tracking-[0.15em] uppercase rounded-xl px-3 -mx-3 transition-colors duration-300"
                class:list={[
                  groupActive
                    ? "text-primary"
                    : "text-[var(--color-ink)] hover:text-primary",
                ]}
                data-group={groupSlug}
                aria-expanded={groupActive ? "true" : "false"}
              >
                <span class="flex items-center gap-2">
                  {group.label}
                  {groupActive && (
                    <span class="w-1.5 h-1.5 rounded-full bg-primary" />
                  )}
                </span>
                <PhCaretDown
                  size={16}
                  weight="duotone"
                  class={[
                    "text-[var(--color-ink-muted)] transition-transform duration-200",
                    groupActive ? "rotate-180" : "",
                  ].join(" ")}
                  data-icon
                />
              </button>
              <div
                class:list={[
                  "mobile-nav-submenu pl-4 space-y-1 overflow-hidden transition-all duration-200 ease-out",
                  groupActive ? "submenu-open" : "hidden",
                ]}
                data-submenu={groupSlug}
              >
                {group.sections.map((section, sIdx) => (
                  <>
                    {section.heading && (
                      <p class="text-[10px] font-bold text-primary uppercase tracking-wider py-2">
                        {section.heading}
                      </p>
                    )}
                    {section.items.map((item, iIdx) => {
                      const itemActive = isActive(item.href);
                      return (
                        <a
                          href={item.href}
                          class:list={[
                            "block py-2 pl-3 text-[12px] rounded-r-lg transition-all duration-200 border-l-2",
                            itemActive
                              ? "text-primary border-primary bg-primary/5"
                              : "text-[var(--color-ink-muted)] hover:text-primary border-transparent hover:border-primary",
                          ]}
                          style={
                            groupActive
                              ? `animation-delay: ${(sIdx * section.items.length + iIdx) * 40}ms`
                              : undefined
                          }
                        >
                          {item.label}
                          {itemActive && (
                            <span class="ml-2 w-1.5 h-1.5 rounded-full bg-primary inline-block" />
                          )}
                        </a>
                      );
                    })}
                  </>
                ))}
              </div>
            </div>
          );
        })}

        <a
          href="/contact"
          class="w-full bg-accent text-white text-[11px] font-bold tracking-[0.15em] uppercase px-6 py-3.5 rounded-none border border-transparent mt-4 hover:bg-accent-hover hover:translate-y-0.5 active:bg-accent-active active:translate-y-0 transition-all duration-300 block text-center"
        >
          Contacto
        </a>
      </nav>
    </div>
  </div>
</div>

<script>
  /**
   * Consolidated scripts for TopNav:
   * - Nav indicator updates after view transitions
   * - Scroll-aware shadow + hide/show on direction
   * - Mobile menu open/close, focus trap, accordion, drag-to-dismiss
   */

  // ─── 1. NAV INDICATOR UPDATE (view-transition-aware) ──────────────
  if (!window.__navIndicatorInit) {
    window.__navIndicatorInit = true;
    document.addEventListener('astro:after-swap', updateNavIndicators);
  }

  // Run on initial page load
  queueMicrotask(updateNavIndicators);

  function updateNavIndicators() {
    const desktop = document.querySelector('[data-desktop-nav]');
    if (!desktop) return;

    const path = window.location.pathname;
    const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));

    /* "Inicio" link */
    const inicio = desktop.querySelector('a[href="/"]');
    if (inicio) {
      const active = isActive('/');
      swapClasses(inicio, active, 'text-primary', ['text-primary'], ['text-[var(--color-ink-muted)]', 'hover:text-primary']);
      inicio.setAttribute('aria-current', active ? 'page' : '');
      manageUnderline(inicio, '.relative', active, '-bottom-1');
    }

    /* Dropdown triggers */
    desktop.querySelectorAll('[data-dropdown-trigger]').forEach((btn) => {
      const panel = btn.closest('[data-dropdown]')?.querySelector('[data-dropdown-panel]');
      if (!panel) return;

      const active = Array.from(panel.querySelectorAll('a[href]')).some((a) =>
        isActive(a.getAttribute('href')),
      );

      swapClasses(btn, active, 'text-primary', ['text-primary'], ['text-ink-muted', 'hover:text-primary']);
      btn.setAttribute('aria-expanded', active ? 'true' : 'false');
      manageUnderline(btn, '.relative', active, '-bottom-0.5');
    });

    /* Dropdown panel items */
    desktop.querySelectorAll('[data-dropdown-panel] a[href]').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const active = isActive(href);

      swapClasses(link, active, 'link', ['bg-primary/5', 'text-primary'], ['hover:bg-[rgba(248,250,252,0.8)]']);

      const icon = link.querySelector('.flex-shrink-0');
      if (icon) {
        swapClasses(icon, active, 'icon', ['text-primary'], ['text-primary/60', 'group-hover/item:text-primary']);
      }

      const label = link.querySelector('.text-sm.font-medium');
      if (label) {
        swapClasses(label, active, 'label', ['text-primary'], ['text-[var(--color-ink)]', 'group-hover/item:text-primary']);
      }
    });
  }

  function swapClasses(el, active, _group, activeClasses, inactiveClasses) {
    el.classList.remove(...activeClasses, ...inactiveClasses);
    el.classList.add(...(active ? activeClasses : inactiveClasses));
  }

  function manageUnderline(container, childSelector, active, bottomClass) {
    const child = container.querySelector(childSelector);
    if (!child) return;
    let dot = child.querySelector('.bg-primary.rounded-full');
    if (active && !dot) {
      dot = document.createElement('span');
      dot.className = `absolute ${bottomClass} left-0 right-0 h-0.5 bg-primary rounded-full`;
      child.appendChild(dot);
    } else if (!active && dot) {
      dot.remove();
    }
  }

  // ─── 2. SCROLL-AWARE NAV: bottom border on scroll ──────
  (function initScrollNav() {
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        const nav = document.querySelector('.fixed.top-0.left-0.right-0');
        if (!nav) {
          ticking = false;
          return;
        }

        // Add bottom border when scrolled past threshold
        nav.classList.toggle('nav-scrolled', window.scrollY > 80);

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load
    onScroll();
  })();

  // ─── 3. MOBILE MENU: open/close, focus trap, accordion, drag-to-dismiss ──
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuClose = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuPanel = document.getElementById('mobile-menu-panel');

    if (!menuBtn || !menuClose || !mobileMenu || !menuPanel) return;

    // Focusable elements within the mobile menu panel
    function getFocusableElements() {
      return Array.from(
        menuPanel.querySelectorAll(
          'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])',
        ),
      );
    }

    // Focus trap handler
    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      const focusable = getFocusableElements();
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function openMenu() {
      mobileMenu.classList.remove('hidden');
      mobileMenu.setAttribute('aria-hidden', 'false');
      menuBtn.setAttribute('aria-expanded', 'true');
      menuBtn.classList.add('is-open'); // animated hamburger

      // Slide panel up
      requestAnimationFrame(() => {
        menuPanel.classList.remove('translate-y-full');
      });

      document.body.style.overflow = 'hidden';

      // Focus trap after open animation
      setTimeout(() => {
        menuClose.focus();
        document.addEventListener('keydown', trapFocus);
      }, 350);
    }

    function closeMenu() {
      menuPanel.classList.add('translate-y-full');
      menuBtn.classList.remove('is-open'); // animated hamburger
      document.removeEventListener('keydown', trapFocus);

      setTimeout(() => {
        mobileMenu.classList.add('hidden');
        mobileMenu.setAttribute('aria-hidden', 'true');
        menuBtn.setAttribute('aria-expanded', 'false');
        // Reset drag transform
        menuPanel.style.transform = '';
      }, 300);

      document.body.style.overflow = '';
      menuBtn.focus();
    }

    menuBtn.addEventListener('click', openMenu);
    menuClose.addEventListener('click', closeMenu);

    // Close when clicking overlay
    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) closeMenu();
    });

    // ── Drag-to-dismiss (touch) ──
    (function initDragDismiss() {
      let touchStartY = 0;
      let touchCurrentY = 0;
      let isDragging = false;

      menuPanel.addEventListener(
        'touchstart',
        (e) => {
          // Only enable drag when content is scrolled to the very top
          if (menuPanel.scrollTop <= 0) {
            touchStartY = e.touches[0].clientY;
            isDragging = true;
            touchCurrentY = touchStartY;
          }
        },
        { passive: true },
      );

      menuPanel.addEventListener(
        'touchmove',
        (e) => {
          if (!isDragging) return;
          touchCurrentY = e.touches[0].clientY;
          const diff = touchCurrentY - touchStartY;

          if (diff > 0) {
            // Translate proportionally with resistance
            const translateY = Math.min(diff * 0.4, 150);
            menuPanel.style.transform = `translateY(${translateY}px)`;

            // Dim the overlay proportionally
            mobileMenu.style.background = `rgba(15,23,42,${Math.max(0, 0.4 - diff * 0.002)})`;
          }
        },
        { passive: true },
      );

      menuPanel.addEventListener(
        'touchend',
        () => {
          if (!isDragging) return;
          isDragging = false;
          const diff = touchCurrentY - touchStartY;

          if (diff > 120) {
            closeMenu();
          } else {
            // Snap back
            menuPanel.style.transform = '';
            mobileMenu.style.background = '';
          }

          touchStartY = 0;
          touchCurrentY = 0;
        },
        { passive: true },
      );
    })();

    // ── Mobile accordion toggles ──
    document.querySelectorAll('.mobile-nav-toggle').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const group = toggle.getAttribute('data-group');
        const submenu = document.querySelector(`[data-submenu="${group}"]`);
        const icon = toggle.querySelector('[data-icon]');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        if (!submenu) return;

        toggle.setAttribute('aria-expanded', (!isExpanded).toString());
        icon?.classList.toggle('rotate-180');

        if (submenu.classList.contains('hidden')) {
          submenu.classList.remove('hidden');
          submenu.classList.add('submenu-open');
          // Trigger staggered animation
          submenu.classList.add('animate-stagger');
          setTimeout(() => submenu.classList.remove('animate-stagger'), 400);
        } else {
          submenu.classList.remove('submenu-open');
          setTimeout(() => {
            if (!submenu.classList.contains('submenu-open')) {
              submenu.classList.add('hidden');
            }
          }, 200);
        }
      });
    });

    // ── Close on Escape ──
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        closeMenu();
      }
    });

    // ── Prevent panel click from closing ──
    menuPanel.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // ── Mobile search button ──
    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    mobileSearchBtn?.addEventListener('click', () => {
      closeMenu();
      setTimeout(() => {
        window.openSearch?.();
      }, 350);
    });
  });
</script>

<style>
  /* ── Permanent bottom border ── */
  .fixed.top-0.left-0.right-0 {
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .fixed.top-0.left-0.right-0.nav-scrolled {
    border-bottom: 1px solid var(--color-ink);
  }

  /* ── Animated hamburger ── */
  .menu-icon-hamburger,
  .menu-icon-close {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .menu-btn.is-open .menu-icon-hamburger {
    opacity: 0;
    transform: rotate(90deg) scale(0.75);
  }
  .menu-btn.is-open .menu-icon-close {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* ── Submenu slide animation ── */
  .mobile-nav-submenu.submenu-open {
    animation: slideDown 0.2s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Staggered item animation ── */
  .mobile-nav-submenu.animate-stagger a {
    animation: fadeInItem 0.3s ease-out both;
  }
  .mobile-nav-submenu.animate-stagger a:nth-child(1) {
    animation-delay: 0ms;
