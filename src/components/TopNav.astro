import {
  PhMagnifyingGlass,
  PhList,
  PhX,
  PhCaretDown,
  PhHouse,
} from "phosphor-icons-astro";

// Get current path for active state
const currentPath = Astro.url.pathname;

// ============================================================
// CONSOLIDATED NAVIGATION DATA (reduced from 6 to 3 dropdowns)
// ============================================================

// Dropdown 1: El Programa (Programa + Académico)
const programaData = [
  {
    heading: "Institucional",
    items: [
      {
        label: "Misión y Visión",
        href: "/program/mission",
        description: "Propósito del programa",
        icon: "eye",
      },
      {
        label: "Historia",
        href: "/program/history",
        description: "Orígenes del programa",
        icon: "book-open-text",
      },
      {
        label: "Autoridades",
        href: "/program/authorities",
        description: "Directores y coordinadores",
        icon: "gear",
      },
      {
        label: "Docentes",
        href: "/program/faculty",
        description: "Directorio de profesores",
        icon: "users",
      },
    ],
  },
  {
    heading: "Académico",
    items: [
      {
        label: "Perfil del Egresado",
        href: "/program/graduate-profile",
        description: "Competencias de graduados",
        icon: "graduation-cap",
      },
      {
        label: "Currículo",
        href: "/academics/curriculum",
        description: "Malla curricular",
        icon: "tree-structure",
      },
      {
        label: "Contenido de Cursos",
        href: "/academics/course-content",
        description: "Material por materia",
        icon: "book-open",
      },
      {
        label: "Líneas de Investigación",
        href: "/academics/research",
        description: "Temas de tesis",
        icon: "flask",
      },
      {
        label: "Pasantías",
        href: "/academics/internships",
        description: "Requisitos",
        icon: "briefcase",
      },
    ],
  },
];

// Dropdown 2: Vida Estudiantil (Vida Estudiantil + Portafolio)
const vidaEstudiantilData = [
  {
    heading: "Vida Estudiantil",
    items: [
      {
        label: "Asociación",
        href: "/student-life/association",
        description: "Contacto y noticias",
        icon: "users",
      },
      {
        label: "Grupos y Talleres",
        href: "/student-life/groups",
        description: "Cine, teatro, radio",
        icon: "masks",
      },
      {
        label: "Servicio Comunitario",
        href: "/student-life/community",
        description: "Proyectos activos",
        icon: "heart",
      },
      {
        label: "Calendario",
        href: "/student-life/calendar",
        description: "Fechas clave",
        icon: "calendar",
      },
      {
        label: "Eventos",
        href: "/student-life/events",
        description: "Foros, charlas",
        icon: "calendar",
      },
    ],
  },
  {
    heading: "Producción",
    items: [
      {
        label: "NURR en Medios",
        href: "/portfolio/articles",
        description: "Artículos",
        icon: "newspaper",
      },
      {
        label: "Lab Radio/TV",
        href: "/portfolio/media-lab",
        description: "Producción audiovisual",
        icon: "video",
      },
      {
        label: "Revista Digital",
        href: "/portfolio/magazine",
        description: "Publicaciones",
        icon: "notebook",
      },
    ],
  },
];

// Dropdown 3: Admisión (Admisión + Egresados)
const admisionData = [
  {
    heading: "Admisión",
    items: [
      {
        label: "Proceso",
        href: "/admission/process",
        description: "OPSU, pruebas",
        icon: "user-plus",
      },
      {
        label: "Requisitos",
        href: "/admission/requirements",
        description: "Documentación",
        icon: "file-text",
      },
    ],
  },
  {
    heading: "Egresados",
    items: [
      {
        label: "Testimonios",
        href: "/alumni/testimonials",
        description: "Historias de éxito",
        icon: "medal",
      },
      {
        label: "Educación Continua",
        href: "/alumni/continuing-education",
        description: "Postgrados",
        icon: "trend-up",
      },
    ],
  },
];

// Helper to check if path is active
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<nav
  class="fixed top-3 left-1/2 -translate-x-1/2 z-[100] w-[95%] md:w-[90%] max-w-7xl"
  aria-label="Navegación principal"
>
  <div
    class="floating-nav bg-[var(--color-surface-elevated)] border border-[rgba(226,232,240,0.5)] shadow-luma rounded-full px-4 md:px-8 py-2.5 md:py-3 flex items-center justify-between"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 md:gap-3">
      <img
        src="/ula_logo.jpg"
        alt="ULA NURR"
        class="h-5 md:h-7 w-auto"
        width="48"
        height="48"
      />
      <span
        class="font-bold tracking-[0.15em] text-[10px] md:text-[12px] uppercase hidden xs:inline text-[var(--color-ink)]"
        >ULA NURR</span
      >
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-6">
      <a
        class:list={[
          "text-[10px] md:text-[12px] font-bold tracking-[0.15em] uppercase transition-colors duration-300 relative group py-1.5 px-2.5",
          isActive("/") ? "text-primary" : "text-[var(--color-ink-muted)] hover:text-primary",
        ]}
        href="/"
        aria-current={isActive("/") ? "page" : undefined}
      >
        <span class="relative">
          Inicio
          {
            isActive("/") && (
              <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-primary rounded-full" />
            )
          }
        </span>
      </a>

      <DropdownNav label="El Programa" sections={programaData} />
      <DropdownNav label="Vida Estudiantil" sections={vidaEstudiantilData} />
      <DropdownNav label="Admisión" sections={admisionData} />
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1.5">
      <button
        class="p-1.5 rounded-full hover:bg-[rgba(248,250,252,0.8)] transition-colors duration-300 min-w-[36px] min-h-[36px] flex items-center justify-center"
        id="search-btn"
        aria-label="Buscar"
        onclick="openSearch()"
      >
        <PhMagnifyingGlass size={18} weight="light" class="text-[var(--color-ink-muted)]" />
      </button>

      <a
        href="/contact"
        class="bg-primary text-white text-[10px] md:text-[11px] font-bold tracking-[0.15em] uppercase px-3 md:px-4 py-1.5 md:py-2 rounded-full border border-white/20 hover:border-white/40 hover:shadow-luma hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 inline-block"
      >
        Contacto
