---
import type { InferEntrySchema } from "astro:content";
import { PhArrowRight, PhArrowDown } from "phosphor-icons-astro";

export interface Props {
  hero: InferEntrySchema<"pages">["hero"];
}

const { hero } = Astro.props;
---

<section
	class="hero-editorial relative"
	id="inicio"
	aria-labelledby="hero-title"
>

	<!-- Hero: centered vertical layout -->
	<div class="relative z-10 min-h-[60vh] md:min-h-[80vh] lg:min-h-screen lg:max-h-[56rem] flex items-center justify-center xs:pt-16 pt-28 pb-6 lg:pt-20 lg:pb-0">
		<div class="w-full max-w-[1400px] mx-auto px-5 md:px-12 lg:px-16 relative">

			<!-- Decorative background number — centered watermark -->
			<div class="hidden lg:block absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 text-primary/[0.03] pointer-events-none select-none font-display font-black overflow-hidden leading-none" style="font-size: clamp(20rem, 40vw, 50rem); letter-spacing: -0.06em;" aria-hidden="true">
				26
			</div>

			<!-- Editorial content — centered vertical stack -->
			<div class="relative z-10 text-center bg-surface-elevated max-w-2xl mx-auto">

				<!-- Logo — centered above title -->
				<div class="mb-6 md:mb-8 flex justify-center">
		      <figure class="relative aspect-square h-[150px] w-[150px] min-w-fit overflow-hidden">
						<img
							src="/images/161618.png"
							alt="ULA NURR"
	          class="absolute object-cover object-center inset-0 w-[200px] h-[200px]"
						/>
					</figure>
				</div>

				<!-- Eyebrow — centered magazine style -->
				<div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6 justify-center">
					<span class="block w-6 md:w-10 h-px bg-ink/30"></span>
					<span class="hero-eyebrow text-[9px] md:text-[10px] font-bold tracking-[0.35em] md:tracking-[0.4em] uppercase text-ink">
						{hero.eyebrow}
					</span>
					<span class="block w-4 md:w-8 h-px bg-ink/30"></span>
				</div>

				<!-- Main title — fluid, dramatic scale, centered -->
				<h1
					id="hero-title"
					class="hero-title font-display font-black text-primary leading-[0.85] tracking-tighter uppercase mb-4 md:mb-6 text-center break-words max-w-full"
					style="font-size: clamp(1.8rem, 6vw, 5rem);"
				>
					<span class="hero-title-line">{hero.title_line1}</span><br />
					<span class="hero-title-line text-primary">{hero.title_line2}</span>
				</h1>

				<!-- Value proposition — centered, no left accent -->
				<p class="hero-value-prop text-sm md:text-base lg:text-lg text-ink/80 mt-4 md:mt-6 max-w-prose mx-auto leading-relaxed font-body">
					{hero.description}
				</p>

				<!-- CTA row — centered -->
				<div class="flex flex-col sm:flex-row items-center gap-3 md:gap-4 mt-6 md:mt-10 justify-center">
					<a
						href={hero.cta_link}
						class="hero-cta-primary xs:w-full sm:w-auto inline-flex items-center gap-2 px-8 py-4 bg-accent text-white text-sm font-bold tracking-widest uppercase rounded-none hover:bg-accent-hover transition-colors duration-300"
					>
						{hero.cta_text}
						<PhArrowRight size={16} weight="bold" />
					</a>
					<a
						href={hero.secondary_link}
						class="hero-cta-secondary xs:w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent border-2 border-primary text-primary text-sm font-bold tracking-widest uppercase hover:bg-primary hover:text-white transition-colors duration-300 rounded-none"
					>
						{hero.secondary_text}
					</a>
				</div>

				<!-- Subtle scroll indicator — desktop only, gentle bounce -->
				<div class="hidden lg:flex items-center gap-3 mt-12 lg:mt-16 text-ink-faint hero-scroll-indicator justify-center">
					<PhArrowDown size={14} weight="light" />
					<span class="text-[9px] font-bold tracking-[0.3em] uppercase">Explora</span>
				</div>

			</div>
		</div>
	</div>
</section>

<style>
	.hero-editorial {
		background-color: var(--color-surface-elevated);
		min-height: 100vh;
	}

	/* Mobile: let section height follow content */
	@media (max-width: 767px) {
		.hero-editorial {
			min-height: auto;
		}
	}

	/* ── Title staggered fade-up ── */
	@keyframes title-fade-up {
		from { opacity: 0; transform: translateY(24px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.hero-title-line {
		display: inline-block;
		animation: title-fade-up 0.7s linear both;
	}
	.hero-title-line:last-child {
		animation-delay: 0.25s;
	}

	/* ── Scroll indicator bounce ── */
	@keyframes scroll-bounce {
		0%, 100% { transform: translateY(0); opacity: 0.25; }
		50% { transform: translateY(6px); opacity: 0.6; }
	}
	.hero-scroll-indicator {
		animation: scroll-bounce 2.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	/* ── Description fade-in just behind the title ── */
	@keyframes desc-fade {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.hero-value-prop {
		animation: desc-fade 0.5s linear 0.15s both;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-editorial * {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
