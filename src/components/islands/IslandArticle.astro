---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;

function normalizeImagePath(path: string | undefined | null): string | undefined {
  if (!path) return undefined;
  if (path.startsWith('/') || path.startsWith('http://') || path.startsWith('https://')) return path;
  return `/images/uploads/${path}`;
}

const formattedDate = data?.date
  ? new Date(data.date as string).toLocaleDateString('es-VE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : '';
---

<article class="article-content">
  <!-- Title -->
  <h1 data-tina-field={data ? tinaField(data, 'title') : undefined}>
    {data?.title as string}
  </h1>

  <!-- Meta -->
  <div class="article-meta">
    <span data-tina-field={data ? tinaField(data, 'author') : undefined}>
      {data?.author as string}
    </span>
    <span data-tina-field={data ? tinaField(data, 'date') : undefined}>
      {formattedDate}
    </span>
    <span data-tina-field={data ? tinaField(data, 'category') : undefined}>
      {data?.category as string}
    </span>
  </div>

  <!-- Cover image -->
  {data?.coverImage && (
    <div data-tina-field={data ? tinaField(data, 'coverImage') : undefined}>
      <img src={normalizeImagePath(data.coverImage as string)} alt={(data.title as string) || ''} class="w-full rounded-lg" />
    </div>
  )}

  <!-- Excerpt -->
  {data?.excerpt && (
    <p data-tina-field={data ? tinaField(data, 'excerpt') : undefined} class="text-lg text-slate-500 leading-relaxed">
      {data.excerpt as string}
    </p>
  )}

  <!-- Body -->
  {data?.body && (
    <div data-tina-field={data ? tinaField(data, 'body') : undefined}>
      <TinaMarkdown content={data.body} />
    </div>
  )}
</article>

<style>
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .article-meta {
    display: flex;
    gap: 1rem;
    color: var(--color-slate-400);
    font-size: 0.875rem;
    margin-bottom: 2rem;
  }
</style>