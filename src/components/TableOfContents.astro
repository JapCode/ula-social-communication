---
import {
  PhListBullets,
  PhCaretDown,
} from "phosphor-icons-astro";

interface Props {
  headings?: Array<{ id: string; text: string; level: number }>;
}

const { headings = [] } = Astro.props;
---

{
  headings.length > 0 && (
    <aside
      class="toc-sidebar hidden lg:block"
      aria-label="Tabla de contenidos"
    >
      <div class="sticky top-28">
        <div class="bg-white border border-slate-100/50 rounded-luma p-6 shadow-luma">
          <!-- TOC Header -->
          <div class="flex items-center gap-2 mb-5">
            <PhListBullets size={16} weight="regular" class="text-primary" />
            <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-slate-400">
              Contenido
            </h2>
          </div>

          <!-- TOC Links -->
          <nav aria-label="Tabla de contenidos">
            <ul class="space-y-1">
              {headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.id}`}
                    class:list={[
                      "toc-link block py-1.5 text-sm text-slate-500 hover:text-primary transition-colors duration-300 rounded-lg",
                      heading.level === 3 ? "pl-4 text-[13px]" : "pl-0",
                    ]}
                    data-heading-id={heading.id}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </aside>
  )
}

<!-- Mobile TOC Toggle -->
{
  headings.length > 0 && (
    <div class="lg:hidden mb-8">
      <details class="toc-mobile bg-white border border-slate-100/50 rounded-luma shadow-luma">
        <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none">
          <div class="flex items-center gap-2">
            <PhListBullets size={16} weight="regular" class="text-primary" />
            <span class="text-sm font-semibold text-slate-900">Tabla de contenidos</span>
          </div>
          <PhCaretDown
            size={18}
            weight="regular"
            class="text-slate-400 transition-transform duration-300 toc-chevron"
          />
        </summary>
        <div class="px-5 pb-5 border-t border-slate-100/50">
          <nav aria-label="Tabla de contenidos móvil" class="pt-4">
            <ul class="space-y-1">
              {headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.id}`}
                    class:list={[
                      "toc-link block py-2 text-sm text-slate-500 hover:text-primary transition-colors duration-300 rounded-lg",
                      heading.level === 3 ? "pl-4 text-[13px]" : "pl-0",
                    ]}
                    data-heading-id={heading.id}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </details>
    </div>
  )
}

<script>
  document.addEventListener('astro:page-load', () => {
    // Active section tracking for TOC
  const tocLinks = document.querySelectorAll('.toc-link');
  const headingIds = Array.from(tocLinks).map(link => link.getAttribute('data-heading-id'));

  function updateActiveTocLink() {
    let currentId = '';
    
    headingIds.forEach(id => {
      const heading = document.getElementById(id!);
      if (heading) {
        const rect = heading.getBoundingClientRect();
        if (rect.top <= 150) {
          currentId = id!;
        }
      }
    });

    tocLinks.forEach(link => {
      const isActive = link.getAttribute('data-heading-id') === currentId;
      link.classList.toggle('toc-link-active', isActive);
    });
  }

  // Throttled scroll listener
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveTocLink();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Initial check
  updateActiveTocLink();

  // Mobile details/summary chevron rotation
  const details = document.querySelector('details.toc-mobile');
  const chevron = details?.querySelector('.toc-chevron');
  
  details?.addEventListener('toggle', () => {
    if (chevron) {
      chevron.classList.toggle('rotate-180', details.open);
    }
  });
  });
</script>

<style>
  .toc-link-active {
    color: var(--color-primary);
    font-weight: 600;
    background: rgba(0, 93, 170, 0.05);
  }

  details.toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  details.toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .toc-chevron {
      transition: none !important;
    }
  }
</style>
