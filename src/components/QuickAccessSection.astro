---
import type { InferEntrySchema } from "astro:content";
import { PhUserPlus, PhCalendar, PhBooks, PhBookOpen } from 'phosphor-icons-astro';

export interface Props {
  quickAccess: InferEntrySchema<"pages">["quickAccess"];
}

const { quickAccess } = Astro.props;

// Icons fixed by index — CMS only edits text/links
const icons = [PhUserPlus, PhCalendar, PhBooks, PhBookOpen];
---

<!-- Quick Access — horizontal strip, no card wrapper, surface background -->
<section class="quick-access-strip" id="accesos" aria-labelledby="access-title">
	<div class="w-full max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 py-12 md:py-20">

		<!-- Header — left-aligned -->
		<div class="flex items-center gap-5 mb-10 md:mb-14">
			<span class="block w-12 h-px bg-primary/30"></span>
			<h2 id="access-title" class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-ink tracking-tight text-wrap balance">{quickAccess.title}</h2>
		</div>

		<!-- Mobile: 2x2 grid — phones (< 768px) -->
		<div class="md:hidden grid grid-cols-2 gap-3">
			{quickAccess.items.map((item, i) => {
				const Icon = icons[i] || icons[0];
				return (
					<a class="qa-card-mobile flex flex-col items-center gap-3 p-5 text-center group" href={item.href} aria-label={item.aria_label}>
						<span class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/5 flex items-center justify-center transition-all duration-300 group-hover:bg-primary/10 group-active:scale-95">
							<Icon size={22} weight="duotone" class="text-primary" />
						</span>
						<div>
							<span class="text-[11px] font-bold tracking-widest uppercase block text-ink">{item.title}</span>
							<span class="text-xs text-ink-muted">{item.subtitle}</span>
						</div>
					</a>
				);
			})}
		</div>

		<!-- Tablet: 4-column card grid (768px – 1023px) -->
		<div class="hidden md:grid lg:hidden grid-cols-4 gap-3">
			{quickAccess.items.map((item, i) => {
				const Icon = icons[i] || icons[0];
				return (
					<a class="qa-card-mobile flex flex-col items-center gap-2 p-4 text-center group" href={item.href} aria-label={item.aria_label}>
						<span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/5 flex items-center justify-center transition-all duration-300 group-hover:bg-primary/10 group-active:scale-95">
							<Icon size={20} weight="duotone" class="text-primary" />
						</span>
						<div>
							<span class="text-[10px] font-bold tracking-widest uppercase block text-ink">{item.title}</span>
							<span class="text-xs text-ink-muted leading-tight block">{item.subtitle_desktop}</span>
						</div>
					</a>
				);
			})}
		</div>

		<!-- Desktop: editorial horizontal row — equal at rest, distinctive on hover -->
		<div class="hidden lg:flex gap-0">
			{quickAccess.items.map((item, i) => {
				const Icon = icons[i] || icons[0];
				return (
					<a class="qa-card-desktop group flex-1 flex items-center gap-5 py-8 px-8 border-r border-tinted last:border-r-0 relative" href={item.href} aria-label={item.aria_label}>
						<span class="flex-shrink-0 w-14 h-14 rounded-full bg-primary/5 flex items-center justify-center transition-all duration-300 group-hover:bg-primary/10 group-hover:scale-110">
							<Icon size={24} weight="duotone" class="text-primary transition-colors duration-300 group-hover:text-primary" />
						</span>
						<div>
							<span class="text-[11px] font-bold tracking-widest uppercase block text-ink">{item.title}</span>
							<span class="text-sm text-ink-muted">{item.subtitle_desktop}</span>
						</div>
						<!-- Editorial left accent on hover -->
						<span class="absolute left-0 top-[15%] bottom-[15%] w-0.5 bg-transparent group-hover:bg-primary transition-colors duration-300 rounded-full" aria-hidden="true"></span>
					</a>
				);
			})}
		</div>
	</div>
</section>

<style>
	.quick-access-strip {
		background-color: var(--color-surface);
	}

	.qa-card-mobile {
		background: var(--color-surface-elevated);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-luma);
		transition: box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
	}

	.qa-card-mobile:hover {
		background: rgba(0, 62, 126, 0.02);
		border-color: var(--color-border-strong);
		box-shadow: var(--shadow-luma);
	}

	.qa-card-mobile:active {
		background: rgba(0, 62, 126, 0.04);
		border-color: rgba(0, 62, 126, 0.2);
	}

	.qa-card-desktop {
		position: relative;
		transition: background 0.3s ease, box-shadow 0.3s ease;
		text-decoration: none;
	}

	.qa-card-desktop:hover {
		background: rgba(0, 62, 126, 0.02);
		box-shadow: inset 0 1px 0 var(--color-border-light), inset 0 -1px 0 var(--color-border-light);
	}

	.qa-card-desktop:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
		border-radius: 0;
	}
</style>
