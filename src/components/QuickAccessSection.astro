---
import { PhUserPlus, PhClock, PhBooks, PhBookOpen } from 'phosphor-icons-astro';
---

<!-- Quick Access — horizontal strip, no card wrapper, surface background -->
<section class="quick-access-strip" id="accesos" aria-labelledby="access-title">
	<div class="w-full max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 py-12 md:py-20">

		<!-- Header — left-aligned -->
		<div class="flex items-center gap-4 mb-10 md:mb-14">
			<span class="block w-8 h-px bg-primary/40"></span>
			<h2 id="access-title" class="text-2xl md:text-3xl lg:text-4xl font-display font-semibold tracking-tight text-slate-900">Accesos Rápidos</h2>
		</div>

		<!-- Mobile: 2x2 grid — all visible at once, no scrolling -->
		<div class="md:hidden grid grid-cols-2 gap-3">
			<a class="qa-card-mobile flex flex-col items-center gap-3 p-5 text-center group" href="/admission/process" aria-label="Inscripciones - Nuevos ingresos">
				<span class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-active:scale-95">
					<PhUserPlus size={22} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Inscripciones</span>
					<span class="text-xs text-slate-500">Nuevos ingresos</span>
				</div>
			</a>
			<a class="qa-card-mobile flex flex-col items-center gap-3 p-5 text-center group" href="/student-life/calendar" aria-label="Horarios - Cronograma semestre">
				<span class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-active:scale-95">
					<PhClock size={22} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Horarios</span>
					<span class="text-xs text-slate-500">Cronograma semestre</span>
				</div>
			</a>
			<a class="qa-card-mobile flex flex-col items-center gap-3 p-5 text-center group" href="/academics/curriculum" aria-label="Pénsum - Malla curricular">
				<span class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-active:scale-95">
					<PhBooks size={22} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Pénsum</span>
					<span class="text-xs text-slate-500">Malla curricular</span>
				</div>
			</a>
			<a class="qa-card-mobile flex flex-col items-center gap-3 p-5 text-center group" href="/academics/course-content" aria-label="Biblioteca - Biblioteca digital">
				<span class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-active:scale-95">
					<PhBookOpen size={22} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Biblioteca</span>
					<span class="text-xs text-slate-500">Biblioteca digital</span>
				</div>
			</a>
		</div>

		<!-- Desktop: horizontal row with dividers -->
		<div class="hidden md:grid grid-cols-4 gap-0">
			<a class="qa-card-desktop group flex items-center gap-5 py-8 px-8 border-r border-slate-100 last:border-r-0" href="/admission/process" aria-label="Inscripciones - Gestión de nuevos ingresos y reingresos">
				<span class="flex-shrink-0 w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
					<PhUserPlus size={24} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Inscripciones</span>
					<span class="text-sm text-slate-500">Gestión de nuevos ingresos y reingresos</span>
				</div>
			</a>
			<a class="qa-card-desktop group flex items-center gap-5 py-8 px-8 border-r border-slate-100 last:border-r-0" href="/student-life/calendar" aria-label="Horarios - Cronograma académico del semestre actual">
				<span class="flex-shrink-0 w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
					<PhClock size={24} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Horarios</span>
					<span class="text-sm text-slate-500">Cronograma académico del semestre actual</span>
				</div>
			</a>
			<a class="qa-card-desktop group flex items-center gap-5 py-8 px-8 border-r border-slate-100 last:border-r-0" href="/academics/curriculum" aria-label="Pénsum - Malla curricular y plan de estudios">
				<span class="flex-shrink-0 w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
					<PhBooks size={24} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Pénsum</span>
					<span class="text-sm text-slate-500">Malla curricular y plan de estudios</span>
				</div>
			</a>
			<a class="qa-card-desktop group flex items-center gap-5 py-8 px-8 border-r border-slate-100 last:border-r-0" href="/academics/course-content" aria-label="Biblioteca - Acceso a biblioteca digital y archivos">
				<span class="flex-shrink-0 w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
					<PhBookOpen size={24} weight="duotone" class="text-primary" />
				</span>
				<div>
					<span class="text-[11px] font-bold tracking-widest uppercase block text-slate-900">Biblioteca</span>
					<span class="text-sm text-slate-500">Acceso a biblioteca digital y archivos</span>
				</div>
			</a>
		</div>
	</div>
</section>

<style>
	.quick-access-strip {
		background-color: var(--color-surface);
	}

	.qa-card-mobile {
		background: var(--color-surface-elevated);
		border: 1px solid rgba(226, 232, 240, 0.5);
		border-radius: var(--radius-luma);
		transition: box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.qa-card-mobile:active {
		background: rgba(0, 93, 170, 0.03);
		border-color: rgba(0, 93, 170, 0.15);
	}

	.qa-card-desktop {
		position: relative;
		transition: background 0.3s ease;
	}

	.qa-card-desktop::before {
		content: '';
		position: absolute;
		left: 0;
		top: 20%;
		bottom: 20%;
		width: 2px;
		background: transparent;
		transition: background 0.3s ease;
	}

	.qa-card-desktop:hover {
		background: rgba(0, 93, 170, 0.02);
	}

	.qa-card-desktop:hover::before {
		background: var(--color-primary);
	}

	.qa-card-desktop:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
		border-radius: 0;
	}
</style>
