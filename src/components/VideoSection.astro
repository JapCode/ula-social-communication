---
import type { InferEntrySchema } from "astro:content";
import { PhPlay, PhX } from 'phosphor-icons-astro';

export interface Props {
  video: InferEntrySchema<"pages">["video"];
}

const { video } = Astro.props;
---

<!-- Video section — full-bleed cinematic layout, no card wrapper -->
<section class="video-cinematic relative" id="video" aria-labelledby="video-title">
	<div class="w-full max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 py-20 md:py-28">

		<!-- Header — left-aligned, editorial -->
		<div class="flex items-end justify-between mb-10 md:mb-14">
			<div class="space-y-3">
				<h3 class="text-[10px] md:text-[11px] font-bold tracking-[0.4em] uppercase text-slate-400">
					{video.eyebrow}
				</h3>
				<h2
					id="video-title"
					class="text-2xl md:text-4xl lg:text-5xl font-display font-bold text-ink tracking-tight text-wrap balance leading-[1.05]"
				>
					{video.title}
				</h2>
			</div>
			<span class="hidden sm:block text-[10px] font-bold tracking-[0.3em] uppercase text-primary/60">
				{video.badge}
			</span>
		</div>

		<!-- Video Player — full width, no card -->
		<div
			class="video-player-wrapper aspect-video group relative"
			data-video-id={video.video_id}
		>
			<!-- Fallback gradient background (shown if thumbnail fails) -->
			<div class="video-fallback absolute inset-0 bg-gradient-to-br from-primary/20 to-primary-deep/30" aria-hidden="true"></div>

			<!-- Thumbnail (shown before click) -->
			<img
				alt={video.title}
				class="video-thumbnail w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 relative z-[1]"
				src={`https://img.youtube.com/vi/${video.video_id}/maxresdefault.jpg`}
				loading="lazy"
				width="1280"
				height="720"
				onerror="this.style.display='none'"
			/>

			<!-- Dark overlay -->
			<div class="video-overlay absolute inset-0 bg-black/25 z-10 pointer-events-none transition-opacity duration-300"></div>

			<!-- Play button -->
			<button
				type="button"
				class="video-play-btn absolute inset-0 flex items-center justify-center z-20 cursor-pointer"
				aria-label="Reproducir video"
			>
				<div class="play-button relative size-20 md:size-24 lg:size-28 rounded-full flex items-center justify-center">
					<span class="relative z-10 size-full rounded-full bg-white shadow-luma flex items-center justify-center transition-transform duration-300 ease-out group-hover:scale-110 group-active:scale-95">
						<span class="group-hover:text-white transition-colors duration-300">
							<PhPlay
								class="text-primary text-4xl md:text-5xl"
								weight="fill"
							/>
						</span>
					</span>
				</div>
			</button>

			<!-- Duration badge -->
			<div class="video-duration absolute bottom-4 right-4 z-30">
				<span class="px-2 py-1 bg-black/60 rounded text-white text-[10px] font-medium tracking-wide">
					{video.duration}
				</span>
			</div>

			<!-- Close button (shown when video is playing) -->
			<button
				type="button"
				class="video-close-btn absolute top-4 right-4 z-30 hidden p-2 rounded-full bg-black/50 text-white hover:bg-black/70 transition-colors duration-200"
				aria-label="Cerrar video"
			>
				<PhX size={20} weight="regular" />
			</button>

			<!-- YouTube Iframe (hidden until clicked) -->
			<iframe
				class="video-iframe absolute inset-0 w-full h-full hidden"
				src=""
				title={video.title}
				frameborder="0"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
			>
			</iframe>
		</div>

		<!-- Footer text — left-aligned -->
		<p class="text-sm md:text-lg text-slate-500 font-normal mt-8 max-w-xl leading-relaxed">
			{video.description}
		</p>
	</div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.video-player-wrapper').forEach((player) => {
		const playBtn = player.querySelector('.video-play-btn');
		const closeBtn = player.querySelector('.video-close-btn');
		const iframe = player.querySelector('.video-iframe');
		const thumbnail = player.querySelector('.video-thumbnail');
		const overlay = player.querySelector('.video-overlay');
		const durationBadge = player.querySelector('.video-duration');
		const videoId = player.dataset.videoId;

		function playVideo() {
			if (iframe && videoId) {
				iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
				iframe.classList.remove('hidden');
				if (thumbnail) thumbnail.classList.add('hidden');
				if (overlay) overlay.classList.add('hidden');
				if (playBtn) playBtn.classList.add('hidden');
				if (durationBadge) durationBadge.classList.add('hidden');
				if (closeBtn) closeBtn.classList.remove('hidden');
			}
		}

		function stopVideo() {
			if (iframe) {
				iframe.src = '';
				iframe.classList.add('hidden');
			}
			if (thumbnail) thumbnail.classList.remove('hidden');
			if (overlay) overlay.classList.remove('hidden');
			if (playBtn) playBtn.classList.remove('hidden');
			if (durationBadge) durationBadge.classList.remove('hidden');
			if (closeBtn) closeBtn.classList.add('hidden');
		}

		playBtn?.addEventListener('click', playVideo);
		closeBtn?.addEventListener('click', stopVideo);

		// Keyboard support for play button
		playBtn?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				playVideo();
			}
		});

		// Keyboard support for close button
		closeBtn?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				stopVideo();
			}
		});
	});
  });
</script>

<style>
	.video-player-wrapper {
		border-radius: var(--radius-luma);
		overflow: hidden;
		box-shadow:
			0 2px 10px -2px rgba(0, 0, 0, 0.05),
			0 10px 25px -5px rgba(0, 0, 0, 0.03);
	}

	.video-play-btn:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 4px;
		border-radius: var(--radius-luma);
	}

	.video-close-btn:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.video-thumbnail {
			transition: none !important;
		}
	}
</style>
