<section class="layered-card z-30" id="video" aria-labelledby="video-title">
	<div class="card-content bg-[#fafaf8] p-6 md:p-12 lg:p-20">
		<div class="max-w-5xl mx-auto w-full space-y-8 md:space-y-14">
			<!-- Header -->
			<div class="text-center" data-line-stagger="0.1">
				<span
					class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-[10px] font-bold tracking-[0.2em] uppercase mb-5"
				>
					<span class="w-1 h-1 rounded-full bg-primary"></span>
					Destacado
				</span>
				<h3
					class="line-reveal reveal-slide text-[10px] md:text-[11px] font-bold tracking-[0.4em] uppercase text-ink-faint mb-3 md:mb-4"
				>
					Experiencia ULA
				</h3>
				<h2
					id="video-title"
					class="line-reveal reveal-slide text-3xl md:text-4xl lg:text-5xl font-display font-semibold tracking-tight text-wrap balance leading-tight"
				>
					Vibrando con el Núcleo
				</h2>
			</div>

			<!-- Video Player -->
			<div
				class="reveal-scale video-player aspect-video group cursor-pointer relative shadow-2xl"
			>
				<!-- Gradient overlay -->
				<div
					class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent z-10 pointer-events-none"
				>
				</div>

				<!-- Thumbnail -->
				<img
					alt="Video de presentación - Instalaciones del Núcleo Universitario Rafael Rangel"
					class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
					src="/images/dom-fou-YRMWVcdyhmI-unsplash.jpg"
					loading="lazy"
					width="1280"
					height="720"
				/>

				<!-- Play button with pulse ring -->
				<div
					class="absolute inset-0 flex items-center justify-center z-20"
				>
					<!-- Pulse ring -->
					<div
						class="absolute w-24 h-24 md:w-28 md:h-28 rounded-full border-2 border-white/30 animate-ping"
						style="animation-duration: 2s;"
					>
					</div>
					<div
						class="play-button relative size-20 md:size-24 lg:size-28 rounded-full bg-white/95 shadow-2xl flex items-center justify-center transition-transform duration-400 cubic-bezier(0.34, 1.56, 0.64, 1) group-hover:scale-110 group-hover:bg-primary"
					>
						<span
							class="material-symbols-outlined text-primary text-4xl md:text-5xl fill-1 transition-colors duration-300 group-hover:text-white"
							aria-hidden="true">play_arrow</span
						>
					</div>
				</div>

				<!-- Bottom info overlay -->
				<div
					class="absolute bottom-5 left-5 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-400"
				>
					<div class="flex items-center gap-3">
						<span
							class="text-white text-sm font-medium drop-shadow-lg"
							>Ver video</span
						>
						<span
							class="px-2 py-0.5 bg-white/20 backdrop-blur-sm rounded text-white text-[10px] font-bold tracking-wider"
							>3:24</span
						>
					</div>
				</div>
			</div>

			<!-- Footer text -->
			<p
				class="reveal-slide text-sm md:text-lg text-ink-muted font-normal text-center max-w-xl mx-auto leading-relaxed"
			>
				Descubre nuestras instalaciones y el ambiente académico que
				define a la mejor escuela de comunicación del país.
			</p>
		</div>
	</div>
</section>
