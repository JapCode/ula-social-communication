---
import {
  PhHouse,
  PhNewspaper,
  PhPlay,
  PhSquaresFour,
} from "phosphor-icons-astro";
---

<nav class="reveal fixed left-4 md:left-8 top-1/2 -translate-y-1/2 z-[110] flex-col gap-2 hidden md:flex" aria-label="Navegación principal" id="side-nav">
	<!-- Connecting line -->
	<div class="absolute left-1/2 -translate-x-1/2 top-2 bottom-2 w-px bg-slate-100/50" aria-hidden="true"></div>
	
	<!-- Active indicator dot -->
	<div class="active-dot absolute -left-1 w-1 h-1 rounded-full bg-primary transition-all duration-500 ease-out" aria-hidden="true"></div>
	
	<a class="nav-pill p-4 rounded-full flex items-center justify-center group relative" href="#inicio" data-section="inicio" title="Inicio" aria-label="Ir a inicio">
		<span class="nav-tooltip absolute left-full ml-3 px-3 py-1.5 bg-ink text-white text-[10px] font-bold tracking-wider uppercase rounded-luma opacity-0 -translate-x-2 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:opacity-100 group-hover:translate-x-0">Inicio</span>
		<PhHouse size={18} weight="regular" aria-hidden="true" />
	</a>
	<a class="nav-pill p-4 rounded-full flex items-center justify-center group relative" href="#accesos" data-section="accesos" title="Accesos" aria-label="Ir a accesos rápidos">
		<span class="nav-tooltip absolute left-full ml-3 px-3 py-1.5 bg-ink text-white text-[10px] font-bold tracking-wider uppercase rounded-luma opacity-0 -translate-x-2 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:opacity-100 group-hover:translate-x-0">Accesos</span>
		<PhSquaresFour size={18} weight="regular" aria-hidden="true" />
	</a>
	<div class="w-px h-6 bg-slate-100/50 mx-auto my-1" aria-hidden="true"></div>
	<a class="nav-pill p-4 rounded-full flex items-center justify-center group relative" href="#noticias" data-section="noticias" title="Noticias" aria-label="Ir a noticias">
		<span class="nav-tooltip absolute left-full ml-3 px-3 py-1.5 bg-ink text-white text-[10px] font-bold tracking-wider uppercase rounded-luma opacity-0 -translate-x-2 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:opacity-100 group-hover:translate-x-0">Noticias</span>
		<PhNewspaper size={18} weight="regular" aria-hidden="true" />
	</a>
	<a class="nav-pill p-4 rounded-full flex items-center justify-center group relative" href="#video" data-section="video" title="Experiencia" aria-label="Ir a experiencia">
		<span class="nav-tooltip absolute left-full ml-3 px-3 py-1.5 bg-ink text-white text-[10px] font-bold tracking-wider uppercase rounded-luma opacity-0 -translate-x-2 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:opacity-100 group-hover:translate-x-0">Experiencia</span>
		<PhPlay size={18} weight="regular" aria-hidden="true" />
	</a>
</nav>

<style>
	.nav-pill svg,
	.nav-pill [data-phosphor-icon] {
		color: var(--color-primary);
		transition: stroke-width 0.3s ease;
	}
	
	.nav-pill.is-active svg,
	.nav-pill.is-active [data-phosphor-icon] {
		stroke-width: 2;
	}
	
	.nav-pill.is-active {
		background: rgba(0, 93, 170, 0.08);
		border-color: rgba(0, 93, 170, 0.15);
	}
	
	.active-dot {
		top: 50%;
		transform: translateY(-50%);
		opacity: 0;
		transition: top 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
	}
	
	.active-dot.visible {
		opacity: 1;
	}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Scroll-based active section detection
	const sections = ['inicio', 'accesos', 'noticias', 'video'];
	const navLinks = document.querySelectorAll('#side-nav a[data-section]');
	const activeDot = document.querySelector('#side-nav .active-dot');
	
	function updateActiveNav() {
		let currentSection = '';
		
		sections.forEach(id => {
			const el = document.getElementById(id);
			if (el) {
				const rect = el.getBoundingClientRect();
				const isVisible = rect.top <= window.innerHeight * 0.5 && rect.bottom >= window.innerHeight * 0.3;
				if (isVisible) {
					currentSection = id;
				}
			}
		});
		
		navLinks.forEach(link => {
			const isActive = link.getAttribute('data-section') === currentSection;
			link.classList.toggle('is-active', isActive);
		});
		
		// Move active dot to active link
		const activeLink = document.querySelector('#side-nav a.is-active');
		if (activeLink && activeDot) {
			const navRect = document.getElementById('side-nav')?.getBoundingClientRect();
			const linkRect = activeLink.getBoundingClientRect();
			if (navRect && linkRect) {
				const relativeTop = linkRect.top - navRect.top + linkRect.height / 2;
				activeDot.style.top = `${relativeTop}px`;
				activeDot.classList.add('visible');
			}
		} else if (activeDot) {
			activeDot.classList.remove('visible');
		}
	}
	
	// Throttled scroll listener
	let ticking = false;
	window.addEventListener('scroll', () => {
		if (!ticking) {
			requestAnimationFrame(() => {
				updateActiveNav();
				ticking = false;
			});
			ticking = true;
		}
	}, { passive: true });
	
	// Initial check
	updateActiveNav();
  });
</script>
