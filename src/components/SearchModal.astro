<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[200] hidden" role="dialog" aria-modal="true" aria-label="Buscar contenido">
	<!-- Backdrop -->
	<div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="search-backdrop"></div>
	
	<!-- Modal panel -->
	<div class="absolute inset-x-4 top-20 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-xl bg-white rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="search-panel">
		<!-- Search input area -->
		<div class="flex items-center gap-3 px-5 py-4 border-b border-black/[0.06]">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint flex-shrink-0" aria-hidden="true">
				<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
			</svg>
			<input
				type="search"
				id="search-input"
				class="w-full bg-transparent text-ink text-sm font-normal placeholder:text-ink-faint outline-none"
				placeholder="Buscar horarios, pénsum, recursos…"
				autocomplete="off"
				spellcheck="false"
				aria-label="Buscar contenido"
			/>
			<kbd class="hidden md:inline-flex items-center px-2 py-0.5 bg-black/[0.04] rounded text-[10px] font-bold text-ink-faint">ESC</kbd>
			<button id="search-close" class="p-1.5 rounded-full hover:bg-black/5 transition-colors min-w-[32px] min-h-[32px] flex items-center justify-center" aria-label="Cerrar búsqueda">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted" aria-hidden="true">
					<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
				</svg>
			</button>
		</div>
		
		<!-- Results area -->
		<div id="search-results" class="max-h-80 overflow-y-auto overscroll-y-contain">
			<!-- Results injected by JS -->
		</div>
		
		<!-- Empty state (hidden by default) -->
		<div id="search-empty" class="hidden py-12 text-center">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint mx-auto mb-3" aria-hidden="true">
				<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/>
			</svg>
			<p class="text-sm text-ink-muted font-normal">No se encontraron resultados</p>
			<p class="text-xs text-ink-faint mt-1">Intenta con otros términos</p>
		</div>
		
		<!-- Initial state -->
		<div id="search-initial" class="py-10 text-center">
			<p class="text-xs text-ink-faint font-normal">Escribe para buscar horarios, pénsum, recursos y más</p>
		</div>
	</div>
</div>

<script>
	const searchData = [
		{ title: "Horarios - Comunicación Social", category: "Horarios", href: "#", keywords: ["horario", "clases", "cronograma", "horas", "semana"] },
		{ title: "Horarios - Postgrado", category: "Horarios", href: "#", keywords: ["horario", "postgrado", "clases", "nocturno"] },
		{ title: "Pénsum - Malla Curricular", category: "Pénsum", href: "#", keywords: ["malla", "materias", "pénsum", "plan", "estudios", "currículo"] },
		{ title: "Inscripciones - Nuevos Ingresos", category: "Inscripciones", href: "#", keywords: ["inscripción", "ingreso", "registro", "nuevo", "admisión"] },
		{ title: "Inscripciones - Reingreso", category: "Inscripciones", href: "#", keywords: ["reingreso", "retorno", "inscripción", "regularización"] },
		{ title: "Recursos Bibliográficos", category: "Recursos", href: "#", keywords: ["biblioteca", "libros", "recursos", "archivos", "digital"] },
		{ title: "Postgrado - Comunicación", category: "Academia", href: "#", keywords: ["postgrado", "maestría", "especialización"] },
		{ title: "Diplomados", category: "Academia", href: "#", keywords: ["diplomado", "curso", "formación", "taller"] },
		{ title: "Calendario Académico", category: "Academia", href: "#", keywords: ["calendario", "fechas", "período", "semestre", "vacaciones"] },
		{ title: "Requisitos de Graduación", category: "Academia", href: "#", keywords: ["graduación", "tesis", "requisitos", "grado"] },
		{ title: "Becas y Apoyo Financiero", category: "Soporte", href: "#", keywords: ["beca", "financiero", "ayuda", "apoyo"] },
		{ title: "Contacto - Secretaría", category: "Soporte", href: "#", keywords: ["secretaría", "contacto", "teléfono", "correo"] },
	];

	const categoryIcons: Record<string, string> = {
		"Horarios": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>',
		"Pénsum": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
		"Inscripciones": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>',
		"Recursos": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>',
		"Academia": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 8-4 8 4"/><path d="m18 10 4 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8l4-2"/><path d="M14 22v-4a2 2 0 0 0-4 0v4"/><path d="M18 5v17"/><path d="M6 5v17"/></svg>',
		"Soporte": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
	};

	const modal = document.getElementById('search-modal');
	const panel = document.getElementById('search-panel');
	const backdrop = document.getElementById('search-backdrop');
	const input = document.getElementById('search-input');
	const results = document.getElementById('search-results');
	const empty = document.getElementById('search-empty');
	const initial = document.getElementById('search-initial');
	const closeBtn = document.getElementById('search-close');
	
	let debounceTimer: ReturnType<typeof setTimeout>;
	let selectedIndex = -1;

	function openSearch() {
		if (!modal || !panel) return;
		modal.classList.remove('hidden');
		modal.setAttribute('aria-hidden', 'false');
		setTimeout(() => {
			panel.classList.remove('scale-95', 'opacity-0');
			panel.classList.add('scale-100', 'opacity-100');
		}, 10);
		document.body.style.overflow = 'hidden';
		setTimeout(() => input?.focus(), 300);
	}

	function closeSearch() {
		if (!modal || !panel) return;
		panel.classList.add('scale-95', 'opacity-0');
		panel.classList.remove('scale-100', 'opacity-100');
		setTimeout(() => {
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			input && (input.value = '');
			results && (results.innerHTML = '');
			empty?.classList.add('hidden');
			initial?.classList.remove('hidden');
			selectedIndex = -1;
		}, 300);
		document.body.style.overflow = '';
	}

	function renderResults(items: typeof searchData) {
		if (!results) return;
		results.innerHTML = items.map((item, i) => `
			<a href="${item.href}" class="search-result-item flex items-center gap-3 px-5 py-3.5 hover:bg-primary/[0.04] transition-colors duration-200 group ${i === 0 ? 'is-selected' : ''}" data-index="${i}">
				<span class="flex-shrink-0 w-8 h-8 rounded-lg bg-primary/[0.08] flex items-center justify-center text-primary">
					${categoryIcons[item.category] || ''}
				</span>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium text-ink truncate">${item.title}</p>
					<p class="text-[11px] text-ink-faint font-normal">${item.category}</p>
				</div>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">
					<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
				</svg>
			</a>
		`).join('');
	}

	function filterResults(query: string) {
		const q = query.toLowerCase().trim();
		if (!q) {
			results && (results.innerHTML = '');
			empty?.classList.add('hidden');
			initial?.classList.remove('hidden');
			return;
		}

		initial?.classList.add('hidden');
		
		const filtered = searchData.filter(item =>
			item.title.toLowerCase().includes(q) ||
			item.category.toLowerCase().includes(q) ||
			item.keywords.some(k => k.includes(q))
		);

		if (filtered.length === 0) {
			empty?.classList.remove('hidden');
			results && (results.innerHTML = '');
		} else {
			empty?.classList.add('hidden');
			renderResults(filtered);
		}
	}

	// Event listeners
	input?.addEventListener('input', (e) => {
		clearTimeout(debounceTimer);
		debounceTimer = setTimeout(() => {
			filterResults((e.target as HTMLInputElement).value);
		}, 200);
	});

	input?.addEventListener('keydown', (e) => {
		const items = results?.querySelectorAll('.search-result-item');
		if (!items) return;

		if (e.key === 'ArrowDown') {
			e.preventDefault();
			selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
			updateSelection(items);
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			selectedIndex = Math.max(selectedIndex - 1, 0);
			updateSelection(items);
		} else if (e.key === 'Enter' && selectedIndex >= 0) {
			e.preventDefault();
			(items[selectedIndex] as HTMLAnchorElement).click();
		}
	});

	function updateSelection(items: NodeListOf<Element>) {
		items.forEach((item, i) => {
			item.classList.toggle('is-selected', i === selectedIndex);
			item.classList.toggle('bg-primary/[0.04]', i === selectedIndex);
		});
	}

	closeBtn?.addEventListener('click', closeSearch);
	backdrop?.addEventListener('click', closeSearch);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
			closeSearch();
		}
	});

	// Expose openSearch globally for the search button
	(window as any).openSearch = openSearch;
</script>

<style>
	#search-modal {
		overscroll-behavior: contain;
	}
	
	.search-result-item.is-selected {
		background: rgba(0, 93, 170, 0.04);
	}
	
	@media (max-width: 768px) {
		#search-panel {
			inset: 0;
			border-radius: 0;
			max-width: 100%;
		}
	}
</style>
