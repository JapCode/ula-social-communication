---
import {
  PhMagnifyingGlass,
  PhX,
  PhCalendarBlank,
  PhUsers,
  PhUserPlus,
  PhBookOpen,
  PhGraduationCap,
  PhChatCircleText,
  PhArrowRight,
} from "phosphor-icons-astro";
---

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[200] hidden" role="dialog" aria-modal="true" aria-label="Buscar contenido">
	<!-- Backdrop -->
	<div class="absolute inset-0 bg-slate-900/30" id="search-backdrop"></div>
	
	<!-- Modal panel -->
	<div class="absolute inset-x-4 top-20 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-xl bg-white rounded-luma shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="search-panel">
		<!-- Search input area -->
		<div class="flex items-center gap-3 px-6 py-5 border-b border-slate-100/50">
			<PhMagnifyingGlass size={18} weight="regular" class="text-slate-300 flex-shrink-0" aria-hidden="true" />
			<input
				type="search"
				id="search-input"
				class="w-full bg-transparent text-slate-900 text-sm font-normal placeholder:text-slate-400 outline-none"
				placeholder="Buscar horarios, pénsum, recursos…"
				autocomplete="off"
				spellcheck="false"
				aria-label="Buscar contenido"
			/>
			<kbd class="hidden md:inline-flex items-center px-2 py-0.5 bg-slate-100/50 rounded-luma text-[10px] font-bold text-slate-400">ESC</kbd>
			<button id="search-close" class="p-1.5 rounded-full hover:bg-slate-50 transition-colors min-w-[32px] min-h-[32px] flex items-center justify-center" aria-label="Cerrar búsqueda">
				<PhX size={16} weight="regular" class="text-ink-muted" aria-hidden="true" />
			</button>
		</div>
		
		<!-- Results area -->
		<div id="search-results" class="max-h-80 overflow-y-auto overscroll-y-contain">
			<!-- Results injected by JS -->
		</div>
		
		<!-- Empty state (hidden by default) -->
		<div id="search-empty" class="hidden py-12 text-center">
			<PhMagnifyingGlass size={32} weight="regular" class="text-slate-300 mx-auto mb-3" aria-hidden="true" />
			<p class="text-sm text-slate-500 font-normal">No se encontraron resultados</p>
			<p class="text-xs text-slate-400 mt-3 mb-4">Prueba buscando:</p>
			<div class="flex flex-wrap justify-center gap-2">
				<a href="/student-life/calendar" class="search-suggestion px-3 py-1.5 bg-slate-50 rounded-full text-xs text-primary hover:bg-primary/10 transition-colors">Horarios</a>
				<a href="/academics/curriculum" class="search-suggestion px-3 py-1.5 bg-slate-50 rounded-full text-xs text-primary hover:bg-primary/10 transition-colors">Pénsum</a>
				<a href="/admission/process" class="search-suggestion px-3 py-1.5 bg-slate-50 rounded-full text-xs text-primary hover:bg-primary/10 transition-colors">Inscripciones</a>
				<a href="/academics/course-content" class="search-suggestion px-3 py-1.5 bg-slate-50 rounded-full text-xs text-primary hover:bg-primary/10 transition-colors">Biblioteca</a>
			</div>
		</div>
		
		<!-- Initial state -->
		<div id="search-initial" class="py-10 text-center">
			<p class="text-xs text-slate-400 font-normal">Escribe para buscar horarios, pénsum, recursos y más</p>
		</div>
	</div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchData = [
		{ title: "Horarios - Comunicación Social", category: "Horarios", href: "/student-life/calendar", keywords: ["horario", "clases", "cronograma", "horas", "semana"] },
		{ title: "Pénsum - Malla Curricular", category: "Pénsum", href: "/academics/curriculum", keywords: ["malla", "materias", "pénsum", "plan", "estudios", "currículo"] },
		{ title: "Inscripciones - Nuevos Ingresos", category: "Inscripciones", href: "/admission/process", keywords: ["inscripción", "ingreso", "registro", "nuevo", "admisión"] },
		{ title: "Biblioteca Digital", category: "Biblioteca", href: "/academics/course-content", keywords: ["biblioteca", "libros", "recursos", "archivos", "digital"] },
		{ title: "Calendario Académico", category: "Academia", href: "/student-life/calendar", keywords: ["calendario", "fechas", "período", "semestre", "vacaciones"] },
		{ title: "Contacto", category: "Soporte", href: "/contact", keywords: ["secretaría", "contacto", "teléfono", "correo"] },
	];

	const categoryIcons: Record<string, string> = {
		"Horarios": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="16" y="40" width="224" height="176" rx="16"/><line x1="16" y1="104" x2="240" y2="104"/><line x1="64" y1="16" x2="64" y2="64"/><line x1="192" y1="16" x2="192" y2="64"/></svg>',
		"Pénsum": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M168 204v-20a20 20 0 0 0-20-20H64a20 20 0 0 0-20 20v20"/><circle cx="104" cy="84" r="36"/><path d="M212 204v-20a20 20 0 0 0-16-19.6"/><path d="M168 52a20 20 0 0 1 0 38.4"/></svg>',
		"Inscripciones": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M168 204v-20a20 20 0 0 0-20-20H64a20 20 0 0 0-20 20v20"/><circle cx="104" cy="84" r="36"/><line x1="192" y1="80" x2="192" y2="144"/><line x1="160" y1="112" x2="224" y2="112"/></svg>',
		"Biblioteca": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M64 200V48a16 16 0 0 1 16-16h128v192H80a16 16 0 0 1-16-16z"/><path d="M192 200H80a16 16 0 0 1 0-32h112"/></svg>',
		"Academia": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M64 88l64-40 64 40"/><path d="M192 120l32 16v80a16 16 0 0 1-16 16H48a16 16 0 0 1-16-16v-80l32-16"/><path d="M144 232v-32a16 16 0 0 0-32 0v32"/><path d="M192 64v136"/><path d="M64 64v136"/></svg>',
		"Soporte": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M216 168a16 16 0 0 1-16 16H80l-48 48V48a16 16 0 0 1 16-16h152a16 16 0 0 1 16 16z"/></svg>',
	};

	const modal = document.getElementById('search-modal');
	const panel = document.getElementById('search-panel');
	const backdrop = document.getElementById('search-backdrop');
	const input = document.getElementById('search-input');
	const results = document.getElementById('search-results');
	const empty = document.getElementById('search-empty');
	const initial = document.getElementById('search-initial');
	const closeBtn = document.getElementById('search-close');
	
	let debounceTimer: ReturnType<typeof setTimeout>;
	let selectedIndex = -1;

	function openSearch() {
		if (!modal || !panel) return;
		modal.classList.remove('hidden');
		modal.setAttribute('aria-hidden', 'false');
		setTimeout(() => {
			panel.classList.remove('scale-95', 'opacity-0');
			panel.classList.add('scale-100', 'opacity-100');
		}, 10);
		document.body.style.overflow = 'hidden';
		setTimeout(() => input?.focus(), 300);
	}

	function closeSearch() {
		if (!modal || !panel) return;
		panel.classList.add('scale-95', 'opacity-0');
		panel.classList.remove('scale-100', 'opacity-100');
		setTimeout(() => {
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			input && (input.value = '');
			results && (results.innerHTML = '');
			empty?.classList.add('hidden');
			initial?.classList.remove('hidden');
			selectedIndex = -1;
		}, 300);
		document.body.style.overflow = '';
	}

	function renderResults(items: typeof searchData) {
		if (!results) return;
		results.innerHTML = items.map((item, i) => `
			<a href="${item.href}" class="search-result-item flex items-center gap-3 px-6 py-4 hover:bg-primary/[0.04] transition-colors duration-200 group ${i === 0 ? 'is-selected' : ''}" data-index="${i}">
				<span class="flex-shrink-0 w-8 h-8 rounded-luma bg-primary/[0.08] flex items-center justify-center text-primary">
					${categoryIcons[item.category] || ''}
				</span>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium text-slate-900 truncate">${item.title}</p>
					<p class="text-[11px] text-slate-400 font-normal">${item.category}</p>
				</div>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">
					<path d="M88 48l80 80-80 80"/><line x1="48" y1="128" x2="168" y2="128"/>
				</svg>
			</a>
		`).join('');
	}

	function filterResults(query: string) {
		const q = query.toLowerCase().trim();
		if (!q) {
			results && (results.innerHTML = '');
			empty?.classList.add('hidden');
			initial?.classList.remove('hidden');
			return;
		}

		initial?.classList.add('hidden');
		
		const filtered = searchData.filter(item =>
			item.title.toLowerCase().includes(q) ||
			item.category.toLowerCase().includes(q) ||
			item.keywords.some(k => k.includes(q))
		);

		if (filtered.length === 0) {
			empty?.classList.remove('hidden');
			results && (results.innerHTML = '');
		} else {
			empty?.classList.add('hidden');
			renderResults(filtered);
		}
	}

	// Event listeners
	input?.addEventListener('input', (e) => {
		clearTimeout(debounceTimer);
		debounceTimer = setTimeout(() => {
			filterResults((e.target as HTMLInputElement).value);
		}, 200);
	});

	input?.addEventListener('keydown', (e) => {
		const items = results?.querySelectorAll('.search-result-item');
		if (!items) return;

		if (e.key === 'ArrowDown') {
			e.preventDefault();
			selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
			updateSelection(items);
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			selectedIndex = Math.max(selectedIndex - 1, 0);
			updateSelection(items);
		} else if (e.key === 'Enter' && selectedIndex >= 0) {
			e.preventDefault();
			(items[selectedIndex] as HTMLAnchorElement).click();
		}
	});

	function updateSelection(items: NodeListOf<Element>) {
		items.forEach((item, i) => {
			item.classList.toggle('is-selected', i === selectedIndex);
			item.classList.toggle('bg-primary/[0.04]', i === selectedIndex);
		});
	}

	closeBtn?.addEventListener('click', closeSearch);
	backdrop?.addEventListener('click', closeSearch);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
			closeSearch();
		}
	});

	// Expose openSearch globally for the search button
	(window as any).openSearch = openSearch;
  });
</script>

<style>
	#search-modal {
		overscroll-behavior: contain;
	}
	
	.search-result-item.is-selected {
		background: rgba(0, 93, 170, 0.04);
	}
	
	@media (max-width: 768px) {
		#search-panel {
			inset: 0;
			border-radius: 0;
			max-width: 100%;
		}
	}
</style>
