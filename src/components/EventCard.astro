---
import { PhMapPin, PhArrowRight } from "phosphor-icons-astro";
import { getTypeLabel, getTypeColors } from '@/lib/events';

interface Props {
  title: string;
  date: string | Date;
  location: string;
  type: string;
  summaryText: string;
  href?: string;
}

const { title, date, location, type, summaryText, href = "#" } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('es-VE', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<a href={href} class="group block bg-white border border-tinted rounded-luma p-6 transition-all duration-300 hover:shadow-luma hover:-translate-y-1">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-2">
        <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${getTypeColors(type)}`}>
          {getTypeLabel(type)}
        </span>
        <span class="text-xs text-slate-400">{formattedDate}</span>
      </div>
      <h3 class="text-base font-bold text-slate-900 tracking-tight group-hover:text-primary transition-colors">
        {title}
      </h3>
      <p class="text-sm text-slate-500 mt-1 leading-relaxed line-clamp-2">{summaryText}</p>
      <div class="flex items-center gap-1 mt-3 text-xs text-slate-400">
        <PhMapPin size={14} weight="regular" />
        {location}
      </div>
    </div>
    <PhArrowRight size={16} weight="regular" class="text-slate-300 group-hover:text-primary transition-colors flex-shrink-0" />
  </div>
</a>
