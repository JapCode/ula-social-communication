---
import Layout from "@/layouts/Layout.astro";
import TopNav from "@/components/TopNav.astro";
import PageHeader from "@/components/PageHeader.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import SearchModal from "@/components/SearchModal.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BackToTop from "@/components/BackToTop.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  breadcrumb?: Array<{ label: string; href: string }>;
  toc?: boolean;
  narrow?: boolean;
  readingTime?: number;
  headings?: Array<{ id: string; text: string; level: number }>;
  sectionTheme?: "academic" | "student-life" | "portfolio" | "admission" | "default";
  "data-tina-field"?: string;
}

const {
  title,
  subtitle,
  eyebrow,
  breadcrumb,
  toc = false,
  narrow = false,
  readingTime,
  headings = [],
  sectionTheme = "default",
} = Astro.props;

const sectionBg =
  sectionTheme === "default" ? "bg-surface"
  : sectionTheme === "academic" ? "section-academic"
  : sectionTheme === "student-life" ? "section-student-life"
  : sectionTheme === "portfolio" ? "section-portfolio"
  : sectionTheme === "admission" ? "section-admission"
  : "bg-surface";
---

<Layout title={title}>
  <TopNav />
  <main id="main-content" class="relative" role="main">
    <PageHeader
      title={title}
      subtitle={subtitle}
      eyebrow={eyebrow}
      breadcrumb={breadcrumb}
      readingTime={readingTime}
      data-tina-field={Astro.props["data-tina-field"]}
    />
    <section class={`${sectionBg} py-16 md:py-20 lg:py-24`}>
      <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16">
        <div class="flex gap-8 lg:gap-12">
          <!-- Table of Contents Sidebar (desktop only, conditional) -->
          {
            toc && (
              <div class="hidden lg:block w-56 xl:w-64 flex-shrink-0">
                <TableOfContents headings={headings} />
              </div>
            )
          }

          <!-- Main Content Area -->
          <div
            class:list={[
              "content-area flex-1 min-w-0",
              narrow ? "" : "max-w-4xl",
            ]}
          >
            <!-- Mobile TOC (rendered inside content for proper flow) -->
            {
              toc && (
                <div class="lg:hidden mb-8">
                  <TableOfContents headings={headings} />
                </div>
              )
            }

            <slot />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
  <SearchModal />
  <BackToTop />
</Layout>

<style>
  /* ── Content area typography — Editorial/Magazine scale ─── */
  .content-area h2 {
    font-family: var(--font-display), Georgia, Times, serif;
    font-size: 1.625rem;
    font-weight: 650;
    color: var(--color-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .content-area h3 {
    font-family: var(--font-body), Arial, "Helvetica Neue", sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    letter-spacing: 0.005em;
  }

  .content-area p {
    font-family: var(--font-body), Arial, "Helvetica Neue", sans-serif;
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    font-size: 1rem;
    max-width: 65ch;
  }

  .content-area ul,
  .content-area ol {
    color: var(--color-ink-muted);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .content-area li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .content-area a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .content-area a:hover {
    color: var(--color-primary-deep);
  }

  .content-area blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .content-area img {
    border-radius: var(--radius-luma);
    margin: 1.5rem 0;
  }

  .content-area table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .content-area th,
  .content-area td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .content-area th {
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .content-area td {
    color: var(--color-ink-muted);
  }

  .content-area code {
    background: #f1f5f9;
    padding: 0.2em 0.4em;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, monospace;
  }

  .content-area pre {
    background: #f8fafc;
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: var(--radius-luma);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .content-area pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .content-area hr {
    border: none;
    height: 1px;
    background: rgba(226, 232, 240, 0.5);
    margin: 2rem 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .content-area h2 {
      font-size: 1.375rem;
      margin-top: 2rem;
    }

    .content-area h3 {
      font-size: 1.0625rem;
      margin-top: 1.5rem;
    }

    .content-area p {
      font-size: 0.9375rem;
    }
  }
</style>
