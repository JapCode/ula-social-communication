---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html class="light" lang="es" style="color-scheme: light;" transition:animate="fade">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fcfcfd" />
		<meta
			name="description"
			content="Comunicación Social ULA NURR - Explorando las nuevas fronteras del lenguaje y la narrativa digital en el Núcleo Universitario Rafael Rangel"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<ClientRouter />
		<link rel="stylesheet" href="https://unpkg.com/lenis@1.3.23/dist/lenis.css" />
		<style is:global>
			/* Custom view transition animations */
			@keyframes fade-in {
				from { opacity: 0; }
				to { opacity: 1; }
			}
			@keyframes fade-out {
				from { opacity: 1; }
				to { opacity: 0; }
			}
			@keyframes slide-from-right {
				from { transform: translateX(30px); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}
			@keyframes slide-to-left {
				from { transform: translateX(0); opacity: 1; }
				to { transform: translateX(-30px); opacity: 0; }
			}
			@keyframes slide-from-left {
				from { transform: translateX(-30px); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}
			@keyframes slide-to-right {
				from { transform: translateX(0); opacity: 1; }
				to { transform: translateX(30px); opacity: 0; }
			}
			
			/* Slide animations */
			::view-transition-old(slide) {
				animation: 0.35s cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
			}
			::view-transition-new(slide) {
				animation: 0.45s cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
			}
			
			/* Fade animations — exit quick, enter smooth */
			::view-transition-old(fade) {
				animation: 0.2s cubic-bezier(0.4, 0, 1, 1) both fade-out;
			}
			::view-transition-new(fade) {
				animation: 0.4s cubic-bezier(0.4, 0, 0.2, 1) both fade-in;
			}
		</style>
	</head>
	<body
		class="bg-[#fcfcfd] text-[var(--color-ink)] font-body selection:bg-primary/15 selection:text-[var(--color-ink)]"
	>
		<a href="#main-content" class="skip-link"
			>Saltar al contenido principal</a
		>
		<div
			class="progress-bar fixed top-0 left-0 h-1 bg-primary z-[200] origin-left"
			role="progressbar"
			aria-label="Progreso de scroll"
		>
		</div>
		<slot />
		<script>
			import Lenis from 'lenis';

			// ── Smooth scroll (Lenis) + progress bar ─────────────
			// Re-initializes after view transitions.

			let lenis = null;
			let _progressHandler = null;

			function setupSmoothScroll() {
				const progressBar = document.querySelector('.progress-bar');

				// Destroy previous instance
				if (lenis) {
					lenis.destroy();
				}
				if (_progressHandler && progressBar) {
					progressBar.removeEventListener('scroll', _progressHandler);
				}

				lenis = new Lenis({
					// ── Fluid animation config ──
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					orientation: 'vertical',
					gestureOrientation: 'vertical',
					smoothWheel: true,
					wheelMultiplier: 1,
					touchMultiplier: 1.5,
					autoRaf: true,
					autoToggle: true,
					anchors: true,
					allowNestedScroll: true,
					naiveDimensions: true,
					stopInertiaOnNavigate: true,
				});

				// Progress bar uses Lenis virtual scroll
				if (progressBar) {
					_progressHandler = (e) => {
						const progress = e.progress; // 0–1
						progressBar.style.transform = `scaleX(${progress})`;
					};
					lenis.on('scroll', _progressHandler);
				}
			}

			// Run on first load and after every view transition
			setupSmoothScroll();
			document.addEventListener('astro:after-swap', setupSmoothScroll);
		</script>
	</body>
</html>
