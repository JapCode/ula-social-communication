---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	loadAnimations?: boolean;
}

const { title, loadAnimations = false } = Astro.props;
---
<!DOCTYPE html>
<html class="light" lang="es" style="color-scheme: light;" transition:animate="fade">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fcfcfd" />
		<meta
			name="description"
			content="Comunicación Social ULA NURR - Explorando las nuevas fronteras del lenguaje y la narrativa digital en el Núcleo Universitario Rafael Rangel"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
			rel="stylesheet"
		/>
		{loadAnimations && (
			<link
				rel="stylesheet"
				href="https://unpkg.com/lenis@1.3.18-dev.1/dist/lenis.css"
			/>
		)}
		<title>{title}</title>
		<ClientRouter />
		<style is:global>
			/* Custom view transition animations */
			@keyframes fade-in {
				from { opacity: 0; }
				to { opacity: 1; }
			}
			@keyframes fade-out {
				from { opacity: 1; }
				to { opacity: 0; }
			}
			@keyframes slide-from-right {
				from { transform: translateX(30px); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}
			@keyframes slide-to-left {
				from { transform: translateX(0); opacity: 1; }
				to { transform: translateX(-30px); opacity: 0; }
			}
			@keyframes slide-from-left {
				from { transform: translateX(-30px); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}
			@keyframes slide-to-right {
				from { transform: translateX(0); opacity: 1; }
				to { transform: translateX(30px); opacity: 0; }
			}
			
			/* Slide animations */
			::view-transition-old(slide) {
				animation: 0.4s ease-out both slide-to-left;
			}
			::view-transition-new(slide) {
				animation: 0.4s ease-out both slide-from-right;
			}
			
			/* Fade animations */
			::view-transition-old(fade) {
				animation: 0.3s ease-out both fade-out;
			}
			::view-transition-new(fade) {
				animation: 0.3s ease-out both fade-in;
			}
			
			/* Smooth page transitions */
			::view-transition {
				overflow: hidden;
			}
			
			/* Page content wrapper for smooth transitions */
			.page-content {
				animation: fade-in 0.4s ease-out;
			}
		</style>
	</head>
	<body
		class="bg-[#fcfcfd] text-[var(--color-ink)] font-body selection:bg-primary/15 selection:text-[var(--color-ink)]"
	>
		<a href="#main-content" class="skip-link"
			>Saltar al contenido principal</a
		>
		<div
			class="progress-bar fixed top-0 left-0 h-1 bg-primary z-[200] origin-left"
			role="progressbar"
			aria-label="Progreso de scroll"
		>
		</div>
		<slot />
		{loadAnimations ? (
			<script>
				import "../scripts/animations.js";
			</script>
		) : (
			<script>
				// Lightweight CSS-only progress bar for non-home pages
				const progressBar = document.querySelector('.progress-bar');
				if (progressBar) {
					const onScroll = () => {
						const scrollTop = window.scrollY;
						const docHeight = document.documentElement.scrollHeight - window.innerHeight;
						const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
						progressBar.style.transform = `scaleX(${progress / 100})`;
					};
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
				}
			</script>
		)}
	</body>
</html>
